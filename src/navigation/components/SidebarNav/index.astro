---
import SidebarHeader from "./SidebarHeader.astro";
import SidebarList from "./SidebarList.astro";
import type { NavigationNode } from "../../domain/types";

interface ParentEntry {
  id: string;
  data: {
    title: string;
  };
}

interface Props {
  entries?: NavigationNode[];
  parentEntry?: ParentEntry | null;
}

const { entries = [], parentEntry } = Astro.props;

const sortedEntries = entries
  .filter((page) => !page.metadata.draft)
  .sort((a, b) => a.title.localeCompare(b.title));

const toggleId = "sidebar-mode-toggle";
const display = Boolean(entries.length);
---

<div
  id="sidebar-backdrop"
  class="sidebar-backdrop"
  data-is-hidden="true"
  aria-hidden="true"
>
</div>

<aside
  id="sidebar"
  class="sidebar-root"
  data-sidebar-mode="expanded"
  data-is-hidden="true"
  data-display={display}
>
  <SidebarHeader toggleId={toggleId} parentEntry={parentEntry} />
  <SidebarList entries={sortedEntries} />
</aside>

<style>
  .sidebar-backdrop {
    position: fixed;
    inset: 0;
    z-index: 50;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    display: none;
  }

  .sidebar-backdrop[data-is-hidden="false"] {
    display: block;
  }

  .sidebar-root[data-display="false"] {
    display: none;
  }

  .sidebar-root {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 60;
    border-right-width: 1px;
    border-color: var(--grid-line-strong);
    background-color: var(--bg);
    padding: 1.5rem;
    transition-property: width, padding;
    transition-duration: 200ms;
    display: none;
    transform: translateX(-100%);
    width: min(80vw, 20rem);
    overflow: hidden;
    height: 100%;
  }

  .sidebar-root[data-is-hidden="false"] {
    display: flex;
    flex-direction: column;
    transform: translateX(0);
  }

  .sidebar-scroll {
    overflow-y: auto;
    flex: 1 1 0%;
    min-height: 0;
  }

  @media (max-width: 767px) {
    .sidebar-scroll {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .sidebar-scroll::-webkit-scrollbar {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .sidebar-backdrop {
      display: none;
    }
    .sidebar-root {
      position: sticky;
      z-index: 40;
      top: 8rem;
      display: flex;
      flex-direction: column;
      height: calc(100vh - 9rem);
      max-height: calc(100vh - 9rem);
      flex-shrink: 0;
      transform: translateX(0);
      border-width: 1px;
      border-color: var(--grid-line-strong);
      background-color: var(--layer-1);
      padding: 1rem;
      width: 16rem;
    }

    .sidebar-root[data-sidebar-mode="collapsed"] {
      width: 4rem;
      padding-left: 0.75rem;
      padding-right: 0.75rem;
      overflow: unset;
    }

    .sidebar-root[data-sidebar-mode="collapsed"] .sidebar-scroll {
      overflow-y: auto;
      overflow-x: clip;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .sidebar-root[data-sidebar-mode="collapsed"]
      .sidebar-scroll::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    if (window.__nanobookSidebarRestored) return;
    window.__nanobookSidebarRestored = true;

    function restoreSidebar() {
      const saved =
        typeof localStorage !== "undefined"
          ? localStorage.getItem("sidebar-mode")
          : null;
      if (saved !== "collapsed" && saved !== "expanded") return;

      const sidebar = document.getElementById("sidebar");
      const toggle = document.getElementById("sidebar-mode-toggle");
      if (!sidebar || !toggle) return;

      sidebar.dataset.sidebarMode = saved;
      toggle.dataset.sidebarMode = saved;
      toggle.ariaPressed = String(saved === "collapsed");
      toggle.ariaLabel =
        saved === "expanded" ? "Contraer navegación" : "Expandir navegación";
    }

    restoreSidebar();
    document.addEventListener("astro:after-swap", restoreSidebar);
  })();
</script>

<script type="module">
  document.addEventListener("astro:page-load", function () {
    const sidebar = document.getElementById("sidebar");
    const backdrop = document.getElementById("sidebar-backdrop");
    if (!sidebar || !backdrop) return;

    backdrop.addEventListener("click", () => {
      sidebar.dataset.isHidden = "true";
      backdrop.dataset.isHidden = "true";
    });
  });
</script>
