---
import "../../../../../shared/styles/components/index-card.css";
import FolderSvg from "../../../../../shared/icons/folder.svg";
import FileSvg from "../../../../../shared/icons/file.svg";
import type { NavigationService } from "../../../../server";

const { page } = Astro.props;
const navigationService = Astro.props.navigationService as NavigationService;
const coverVar = page.metadata.cover ? `url('${page.metadata.cover}')` : undefined;
const path = `/${page.path}${page.isIndex ? "/" : ""}`;
---

<a
  href={navigationService.getHref(page.path)}
  class={`index-card ${page.isIndex ? "index-card-folder" : "index-card-document"}`}
  data-cover={page.metadata.cover ? "true" : undefined}
  data-draft={String(page.metadata.draft)}
  style={coverVar ? `--card-cover: ${coverVar}` : undefined}
>
  <span class="index-card-media" aria-hidden="true">
    <span class="index-card-icon-wrap">
      {page.isIndex ? <FolderSvg /> : <FileSvg />}
    </span>
  </span>

  <span class="index-card-content">
    <span class="index-card-kind">{page.isIndex ? "Sección" : "Documento"}</span>
    <span class="index-card-title">{page.metadata.title}</span>
    {page.metadata.description && (
      <span class="index-card-desc">{page.metadata.description}</span>
    )}
    <span class="index-card-path" title={path}>{path}</span>
  </span>

  <svg class="index-card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5 12h14m-6-6 6 6-6 6" />
  </svg>
</a>
