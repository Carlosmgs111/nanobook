---
import DocumentIndex from "./DocumentIndex.astro"
import type { NavigationService } from "../../../../server";
import DocumentActionLink from "../../../../../documents/browser/ui/components/DocumentActionLink.astro";

interface Props {
  title: string;
  description?: string;
  label?: string;
  art?: string;
  navigationService: NavigationService;
  editHref?: string;
  newHref?: string;
}
const slug = Astro.params.slug || "index";

const { title, description, label = "Index", navigationService, editHref, newHref } = Astro.props;

const sortedEntries = navigationService.getImmediateChildren(slug)
  .filter((page) => !page.metadata.draft)
  .sort((a, b) => {
    const posA = a.metadata.position ?? 0;
    const posB = b.metadata.position ?? 0;
    if (posA !== posB) return posA - posB;
    return a.metadata.title.localeCompare(b.metadata.title);
  });
---

<div class="mb-12 border-b border-[var(--theme-border)] pb-8">
  <span class="tech-label mb-3 block">{label}</span>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h1 class="glow-text text-4xl font-semibold tracking-tight text-[var(--theme-accent)] md:text-5xl">{title}</h1>
    {(editHref || newHref) && <div class="flex flex-wrap gap-2">
      {editHref && <DocumentActionLink href={editHref} label="Editar" />}
      {newHref && <DocumentActionLink href={newHref} label="Nuevo en esta sección" primary />}
    </div>}
  </div>
  {description && <p class="mt-4 text-[var(--theme-text-muted)]">{description}</p>}
</div>

<div class="index-panel relative space-y-4">
  {sortedEntries.map((page, index) => (
    <DocumentIndex
      page={page}
      index={index}
      navigationService={navigationService}
    />
  ))}
</div>

{
  sortedEntries.length === 0 && (
    <div class="border border-[var(--theme-border)] p-8 text-center text-[var(--theme-text-muted)]">
      <p>No entries found.</p>
    </div>
  )
}
