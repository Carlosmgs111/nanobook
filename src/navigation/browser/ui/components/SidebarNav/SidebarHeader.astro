---
import HomeSVG from "../../../../../shared/icons/home.svg";
import FolderUpSVG from "../../../../../shared/icons/folder-up.svg";
import SidebarModeToggle from "./SidebarModeToggle.astro";
import CloseSidebar from "./CloseSidebar.astro";
import ToolTip from "./ToolTip.astro";
import type { BookNavigationContext } from "../../NavigationContext";

interface ParentEntry {
  id: string;
  path: string;
  href: string;
  data: {
    title: string;
  };
}

interface Props {
  parentEntry?: ParentEntry | null;
  toggleId: string;
  book?: BookNavigationContext;
}

const { parentEntry, toggleId, book } = Astro.props;

---

<div
  id="sidebar-header"
  class="sidebar-header z-10 mb-6 flex items-center justify-between border-b border-[var(--theme-navigation-sidebar-border)] pb-2"
>
  {book && <a href={book.href} class="min-w-0 truncate text-sm font-semibold text-[var(--theme-action-primary)] hover:underline" title={book.name}>{book.name}</a>}
  {
    parentEntry && (
      <a
        href={parentEntry.href}
        class="sidebar-parent group flex items-center gap-2 text-sm text-[var(--theme-content-muted)] hover:text-[var(--theme-action-primary)] ellipsis"
        data-tooltip={parentEntry.data.title}
      >
        <ToolTip id={"tooltip-" + parentEntry.id}>
          <i
            class="sidebar-icon flex w-5 flex-shrink-0 justify-center"
            slot="icon"
          >
            {parentEntry.path === "index" ? <HomeSVG /> : <FolderUpSVG />}
          </i>
          <span class="sidebar-text truncate" slot="label">
            {parentEntry.data.title}
          </span>
        </ToolTip>
      </a>
    )
  }
  <CloseSidebar
    sidebarId="sidebar"
    backdropId="sidebar-backdrop"
    buttonId="sidebar-close"
  />
  <SidebarModeToggle toggleId={toggleId} />
</div>

<style>
  .sidebar-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--theme-navigation-sidebar-border);
    padding-bottom: 0.5rem;
    gap: 0.5rem;
  }
  .sidebar-parent { order: 3; width: 100%; }

  .sidebar-icon {
    border-left: 2px solid transparent;
    display: flex;
    width: 2.5rem;
    flex-shrink: 0;
    justify-content: center;
    padding: 0.5rem;
    pointer-events: all;
  }

  .sidebar-text {
    display: block;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    padding: 0.5rem;
    max-width: 18rem;
    pointer-events: all;
  }

  @media screen and (min-width: 768px) {
    :global(#sidebar[data-sidebar-mode="collapsed"]) .sidebar-header {
      flex-direction: column-reverse;
      align-items: center;
      margin-bottom: 0;
    }
    :global(#sidebar[data-sidebar-mode="collapsed"]) .sidebar-parent { display: none; }
    :global(#sidebar[data-sidebar-mode="collapsed"]) .sidebar-header > a:first-child { max-width: 2.5rem; overflow: hidden; }
  }
</style>
