---
import type { NavigationService } from "../../../server";
import type { BookNavigationContext } from "../../NavigationContext";
import type { NavigationContext } from "../../NavigationContext";

interface Props {
  navigationService?: NavigationService;
  book?: BookNavigationContext;
  mode?: NavigationContext["section"];
}

const { navigationService: providedNavigationService, book, mode = "read" } = Astro.props;

const slug = Astro.params.slug || "index";

export interface Crumb {
  id: string;
  title: string;
  href: string;
  current: boolean;
}
const baseCrumbs = (providedNavigationService?.getBreadcrumbs(slug) ?? []).map((crumb, index) =>
  index === 0 && book ? { ...crumb, title: book.name } : crumb
);
const modeTitle = mode === "edit" ? "Editar" : mode === "new" ? "Nuevo documento" : mode === "preview" ? "Vista previa" : undefined;
const crumbs = modeTitle
  ? [...baseCrumbs.map((crumb) => ({ ...crumb, current: false })), { id: mode, title: modeTitle, href: Astro.url.pathname, current: true }]
  : baseCrumbs;
const display = Boolean(crumbs.length);
---

<nav class="breadcrumb" aria-label="Breadcrumb" data-display={display}>
  <ol
    class="flex flex-nowrap items-center gap-2 overflow-x-auto font-[family-name:var(--theme-font-code)] text-xs text-[var(--theme-navigation-breadcrumb-text)]"
  >
    {
      crumbs.map((crumb, index) => (
        <li class="flex min-w-0 max-w-[12rem] flex-shrink items-center gap-2">
          {index > 0 && (
            <span class="flex-shrink-0 text-[var(--theme-navigation-breadcrumb-separator)]">/</span>
          )}
          {crumb.current ? (
            <span
              class="block truncate text-[var(--theme-navigation-breadcrumb-current)]"
              aria-current="page"
              title={crumb.title}
            >
              {crumb.title}
            </span>
          ) : (
            <a
              href={crumb.href}
              class="block truncate transition-colors hover:text-[var(--theme-navigation-breadcrumb-hover)]"
              title={crumb.title}
            >
              {crumb.title}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb[data-display="false"] {
    display: none;
  }
</style>
