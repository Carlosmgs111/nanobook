---
import type { Document } from "../../../document/core/types";
import EditorToolbar from "../EditorToolbar.astro";
import EditorStatus from "../EditorStatus.astro";

interface Props {
  document: Document;
  previewHref?: string;
}

const { document, previewHref } = Astro.props;
const initialContent = document.rawFrontmatter + document.content;
---

<div
  class="editor-wrapper"
  data-document={JSON.stringify(document)}
  data-document-id={document.id}
  data-initial-content={initialContent}
>
  <EditorToolbar previewHref={previewHref}>
    <EditorStatus slot="status" />
  </EditorToolbar>
  <div class="editor-container" data-editor-container></div>
</div>

<script>
  import type { Document } from "../../../document/core/types";
  import {
    createCodeMirrorEditor,
    type CodeMirrorEditorInstance,
  } from "../../core/code-mirror-editor";
  import { debounce } from "../../../shared/utils/debounce";
  import { renderStagedDocument, clearRenderedDocument } from "../../../rendering/core/render-service";
  import {
    loadStagedDocument,
    saveStagedDocument,
    ensureStagedDocument,
    clearStagedDocument,
  } from "../../core/stage-document";
  import { buildDocumentFromContent } from "../../core/parse-staged-document";
  import { saveDocument } from "../../core/save-document";

  let editor: CodeMirrorEditorInstance | null = null;
  let statusElement: HTMLElement | null = null;

  function getWrapper() {
    return document.querySelector<HTMLElement>(".editor-wrapper");
  }

  function getInitialContent(wrapper: HTMLElement) {
    const staged = loadStagedDocument();
    return staged
      ? staged.rawFrontmatter + staged.content
      : wrapper.dataset.initialContent || "";
  }

  function clearEditionStorage(): void {
    clearStagedDocument();
    clearRenderedDocument();
  }

  function isInsideEditionFlow(url: URL, documentId: string): boolean {
    const path = url.pathname.replace(/\/$/, "");
    if (documentId === "index") {
      return path === "/edit" || path === "/preview";
    }
    return path === `/${documentId}/edit` || path === `/${documentId}/preview`;
  }

  function initEditor() {
    const wrapper = getWrapper();
    if (!wrapper) return;

    const documentId = wrapper.dataset.documentId;
    const container = wrapper.querySelector<HTMLElement>(
      "[data-editor-container]"
    );
    statusElement = wrapper.querySelector<HTMLElement>(".status");

    if (!documentId || !container) {
      throw new Error("Missing editor data attributes");
    }

    destroyEditor();

    const baseDocument = JSON.parse(wrapper.dataset.document!) as Document;
    const staged = loadStagedDocument();
    if (staged && staged.id !== baseDocument.id) {
      clearEditionStorage();
    }
    ensureStagedDocument(baseDocument);

    editor = createCodeMirrorEditor({
      container,
      initialContent: getInitialContent(wrapper),
      onChange: debouncedOnChange,
    });

    setupSaveButton(wrapper, documentId);
  }

  function setupSaveButton(wrapper: HTMLElement, documentId: string) {
    const saveButton = wrapper.querySelector<HTMLButtonElement>(
      "[data-action='save']"
    );
    if (!saveButton) return;

    const cleanButton = saveButton.cloneNode(true) as HTMLButtonElement;
    saveButton.replaceWith(cleanButton);

    cleanButton.addEventListener("click", async () => {
      try {
        const document = buildDocumentFromContent(
          JSON.parse(wrapper.dataset.document!) as Document,
          editor!.getContent()
        );
        await saveDocument(documentId, document);
        showStatus("Guardado correctamente");
      } catch (error) {
        console.error(error);
        showStatus(
          error instanceof Error ? error.message : "Error al guardar",
          true
        );
      }
    });
  }

  function destroyEditor() {
    if (editor) {
      editor.destroy();
      editor = null;
    }
  }

  const debouncedOnChange = debounce(async () => {
    const wrapper = getWrapper();
    if (!wrapper || !editor) return;
    const stagedDocument = buildDocumentFromContent(
      JSON.parse(wrapper.dataset.document!) as Document,
      editor.getContent()
    );
    saveStagedDocument(stagedDocument);
    await renderStagedDocument(stagedDocument);
  }, 1000);

  function showStatus(message: string, isError = false) {
    if (!statusElement) return;
    statusElement.textContent = message;
    statusElement.className = `status ${isError ? "status-error" : "status-success"}`;
    window.setTimeout(() => {
      if (!statusElement) return;
      statusElement.textContent = "";
      statusElement.className = "status";
    }, 4000);
  }

  function prepareRenderBeforeSwap(event: Event) {
    const wrapper = getWrapper();
    const documentId = wrapper?.dataset.documentId;
    const destination = (event as unknown as { to?: URL }).to;

    if (wrapper && editor) {
      const stagedDocument = buildDocumentFromContent(
        JSON.parse(wrapper.dataset.document!) as Document,
        editor.getContent()
      );
      saveStagedDocument(stagedDocument);
      renderStagedDocument(stagedDocument).catch(console.error);
    }

    if (documentId && destination && !isInsideEditionFlow(destination, documentId)) {
      clearEditionStorage();
    }

    destroyEditor();
  }

  document.addEventListener("astro:page-load", initEditor);
  document.addEventListener("astro:before-swap", prepareRenderBeforeSwap);
</script>

<style>
  .editor-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 60vh;
  }

  .editor-container {
    flex: 1;
    width: 100%;
    min-height: 60vh;
    border: 1px solid var(--grid-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .editor-container :global(.cm-editor) {
    width: 100%;
    height: 100%;
    min-height: 60vh;
  }

  .editor-container :global(.cm-focused) {
    outline: none;
  }
</style>
