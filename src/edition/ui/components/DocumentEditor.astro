---
import type { Entry } from "../../../document/domain/types";
import { serializeEntry } from "../../../document/application/dto/SerializedEntry";
import EditorToolbar from "./EditorToolbar.astro";
import EditorStatus from "./EditorStatus.astro";

interface Props {
  entry: Entry;
  previewHref?: string;
  viewHref?: string;
}

const { entry, previewHref, viewHref } = Astro.props;
const serializedEntry = serializeEntry(entry);
const initialContent = entry.rawFrontmatter + entry.content;
---

<div class="editor-wrapper">
  <EditorToolbar
    previewHref={previewHref}
    viewHref={viewHref}
    documentId={entry.id}
  >
    <EditorStatus slot="status" />
  </EditorToolbar><div
    data-document-id={entry.id}
    data-document={JSON.stringify(serializedEntry)}
    data-initial-content={initialContent}
    class="editor-container"
    data-editor-container
  >
  </div>
</div>

<script>
  import { edition } from "../../index";
  // import handler from "../../infraestructure/WorkerHandler";
  import { basicSetup } from "codemirror";
  import { EditorView, keymap } from "@codemirror/view";
  import { EditorState } from "@codemirror/state";
  import { markdown } from "@codemirror/lang-markdown";
  import { indentWithTab } from "@codemirror/commands";
  import { debounce } from "../../../shared/utils/debounce";

  // const workerHandler = "self.onmessage = " + handler.toString()
  // console.log(workerHandler);

  // const blob = new Blob([workerHandler], { type: "application/javascript" });
  // const workerUrl = URL.createObjectURL(blob);

  // const worker = new Worker(workerUrl);

  const container = document.querySelector<HTMLElement>(
    "[data-editor-container]"
  );
  if (!container) {
    throw new Error("Missing editor container");
  }
  const baseDocument = container.dataset.document;
  const initialContent = container.dataset.initialContent;
  if (!baseDocument) {
    throw new Error("Missing base document");
  }
  let view: EditorView | undefined;
  const debouncedHandleEditorChange = debounce(async (document, content) => {
    if (edition.handleEditorChange) {
      const result = await edition.handleEditorChange.execute(
        document,
        content
      );
      if (!result.isSuccess) {
        console.error(result.getError());
        return;
      }
      // worker.postMessage({ id: result.getValue().id });
      edition.renderPreview.execute(result.getValue().id);
    }
  }, 1000);
  document.addEventListener("astro:page-load", () => {
    if (!container) {
      throw new Error("Missing editor container");
    }
    edition.initializeEditor.execute(JSON.parse(baseDocument)).getValue();
    const updateListener = EditorView.updateListener.of((update) => {
      if (update.docChanged) {
        debouncedHandleEditorChange(
          JSON.parse(baseDocument),
          update.state.doc.toString()
        );
      }
    });
    const state = EditorState.create({
      doc: initialContent,
      extensions: [
        basicSetup,
        markdown(),
        keymap.of([indentWithTab]),
        updateListener,
        EditorView.theme({
          "&": {
            fontSize: "14px",
            minHeight: "60vh",
          },
          ".cm-content": {
            fontFamily:
              'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace',
            lineHeight: "1.6",
          },
          ".cm-gutters": {
            backgroundColor: "transparent",
            borderRight: "1px solid var(--grid-line)",
          },
          ".cm-activeLineGutter": {
            backgroundColor: "var(--grid-line)",
          },
        }),
        EditorView.lineWrapping,
      ],
    });

    view = new EditorView({
      state,
      parent: container,
    });
  });
  document.addEventListener("astro:before-swap", () => {
    view?.destroy();
  });
</script>

<style>
  .editor-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 60vh;
  }

  .editor-container {
    flex: 1;
    width: 100%;
    min-height: 60vh;
    border: 1px solid var(--grid-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .editor-container :global(.cm-editor) {
    width: 100%;
    height: 100%;
    min-height: 60vh;
  }

  .editor-container :global(.cm-focused) {
    outline: none;
  }
</style>
