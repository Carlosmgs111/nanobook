---
interface Props {
  previewHref?: string;
  viewHref?: string;
  documentId?: string;
}

const { previewHref, viewHref, documentId } = Astro.props;
---

<div class="editor-toolbar">
  <button
    type="button"
    class="save-button"
    data-action="save"
    data-view-href={viewHref}
    data-document-id={documentId}>Guardar</button
  >
  {
    previewHref && (
      <a class="preview-link" href={previewHref}>
        Preview
      </a>
    )
  }
  <slot name="status" />
</div>

<style>
  .editor-toolbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--grid-line);
  }

  .save-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--grid-line-strong);
    background: var(--text);
    color: var(--bg);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .save-button:hover {
    opacity: 0.9;
  }

  .preview-link {
    color: var(--text);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid var(--text);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .preview-link:hover {
    opacity: 0.9;
  }
</style>

<script>
  import { edition } from "../../index";
  let statusElement: HTMLElement;
  function showStatus(message: string, isError = false) {
    if (!statusElement) return;
    statusElement.textContent = message;
    statusElement.className = `status ${isError ? "status-error" : "status-success"}`;
    window.setTimeout(() => {
      if (!statusElement) return;
      statusElement.textContent = "";
      statusElement.className = "status";
    }, 4000);
  }
  document.addEventListener("astro:page-load", () => {
    const saveButton = document.querySelector<HTMLButtonElement>(
      "[data-action='save']"
    );
    if (!saveButton) return;
    statusElement = document.getElementsByName("status")[0] as HTMLElement;

    const viewHref = saveButton.dataset.viewHref;
    const documentId = saveButton.dataset.documentId;
    const cleanButton = saveButton.cloneNode(true) as HTMLButtonElement;
    saveButton.replaceWith(cleanButton);
    cleanButton.addEventListener("click", async (e) => {
      e.preventDefault();
      fetch(viewHref as string, { credentials: "same-origin" });
      const result = await edition.saveDocument.execute();
      if (result.isSuccess) {
        await edition.renderPreview.execute(documentId as string);
        showStatus("Guardado correctamente");
      } else {
        const error = result.getError();
        console.error(error);
        showStatus(
          error instanceof Error ? error.message : "Error al guardar",
          true
        );
      }
    });
  });
</script>
