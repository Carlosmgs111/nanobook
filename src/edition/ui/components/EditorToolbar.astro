---
interface Props {
  previewHref?: string;
  viewHref?: string;
  documentId?: string;
  documentPath?: string;
  parentHref?: string;
  isDirectory?: boolean;
}

const {
  previewHref,
  viewHref,
  documentId,
  documentPath,
  parentHref = "/",
  isDirectory = false,
} = Astro.props;
---

<div class="editor-toolbar">
  <button
    type="button"
    class="save-button"
    data-action="save"
    data-auth-document-mutation
    data-view-href={viewHref}
    data-document-id={documentId}
    hidden>Guardar</button
  >
  <button
    type="button"
    class="delete-button"
    data-action="delete"
    data-auth-document-mutation
    data-parent-href={parentHref}
    data-is-directory={isDirectory ? "true" : "false"}
    data-document-id={documentId}
    hidden>Eliminar</button
  >
  <button
    type="button"
    class="rename-button"
    data-action="rename"
    data-auth-document-mutation
    data-document-path={documentPath}
    data-document-id={documentId}
    hidden>Renombrar</button
  >
  {
    previewHref && (
      <a class="preview-link" href={previewHref}>
        Preview
      </a>
    )
  }
  <slot name="status" />
</div>

<script>
  import { edition } from "../../index";
  import { prefetch } from "astro:prefetch";
  let statusElement: HTMLElement;
  function showStatus(message: string, isError = false) {
    if (!statusElement) return;
    statusElement.textContent = message;
    statusElement.className = `status ${isError ? "status-error" : "status-success"}`;
    window.setTimeout(() => {
      if (!statusElement) return;
      statusElement.textContent = "";
      statusElement.className = "status";
    }, 4000);
  }
  document.addEventListener("astro:page-load", () => {
    statusElement = document.querySelector<HTMLElement>(
      "[data-edition-result]"
    ) as HTMLElement;
    const saveButton = document.querySelector<HTMLButtonElement>(
      "[data-action='save']"
    );
    if (!saveButton) return;

    const viewHref = saveButton.dataset.viewHref;
    const documentId = saveButton.dataset.documentId;
    const cleanButton = saveButton.cloneNode(true) as HTMLButtonElement;
    saveButton.replaceWith(cleanButton);
    cleanButton.addEventListener("click", async (e) => {
      e.preventDefault();
      const result = await edition.saveDocument.execute(
        saveButton.dataset.documentId as string
      );
      if (result.isSuccess) {
        prefetch(viewHref as string);
        showStatus("Guardado correctamente");
      } else {
        const error = result.getError();
        console.error(error);
        showStatus(
          error instanceof Error ? error.message : "Error al guardar",
          true
        );
      }
    });

    const deleteButton = document.querySelector<HTMLButtonElement>("[data-action='delete']");
    if (!deleteButton) return;
    const cleanDeleteButton = deleteButton.cloneNode(true) as HTMLButtonElement;
    deleteButton.replaceWith(cleanDeleteButton);
    cleanDeleteButton.addEventListener("click", async (e) => {
      e.preventDefault();
      const isDirectory = cleanDeleteButton.dataset.isDirectory === "true";
      const message = isDirectory
        ? "Este documento es un directorio. Se eliminarán también todos los documentos que contiene. Esta acción no se puede deshacer. ¿Deseas continuar?"
        : "Este documento se eliminará permanentemente. ¿Deseas continuar?";
      if (!window.confirm(message)) return;
      const result = await edition.deleteDocument.execute(cleanDeleteButton.dataset.documentId as string);
      if (!result.isSuccess) {
        const error = result.getError();
        console.error(error);
        showStatus(error instanceof Error ? error.message : "Error al eliminar", true);
        return;
      }
      window.location.href = cleanDeleteButton.dataset.parentHref || "/";
    });

    const renameButton = document.querySelector<HTMLButtonElement>("[data-action='rename']");
    if (!renameButton) return;
    const cleanRenameButton = renameButton.cloneNode(true) as HTMLButtonElement;
    renameButton.replaceWith(cleanRenameButton);
    cleanRenameButton.addEventListener("click", async (e) => {
      e.preventDefault();
      const currentPath = cleanRenameButton.dataset.documentPath || "";
      const nextPath = window.prompt(
        "Nueva ruta interna del documento (usa /index para directorios):",
        currentPath
      );
      if (nextPath === null || nextPath.trim() === currentPath) return;

      const result = await edition.renameDocument.execute(
        cleanRenameButton.dataset.documentId as string,
        nextPath
      );
      if (!result.isSuccess) {
        const error = result.getError();
        console.error(error);
        showStatus(error instanceof Error ? error.message : "Error al renombrar", true);
        return;
      }

      const renamed = result.getValue();
      const publicPath = renamed.isIndex && renamed.path !== "index"
        ? renamed.path.slice(0, -"/index".length)
        : renamed.path;
      window.location.href = publicPath === "index" ? "/" : `/${publicPath}`;
    });
  });
</script>

<style>
  .editor-toolbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--grid-line);
  }

  .save-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--grid-line-strong);
    background: var(--text);
    color: var(--bg);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .delete-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #b42318;
    background: transparent;
    color: #b42318;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .rename-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--grid-line-strong);
    background: transparent;
    color: var(--text);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .save-button:hover {
    opacity: 0.9;
  }

  .preview-link {
    color: var(--text);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid var(--text);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .preview-link:hover {
    opacity: 0.9;
  }
</style>
