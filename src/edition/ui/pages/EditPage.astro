---
import DocumentEditor from "../components/DocumentEditor.astro";
import type { Entry } from "../../../document/domain/types";

interface Props {
  entry: Entry;
  previewHref: string;
  viewHref: string;
}

const { entry, previewHref, viewHref } = Astro.props;
---

<div class="mb-10 border-b border-[var(--grid-line-strong)] pb-8">
  <span class="tech-label mb-3 block">Editing document</span>
  <h1
    class="glow-text text-3xl font-semibold tracking-tight text-[var(--accent)] md:text-4xl"
  >
    {entry.title}
  </h1>
</div>

<DocumentEditor entry={entry} previewHref={previewHref} viewHref={viewHref} />
