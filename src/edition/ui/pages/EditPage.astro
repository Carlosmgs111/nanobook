---
import DocumentEditor from "../components/DocumentEditor.astro";
import type { Entry } from "../../../document/domain/types";

interface Props {
  entry: Entry;
  previewHref: string;
  viewHref: string;
}

const { entry, previewHref, viewHref } = Astro.props;
---

<div class="mb-10 border-b border-[var(--grid-line-strong)] pb-8">
  <span class="tech-label mb-3 block">Editing document</span>
  <h1
    class="glow-text text-3xl font-semibold tracking-tight text-[var(--accent)] md:text-4xl"
  >
    {entry.title}
  </h1>
</div>

{entry.ref && (
  <div
    class="mb-4 border border-[var(--grid-line-strong)] bg-[var(--bg-elevated)] p-6 text-[var(--muted)]"
    role="status"
  >
    <h2 class="mb-3 text-lg font-semibold text-[var(--accent)]">
      Proxy: solo se edita el frontmatter
    </h2>
    <p>
      Este documento muestra el contenido de <code>{entry.ref}</code>. El cuerpo
      referenciado no se carga ni se puede modificar desde aquí.
    </p>
    <p class="mt-3">
      Puedes cambiar el título, descripción y demás metadatos del proxy. Edita
      el documento original si necesitas cambiar el contenido mostrado.
    </p>
  </div>
)}

<DocumentEditor
  entry={entry}
  previewHref={entry.ref ? undefined : previewHref}
  viewHref={viewHref}
  frontmatterOnly={Boolean(entry.ref)}
/> 
