---
import Layout from "../../../layouts/Layout.astro";
import ProfileForm from "./ProfileForm.astro";
---

<Layout
  title="Perfil | Nanobook"
  description="Administra tu sesión de Nanobook."
  hideToc={true}
>
  <section class="mx-auto max-w-xl px-6 py-16" data-profile-page>
    <a
      href="/"
      class="mb-6 inline-flex items-center justify-center bg-[var(--theme-text)] px-4 py-2 text-sm font-medium !text-[var(--theme-page-bg)] transition-colors hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-[var(--theme-accent)]/50 !no-underline"
    >
      ← Volver al inicio
    </a>
    <h1>Perfil</h1>
    <p class="max-w-prose text-[var(--theme-text-muted)]">
      Elige el nombre público con el que aparecerán tus documentos.
    </p>
    <ProfileForm />
    <button
      type="button"
      data-sign-out
      class="mt-10 inline-flex items-center justify-center bg-[var(--theme-text)] px-4 py-2 text-sm font-medium !text-[var(--theme-page-bg)] transition-colors hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-[var(--theme-accent)]/50"
    >
      Cerrar sesión
    </button>
  </section>
</Layout>
