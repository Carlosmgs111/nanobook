---
interface Heading {
  slug: string;
}

interface Props {
  headings: Heading[];
  tocRootId: string;
  tocNavId: string;
}

const { headings, tocRootId, tocNavId } = Astro.props;
const indicatorId = `${tocRootId}-indicator`;
---

<div id={indicatorId} class="toc-indicator" aria-hidden="true">
  {
    headings.map((heading) => (
      <div class="toc-indicator-line" data-slug={heading.slug} />
    ))
  }
</div>

<script define:vars={{ indicatorId, tocNavId }} type="module">
  (function () {
    const tocIndicator = document.getElementById(indicatorId);
    const tocNav = document.getElementById(tocNavId);
    if (!tocIndicator || !tocNav) return;

    const tocLines = tocIndicator.querySelectorAll(".toc-indicator-line");

    function positionIndicatorLines(lines, offsets) {
      const total = document.documentElement.scrollHeight - window.innerHeight;
      lines.forEach((line, i) => {
        const percent =
          total > 0 ? (offsets[i] / total) * 100 : i === 0 ? 0 : 100;
        line.style.top = `${Math.min(100, Math.max(0, percent))}%`;
      });
    }

    function initIndicatorLines(lines, headings) {
      if (headings.length === 0) return;

      function measure() {
        const offsets = headings.map((heading) => heading.element.offsetTop);
        positionIndicatorLines(lines, offsets);
      }

      window.addEventListener("resize", measure);
      window.addEventListener("orientationchange", measure);

      if (document.readyState === "complete") {
        measure();
      } else {
        window.addEventListener("load", measure);
      }
    }

    tocNav.addEventListener("headings", (e) => {
      initIndicatorLines(tocLines, e.detail.headings);
    });
    tocNav.addEventListener("active", (e) => {
      tocLines.forEach((line) => {
        line.dataset.isActive = String(
          line.dataset.slug === e.detail.activeId
        );
      });
    });
  })();
</script>

<style>
  .toc-indicator {
    position: relative;
    height: 100%;
    width: 18px;
    border: 1px solid var(--grid-line-strong);
  }

  :global(#toc-root[data-toc-mode="standard"]) .toc-indicator {
    display: none;
  }

  .toc-indicator-line {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 2px;
    background: var(--muted);
    transition:
      width 0.15s,
      background 0.15s;
  }

  .toc-indicator-line[data-is-active="true"] {
    width: 24px;
    background: var(--accent);
  }
</style>
