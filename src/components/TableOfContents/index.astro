---
import TocIndicator from "./TocIndicator.astro";
import TocNav from "./TocNav.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

<div class="hidden md:block md:h-[calc(100vh-10rem)] md:sticky md:top-32 md:flex-shrink-0">
  <div
    class="toc-root"
    data-toc-mode="standard"
    data-is-visible={headings.length > 0}
  >
    <TocIndicator headings={headings} />
    <TocNav headings={headings} />
  </div>
</div>

<script is:inline>
  (function () {
    const saved =
      typeof localStorage !== "undefined"
        ? localStorage.getItem("toc-mode")
        : null;
    if (saved !== "compact" && saved !== "standard") return;

    const root = document.querySelector(".toc-root");
    const toggle = document.getElementById("toc-toggle");
    if (!root) return;

    root.setAttribute("data-toc-mode", saved);
    if (toggle) {
      toggle.setAttribute("data-toc-mode", saved);
      toggle.setAttribute("aria-pressed", String(saved === "compact"));
    }
  })();
</script>

<style>
  .toc-root {
    position: relative;
    display: none;
  }

  .toc-root[data-toc-mode="compact"] {
    height: inherit;
    z-index: 40;
  }

  @media (min-width: 768px) {
    .toc-root[data-is-visible="true"] {
      display: block;
    }
  }
</style>
