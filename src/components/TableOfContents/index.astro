---
import TocIndicator from "./TocIndicator.astro";
import TocNav from "./TocNav.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;

const tocRootId = "toc-root";
const tocNavId = "toc-nav";
const toggleId = "toc-toggle";
const display = Boolean(headings.length);
---

<div
  data-display={display}
  class="hidden md:block md:h-[calc(100vh-10rem)] md:sticky md:top-32 md:flex-shrink-0"
>
  <div
    id={tocRootId}
    class="toc-root"
    data-toc-mode="standard"
    data-is-visible={headings.length > 0}
  >
    <TocIndicator
      headings={headings}
      tocRootId={tocRootId}
      tocNavId={tocNavId}
    />
    <TocNav
      headings={headings}
      tocRootId={tocRootId}
      tocNavId={tocNavId}
      toggleId={toggleId}
    />
  </div>
</div>

<style>
  .toc-root {
    position: relative;
    display: none;
  }

  .toc-root[data-display="false"] {
    display: none;
  }

  .toc-root[data-toc-mode="compact"] {
    height: inherit;
    z-index: 40;
  }

  @media (min-width: 768px) {
    .toc-root[data-is-visible="true"] {
      display: block;
    }
  }
</style>
