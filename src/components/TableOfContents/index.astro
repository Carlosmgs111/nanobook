---
import TocIndicator from "./TocIndicator.astro";
import TocNav from "./TocNav.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

<div class="hidden md:block md:h-[calc(100vh-10rem)] md:sticky md:top-32 md:flex-shrink-0">
  <div
    class="toc-root"
    data-toc-mode="standard"
    data-is-visible={headings.length > 0}
  >
    <TocIndicator headings={headings} />
    <TocNav headings={headings} />
  </div>
</div>

<script is:inline>
  (function () {
    const saved =
      typeof localStorage !== "undefined"
        ? localStorage.getItem("toc-mode")
        : null;
    if (saved !== "compact" && saved !== "standard") return;

    const root = document.querySelector(".toc-root");
    const toggle = document.getElementById("toc-toggle");
    if (!root) return;

    root.setAttribute("data-toc-mode", saved);
    if (toggle) {
      toggle.setAttribute("data-toc-mode", saved);
      toggle.setAttribute("aria-pressed", String(saved === "compact"));
    }
  })();
</script>

<style>
  .toc-root {
    position: relative;
    display: none;
  }

  .toc-root[data-toc-mode="compact"] {
    height: inherit;
    z-index: 40;
  }

  @media (min-width: 768px) {
    .toc-root[data-is-visible="true"] {
      display: block;
    }
  }
</style>

<script>
  import { findActiveIndex } from "../../lib/scroll-spy.ts";

  (function () {
    const tocRoot = document.querySelector(".toc-root") as HTMLElement;
    if (!tocRoot || tocRoot.offsetParent === null) return;

    const toggle = document.getElementById("toc-toggle") as HTMLElement;
    if (!toggle) return;

    const tocLinks = document.querySelectorAll('.toc-item a[href^="#"]') as NodeListOf<HTMLElement>;
    const tocLines = document.querySelectorAll(".toc-indicator-line") as NodeListOf<HTMLElement>;

    initTocMode(tocRoot, toggle);
    initScrollSpy(tocRoot, tocLinks, tocLines);

    function initTocMode(root: HTMLElement, button: HTMLElement) {
      const saved =
        typeof localStorage !== "undefined"
          ? localStorage.getItem("toc-mode")
          : null;

      const mode = saved === "compact" ? "compact" : "standard";
      setTocMode(root, button, mode);

      button.addEventListener("click", function () {
        const current = root.getAttribute("data-toc-mode") || "standard";
        const next = current === "standard" ? "compact" : "standard";
        setTocMode(root, button, next);
      });
    }

    function setTocMode(root: HTMLElement, button: HTMLElement, mode: string) {
      root.setAttribute("data-toc-mode", mode);
      button.setAttribute("data-toc-mode", mode);
      button.setAttribute("aria-pressed", String(mode === "compact"));
      if (typeof localStorage !== "undefined") {
        localStorage.setItem("toc-mode", mode);
      }
    }

    function initScrollSpy(
      root: HTMLElement,
      links: NodeListOf<HTMLElement>,
      lines: NodeListOf<HTMLElement>
    ) {
      if (links.length === 0) return;

      const headings = collectHeadings(links);
      if (headings.length === 0) return;

      const offset = 120;
      let offsets: number[] = [];
      let activeIndex = -1;

      function measure() {
        offsets = headings.map((heading) => heading.element.offsetTop);
        positionIndicatorLines(lines, offsets);
        updateActive(links, lines, headings, offsets);
      }

      function onScroll() {
        updateActive(links, lines, headings, offsets);
      }

      function updateActive(
        links: NodeListOf<HTMLElement>,
        lines: NodeListOf<HTMLElement>,
        headings: { element: Element; id: string }[],
        offsets: number[]
      ) {
        const newIndex = findActiveIndex(window.scrollY, offsets, offset);
        if (newIndex === activeIndex) return;
        activeIndex = newIndex;

        const activeId = headings[activeIndex].id;

        links.forEach((link) => {
          link.dataset.isActive = String(link.getAttribute("href") === "#" + activeId);
        });

        lines.forEach((line, i) => {
          line.dataset.isActive = String(i === activeIndex);
        });
      }

      let ticking = false;
      window.addEventListener("scroll", function () {
        if (!ticking) {
          window.requestAnimationFrame(function () {
            onScroll();
            ticking = false;
          });
          ticking = true;
        }
      });

      window.addEventListener("resize", measure);
      window.addEventListener("orientationchange", measure);

      if (document.readyState === "complete") {
        measure();
      } else {
        window.addEventListener("load", measure);
      }
    }

    function collectHeadings(links: NodeListOf<HTMLElement>): { id: string; element: HTMLElement }[] {
      const headings: { id: string; element: HTMLElement }[] = [];
      links.forEach((link) => {
        const heading = document.getElementById(
          link.getAttribute("href")!.slice(1)
        );
        if (heading) {
          headings.push({ id: heading.id, element: heading });
        }
      });
      return headings;
    }

    function positionIndicatorLines(lines: NodeListOf<HTMLElement>, offsets: number[]) {
      const total = document.documentElement.scrollHeight - window.innerHeight;
      lines.forEach((line, i) => {
        const percent =
          total > 0 ? (offsets[i] / total) * 100 : i === 0 ? 0 : 100;
        line.style.top = `${Math.min(100, Math.max(0, percent))}%`;
      });
    }
  })();
</script>
