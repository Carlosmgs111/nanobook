---
import HomeSVG from "../../icons/home.svg";
import FolderUpSVG from "../../icons/folder-up.svg";
import SidebarModeToggle from "./SidebarModeToggle.astro";
import CloseSidebar from "./CloseSidebar.astro";

interface ParentEntry {
  id: string;
  data: {
    title: string;
  };
}

interface Props {
  parentEntry?: ParentEntry | null;
  toggleId: string;
}

const { parentEntry, toggleId } = Astro.props;

function parentHref(parent: ParentEntry): string {
  return parent.id === "index" ? "/" : `/${parent.id}/`;
}
---

<div
  id="sidebar-header"
  class="sidebar-header z-10 mb-6 flex items-end justify-between border-b border-[var(--grid-line-strong)] pb-2"
>
  {
    parentEntry && (
      <a
        href={parentHref(parentEntry)}
        class="sidebar-parent group flex items-center gap-2 text-sm text-[var(--muted)] hover:text-[var(--accent)]"
        data-tooltip={parentEntry.data.title}
      >
        <i class="sidebar-icon flex w-5 flex-shrink-0 justify-center">
          {parentEntry.id === "index" ? <HomeSVG /> : <FolderUpSVG />}
        </i>
        <span class="sidebar-text truncate">{parentEntry.data.title}</span>
      </a>
    )
  }
  <CloseSidebar
    sidebarId="sidebar"
    backdropId="sidebar-backdrop"
    buttonId="sidebar-close"
  />
  <SidebarModeToggle toggleId={toggleId} />
</div>

<style>
  .sidebar-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    border-bottom: 1px solid var(--grid-line-strong);
    padding-bottom: 0.5rem;
    gap: 0.5rem;
  }

  @media screen and (min-width: 768px) {
    .sidebar-header[data-sidebar-mode="collapsed"] {
      flex-direction: column-reverse;
      align-items: center;
      margin-bottom: 0;
    }

    .sidebar-header[data-sidebar-mode="collapsed"] span {
      display: none;
    }
  }
</style>

<script define:vars={{ toggleId }}>
  (function () {
    const header = document.getElementById("sidebar-header");
    const toggle = document.getElementById(toggleId);
    if (!header || !toggle) return;

    function syncHeaderMode() {
      header.dataset.sidebarMode = toggle.dataset.sidebarMode || "expanded";
    }

    syncHeaderMode();
    toggle.addEventListener("click", syncHeaderMode);
  })();
</script>
