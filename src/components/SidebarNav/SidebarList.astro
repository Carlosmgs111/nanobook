---
import FileSVG from "../../icons/file.svg";
import FolderSVG from "../../icons/folder.svg";
import ToolTip from "./ToolTip.astro";
import type { NavigationNode } from "../../core/navigation/builder";

interface Props {
  entries: NavigationNode[];
}

const { entries } = Astro.props;
---

<ul class="sidebar-list">
  {
    entries.map((page) => (
      <li>
        <a
          href={`/${page.id}/`}
          class="sidebar-link"
          aria-current={page.current ? "page" : undefined}
          data-tooltip={page.title}
        >
          <ToolTip id={"tooltip-" + page.id}>
            <i class="sidebar-icon" slot="icon">
              {page.isIndex ? <FolderSVG /> : <FileSVG />}
            </i>
            <span class="sidebar-text" slot="label" title={page.title}>
              {page.title}
            </span>
          </ToolTip>
        </a>
      </li>
    ))
  }
</ul>

{
  entries.length === 0 && (
    <p class="sidebar-empty">No hay elementos en esta sección.</p>
  )
}

<style>
  .sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1 1 0%;
    min-height: 0;
  }

  :global(.sidebar-root[data-sidebar-mode="collapsed"]) .sidebar-list {
    width: calc(100% + 20rem);
    pointer-events: none;
    padding: 0.5rem 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .sidebar-list::-webkit-scrollbar {
    display: none;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    font-size: 0.875rem;
    line-height: 1.25rem;
    width: 100%;
    min-width: 0;
    color: var(--muted);
    position: relative;
    z-index: 10;
  }

  .sidebar-link:hover .sidebar-icon,
  .sidebar-link:hover .sidebar-text {
    border-color: var(--grid-line-strong);
    background: rgba(255, 255, 255, 0.05);
    color: var(--text);
  }

  .sidebar-link[aria-current="page"] .sidebar-icon,
  .sidebar-link[aria-current="page"] .sidebar-text {
    border-color: var(--accent);
    background: rgba(255, 255, 255, 0.05);
    color: var(--text);
  }

  .sidebar-icon {
    border-left: 2px solid transparent;
    display: flex;
    width: 2.5rem;
    flex-shrink: 0;
    justify-content: center;
    padding: 0.5rem;
    pointer-events: all;
  }

  .sidebar-text {
    display: block;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    padding: 0.5rem;
    max-width: 18rem;
    pointer-events: all;
  }

  .sidebar-empty {
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--muted);
  }
</style>
