---
import SidebarBackdrop from "./SidebarBackdrop.astro";
import SidebarHeader from "./SidebarHeader.astro";
import SidebarList from "./SidebarList.astro";
import SidebarTooltip from "./SidebarTooltip.astro";

interface Entry {
  id: string;
  data: {
    title: string;
    description: string;
    draft: boolean;
    index: boolean;
  };
  current?: boolean;
}

interface ParentEntry {
  id: string;
  data: {
    title: string;
  };
}

interface Props {
  entries: Entry[];
  parentEntry?: ParentEntry | null;
}

const { entries, parentEntry } = Astro.props;

const sortedEntries = entries
  .filter((page) => !page.data.draft)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<SidebarBackdrop />
<SidebarTooltip />

<aside
  id="sidebar"
  class="sidebar-root fixed inset-y-0 left-0 z-[60] hidden -translate-x-full border-r border-[var(--grid-line-strong)] bg-[var(--bg)] p-6 transition-[width,padding] duration-200 md:sticky md:top-32 md:z-auto md:block md:h-[calc(100vh-9rem)] md:max-h-[calc(100vh-9rem)] md:flex-shrink-0 md:translate-x-0 md:overflow-y-auto md:border md:border-[var(--grid-line-strong)] md:bg-[var(--layer-1)] md:p-4"
  data-sidebar-mode="expanded"
>
  <SidebarHeader parentEntry={parentEntry} />
  <SidebarList entries={sortedEntries} />
</aside>

<script is:inline>
  (function () {
    const saved =
      typeof localStorage !== "undefined"
        ? localStorage.getItem("sidebar-mode")
        : null;
    if (saved !== "collapsed" && saved !== "expanded") return;

    const sidebar = document.getElementById("sidebar");
    const toggle = document.getElementById("sidebar-mode-toggle");
    if (!sidebar) return;

    sidebar.setAttribute("data-sidebar-mode", saved);
    if (toggle) {
      toggle.setAttribute("data-sidebar-mode", saved);
      toggle.setAttribute("aria-pressed", String(saved === "collapsed"));
      toggle.setAttribute(
        "aria-label",
        saved === "expanded" ? "Contraer navegación" : "Expandir navegación"
      );
    }
  })();
</script>

<script>
  import { initSidebarMobile } from "./SidebarNavMobile.logic.ts";

  const sidebar = document.getElementById("sidebar");
  const openButton = document.getElementById("sidebar-toggle");
  const closeButton = document.getElementById("sidebar-close");
  const backdrop = document.getElementById("sidebar-backdrop");

  if (sidebar && backdrop) {
    initSidebarMobile(sidebar, openButton, closeButton, backdrop);
  }
</script>

  <style>
  .sidebar-root {
    width: min(80vw, 20rem);
  }

  @media (min-width: 768px) {
    .sidebar-root {
      width: 16rem;
    }

    .sidebar-root[data-sidebar-mode="collapsed"] {
      width: 4rem;
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    .sidebar-root[data-sidebar-mode="collapsed"] :global(.sidebar-text) {
      display: none;
    }

    :global(#sidebar-header) {
      display: flex;
      align-items: end;
      justify-content: space-between;
      border-bottom: 1px solid var(--grid-line-strong);
      padding-bottom: 0.5rem;
      gap: 0.5rem;
    }

    .sidebar-root[data-sidebar-mode="collapsed"] :global(#sidebar-header) {
      flex-direction: column-reverse;
      align-items: center;
      margin-bottom: 0;
    }
  }
</style>
