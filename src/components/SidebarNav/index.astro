---
import SidebarHeader from "./SidebarHeader.astro";
import SidebarList from "./SidebarList.astro";

interface Entry {
  id: string;
  data: {
    title: string;
    description: string;
    draft: boolean;
    index: boolean;
  };
  current?: boolean;
}

interface ParentEntry {
  id: string;
  data: {
    title: string;
  };
}

interface Props {
  entries: Entry[];
  parentEntry?: ParentEntry | null;
}

const { entries, parentEntry } = Astro.props;

const sortedEntries = entries
  .filter((page) => !page.data.draft)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const toggleId = "sidebar-mode-toggle";
---

<div
  id="sidebar-backdrop"
  class="sidebar-backdrop"
  data-is-hidden="true"
  aria-hidden="true"
>
</div>

<aside
  id="sidebar"
  class="sidebar-root"
  data-sidebar-mode="expanded"
  data-is-hidden="true"
>
  <SidebarHeader toggleId={toggleId} parentEntry={parentEntry} />
  <SidebarList toggleId={toggleId} entries={sortedEntries} />
</aside>

<style>
  .sidebar-backdrop {
    position: fixed;
    inset: 0;
    z-index: 50;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    display: none;
  }

  .sidebar-backdrop[data-is-hidden="false"] {
    display: block;
  }

  .sidebar-root {
    position: fixed;
    left: 0;
    z-index: 60;
    border-right-width: 1px;
    border-color: var(--grid-line-strong);
    background-color: var(--bg);
    padding: 1.5rem;
    transition-property: width, padding;
    transition-duration: 200ms;
    display: none;
    transform: translateX(-100%);
    width: min(80vw, 20rem);
    overflow: hidden;
    height: 100%;
    top:0;
  }

  .sidebar-root[data-is-hidden="false"] {
    display: block;
    transform: translateX(0);
  }

  @media (min-width: 768px) {
    .sidebar-backdrop {
      display: none;
    }
    .sidebar-root {
      position: sticky;
      top: 8rem;
      display: block;
      height: calc(100vh - 9rem);
      max-height: calc(100vh - 9rem);
      flex-shrink: 0;
      transform: translateX(0);
      border-width: 1px;
      border-color: var(--grid-line-strong);
      background-color: var(--layer-1);
      padding: 1rem;
      width: 16rem;
    }

    .sidebar-root[data-sidebar-mode="collapsed"] {
      width: 4rem;
      padding-left: 0.75rem;
      padding-right: 0.75rem;
      overflow: unset;
    }
  }
</style>

<script is:inline>
  (function () {
    const saved =
      typeof localStorage !== "undefined"
        ? localStorage.getItem("sidebar-mode")
        : null;
    if (saved !== "collapsed" && saved !== "expanded") return;

    const sidebar = document.getElementById("sidebar");
    const toggle = document.getElementById("sidebar-mode-toggle");
    const backdrop = document.getElementById("sidebar-backdrop");
    if (!sidebar || !toggle || !backdrop) return;

    sidebar.setAttribute("data-sidebar-mode", saved);
    backdrop.addEventListener("click", () => {
      sidebar.dataset.isHidden = true;
      backdrop.dataset.isHidden = true;
    });
    toggle.setAttribute("data-sidebar-mode", saved);
    toggle.setAttribute("aria-pressed", String(saved === "collapsed"));
    toggle.setAttribute(
      "aria-label",
      saved === "expanded" ? "Contraer navegación" : "Expandir navegación"
    );
  })();
</script>
