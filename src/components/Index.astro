---
import "../styles/components/index-card.css";
import FolderSvg from "../icons/folder.svg";
import FileSvg from "../icons/file.svg";
const { page, index } = Astro.props;
---

<div class="index-card-wrapper relative" data-folder={String(page.data.index)}>
  <a
    href={`/${page.id}`}
    class={`index-card group flex items-center gap-4 border border-[var(--grid-line-strong)] p-5 transition-colors hover:border-[var(--accent)] hover:bg-white/5 ${page.data.index ? "corner-L-sm border-r-2 border-r-[var(--accent)]" : "corner-plus-sm"}`}
    data-title={page.data.title}
    data-description={page.data.description}
    data-draft={String(page.data.draft)}
  >
    <span class="font-mono text-xs text-[var(--muted)]">
      {String(index + 1).padStart(2, "0")}
    </span>
    {page.data.index ? <FolderSvg /> : <FileSvg />}
    <div class="index-card-body flex-1">
      <span
        class="index-card-title block text-lg font-medium text-[var(--text)] transition-colors group-hover:text-[var(--accent)]"
        data-title={page.data.title}></span>
      <span
        class="index-card-desc mt-1 block text-sm text-[var(--muted)]"
        data-description={page.data.description}></span>
    </div>
    <span class="font-mono text-xs text-[var(--muted)]">
      /{page.id + (page.data.index ? "/" : ".md")}
    </span>
  </a>
</div>
