---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

<div class="h-[calc(100vh-10rem)] sticky top-32 flex-shrink-0">
  {
    headings.length > 0 && (
      <div class="toc-root md:block" data-toc-mode="standard">
        <div class="toc-indicator" aria-hidden="true">
          {headings.map((heading) => (
            <div class="toc-indicator-line" data-slug={heading.slug} />
          ))}
        </div>

        <nav class="toc-nav" aria-label="En esta página">
          <span class="tech-label mb-3 block">En esta página</span>
          <ul class="space-y-1 border-l border-[var(--grid-line-strong)]">
            {headings.map((heading) => (
              <li
                class="toc-item"
                data-depth={heading.depth}
                data-slug={heading.slug}
                style={`padding-left: ${(heading.depth - 2) * 0.75}rem`}
              >
                <a
                  href={`#${heading.slug}`}
                  class="block py-1 pl-3 text-sm"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    )
  }
</div>

<style>
  .toc-root {
    position: relative;
  }

  .toc-root[data-toc-mode="standard"] .toc-indicator {
    display: none;
  }

  .toc-root[data-toc-mode="standard"] .toc-nav {
    display: block;
  }
  .toc-nav {
    padding: 1rem;
    border: 1px solid var(--grid-line-strong);
    background: var(--layer-1);
    max-height: calc(100vh - 10rem);
    overflow-y: auto;
    width: 18rem;
  }

  .toc-root[data-toc-mode="compact"] {
    height: inherit;
    z-index: 40;
  }

  .toc-root[data-toc-mode="compact"] .toc-indicator {
    position: relative;
    height: 100%;
    width: 18px;
    border: 1px solid var(--grid-line-strong);
  }

  .toc-indicator-line {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 2px;
    background: var(--muted);
    transition:
      width 0.15s,
      background 0.15s;
  }

  .toc-indicator-line[data-is-active="true"] {
    width: 24px;
    background: var(--accent);
  }

  .toc-root[data-toc-mode="compact"] .toc-nav {
    display: none;
    position: absolute;
    right: 100%;
    width: 220px;
    min-height: 100%;
    padding: 0.75rem;
  }

  .toc-root[data-toc-mode="compact"]:hover .toc-nav,
  .toc-root[data-toc-mode="compact"]:focus-within .toc-nav {
    display: block;
    top: 0;
  }

  .toc-item a {
    border-left: 2px solid transparent;
    color: var(--muted);
    background: unset;
  }

  .toc-item a:hover {
    border-left-color: var(--grid-line-strong);
    color: var(--text);
  }

  .toc-item a[data-is-active="true"] {
    border-left: 2px solid var(--accent);
    color: var(--text);
    background: #ffffff0d;
  }

  .toc-item a[data-is-active="true"]:hover {
    border-left-color: var(--accent);
  }
</style>

<script is:inline>
  (function () {
    const tocRoot = document.querySelector(".toc-root");
    if (!tocRoot || tocRoot.offsetParent === null) return;

    const tocLinks = document.querySelectorAll('.toc-item a[href^="#"]');
    const tocLines = document.querySelectorAll(".toc-indicator-line");
    if (tocLinks.length === 0) return;

    const headings = [];
    tocLinks.forEach((link) => {
      const heading = document.getElementById(
        link.getAttribute("href").slice(1)
      );
      if (heading) {
        headings.push({ id: heading.id, element: heading });
      }
    });

    if (headings.length === 0) return;

    const offset = 120;
    let offsets = [];
    let activeIndex = -1;

    function measure() {
      offsets = headings.map((heading) => heading.element.offsetTop);
      positionIndicatorLines();
      updateActive();
    }

    function positionIndicatorLines() {
      const total = document.documentElement.scrollHeight - window.innerHeight;
      tocLines.forEach((line, i) => {
        const percent =
          total > 0 ? (offsets[i] / total) * 100 : i === 0 ? 0 : 100;
        line.style.top = `${Math.min(100, Math.max(0, percent))}%`;
      });
    }

    function findActiveIndex(scrollY) {
      const target = scrollY + offset;
      let left = 0;
      let right = offsets.length - 1;
      let result = 0;

      while (left <= right) {
        const mid = (left + right) >>> 1;
        if (offsets[mid] <= target) {
          result = mid;
          left = mid + 1;
        } else {
          right = mid - 1;
        }
      }

      return result;
    }

    function updateActive() {
      const newIndex = findActiveIndex(window.scrollY);
      if (newIndex === activeIndex) return;
      activeIndex = newIndex;

      const activeId = headings[activeIndex].id;

      tocLinks.forEach((link) => {
        link.dataset.isActive = link.getAttribute("href") === "#" + activeId;
      });

      tocLines.forEach((line, i) => {
        line.dataset.isActive = i === activeIndex;
      });
    }

    let ticking = false;
    window.addEventListener("scroll", function () {
      if (!ticking) {
        window.requestAnimationFrame(function () {
          updateActive();
          ticking = false;
        });
        ticking = true;
      }
    });

    window.addEventListener("resize", measure);
    window.addEventListener("orientationchange", measure);

    if (document.readyState === "complete") {
      measure();
    } else {
      window.addEventListener("load", measure);
    }
  })();
</script>
