---
interface Crumb {
  id: string;
  title: string;
  href: string;
  current: boolean;
}

interface Props {
  crumbs?: Crumb[];
}

const { crumbs = [] } = Astro.props;
const display = Boolean(crumbs.length);
---

<nav class="breadcrumb" aria-label="Breadcrumb" data-display={display}>
  <ol
    class="flex flex-nowrap items-center gap-2 overflow-x-auto font-mono text-xs text-[var(--muted)]"
  >
    {
      crumbs.map((crumb, index) => (
        <li class="flex min-w-0 max-w-[12rem] flex-shrink items-center gap-2">
          {index > 0 && (
            <span class="flex-shrink-0 text-[var(--grid-line-strong)]">/</span>
          )}
          {crumb.current ? (
            <span
              class="block truncate text-[var(--text)]"
              aria-current="page"
              title={crumb.title}
            >
              {crumb.title}
            </span>
          ) : (
            <a
              href={crumb.href}
              class="block truncate transition-colors hover:text-[var(--accent)]"
              title={crumb.title}
            >
              {crumb.title}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb[data-display="false"] {
    display: none;
  }
</style>
