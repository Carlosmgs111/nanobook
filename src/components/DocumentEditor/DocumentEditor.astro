---
interface Props {
  documentId: string;
  initialContent: string;
}

const { documentId, initialContent } = Astro.props;
---

<div class="editor-wrapper" data-document-id={documentId} data-initial-content={initialContent}>
  <div class="editor-toolbar">
    <button type="button" class="save-button" data-action="save">Guardar</button>
    <span class="status" role="status" aria-live="polite"></span>
  </div>
  <div class="editor-container" data-editor-container></div>
</div>

<script>
  import { createCodeMirrorEditor } from "./code-mirror-editor";

  const wrapper = document.querySelector<HTMLElement>(".editor-wrapper");
  if (!wrapper) throw new Error("Editor wrapper not found");

  const documentId = wrapper.dataset.documentId;
  const initialContent = wrapper.dataset.initialContent;
  const container = wrapper.querySelector<HTMLElement>("[data-editor-container]");
  const saveButton = wrapper.querySelector<HTMLButtonElement>("[data-action='save']");
  const status = wrapper.querySelector<HTMLElement>(".status");

  if (!documentId || initialContent === undefined || !container) {
    throw new Error("Missing editor data attributes");
  }

  const editor = createCodeMirrorEditor({
    container,
    initialContent,
  });

  function showStatus(message: string, isError = false) {
    if (!status) return;
    status.textContent = message;
    status.className = `status ${isError ? "status-error" : "status-success"}`;
    window.setTimeout(() => {
      status.textContent = "";
      status.className = "status";
    }, 4000);
  }

  saveButton?.addEventListener("click", async () => {
    try {
      const response = await fetch("/api/editor/document", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: documentId, content: editor.getContent() }),
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || "Error al guardar");
      }

      showStatus("Guardado correctamente");
    } catch (error) {
      showStatus(error instanceof Error ? error.message : "Error al guardar", true);
    }
  });

  window.addEventListener("beforeunload", () => {
    editor.destroy();
  });
</script>

<style>
  .editor-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 60vh;
  }

  .editor-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--grid-line);
  }

  .save-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1px solid var(--grid-line-strong);
    background: var(--text);
    color: var(--bg);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .save-button:hover {
    opacity: 0.9;
  }

  .status {
    min-height: 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .status-success {
    color: #15803d;
  }

  .status-error {
    color: #b91c1c;
  }

  .editor-container {
    flex: 1;
    width: 100%;
    min-height: 60vh;
    border: 1px solid var(--grid-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .editor-container :global(.cm-editor) {
    width: 100%;
    height: 100%;
    min-height: 60vh;
  }

  .editor-container :global(.cm-focused) {
    outline: none;
  }
</style>
