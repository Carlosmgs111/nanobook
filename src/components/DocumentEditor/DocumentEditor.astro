---
import type { Document } from "../../core/content/types";

interface Props {
  document: Document;
  previewHref?: string;
}

const { document, previewHref } = Astro.props;
const initialContent = document.rawFrontmatter + document.content;
---

<div
  class="editor-wrapper"
  data-document={JSON.stringify(document)}
  data-document-id={document.id}
  data-initial-content={initialContent}
>
  <div class="editor-toolbar">
    <button type="button" class="save-button" data-action="save">Guardar</button
    >
    <a class="preview-link" href={previewHref}>Preview</a>
    <span class="status" role="status" aria-live="polite"></span>
  </div>
  <div class="editor-container" data-editor-container></div>
</div>

<script>
  import type { Document } from "../../core/content/types";
  import {
    createCodeMirrorEditor,
    type CodeMirrorEditorInstance,
  } from "./code-mirror-editor";
  import { debounce } from "../../core/utils/debounce";
  import { worker } from "../../workers";
  import { parse } from "yaml";

  let editor: CodeMirrorEditorInstance | null = null;
  let statusElement: HTMLElement | null = null;

  const channel = new BroadcastChannel("rendered-document");

  function getWrapper() {
    return document.querySelector<HTMLElement>(".editor-wrapper");
  }

  function getStagedDocument() {
    const raw = sessionStorage.getItem("stagedDocument");
    return raw ? (JSON.parse(raw) as Document) : null;
  }

  function getInitialContent(wrapper: HTMLElement) {
    const staged = getStagedDocument();
    return staged
      ? staged.rawFrontmatter + staged.content
      : wrapper.dataset.initialContent || "";
  }

  function ensureSessionState(baseDocument: Document) {
    if (!sessionStorage.getItem("renderedStagedDocument")) {
      updateRenderedDocument(baseDocument);
    }
    if (!sessionStorage.getItem("stagedDocument")) {
      sessionStorage.setItem("stagedDocument", JSON.stringify(baseDocument));
    }
  }

  function initEditor() {
    const wrapper = getWrapper();
    if (!wrapper) return;

    const documentId = wrapper.dataset.documentId;
    const container = wrapper.querySelector<HTMLElement>(
      "[data-editor-container]"
    );
    statusElement = wrapper.querySelector<HTMLElement>(".status");

    if (!documentId || !container) {
      throw new Error("Missing editor data attributes");
    }

    destroyEditor();

    const baseDocument = JSON.parse(wrapper.dataset.document!) as Document;
    ensureSessionState(baseDocument);

    editor = createCodeMirrorEditor({
      container,
      initialContent: getInitialContent(wrapper),
      onChange: debouncedOnChange,
    });

    setupSaveButton(wrapper, documentId);
  }

  function setupSaveButton(wrapper: HTMLElement, documentId: string) {
    const saveButton = wrapper.querySelector<HTMLButtonElement>(
      "[data-action='save']"
    );
    if (!saveButton) return;

    const cleanButton = saveButton.cloneNode(true) as HTMLButtonElement;
    saveButton.replaceWith(cleanButton);

    cleanButton.addEventListener("click", async () => {
      try {
        const document = updateDocument(
          JSON.parse(wrapper.dataset.document!) as Document
        );
        const response = await fetch("/api/" + documentId, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(document),
        });

        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.error || "Error al guardar");
        }

        showStatus("Guardado correctamente");
      } catch (error) {
        console.error(error);
        showStatus(
          error instanceof Error ? error.message : "Error al guardar",
          true
        );
      }
    });
  }

  function destroyEditor() {
    if (editor) {
      editor.destroy();
      editor = null;
    }
  }

  async function updateRenderedDocument(stagedDocument: Document) {
    const result = await worker.render(stagedDocument);
    console.log(result);
    sessionStorage.setItem("renderedStagedDocument", JSON.stringify(result));
    channel.postMessage("");
  }

  const debouncedOnChange = debounce(async () => {
    const wrapper = getWrapper();
    if (!wrapper || !editor) return;
    const stagedDocument = updateDocument(
      JSON.parse(wrapper.dataset.document!) as Document
    );
    sessionStorage.setItem("stagedDocument", JSON.stringify(stagedDocument));
    updateRenderedDocument(stagedDocument);
  }, 1000);

  function updateDocument(oldDocument: Document): Document {
    if (!editor) return oldDocument;
    const fullContent = editor.getContent();
    const rawFrontmatter = fullContent.match(/^---[\s\S]*?---\n?/)?.[0]!;
    const data = parse(rawFrontmatter.replaceAll("---", "")!);
    const content = fullContent.replace(/^---[\s\S]*?---\n?/g, "");
    return {
      ...oldDocument,
      metadata: data,
      content,
      rawFrontmatter,
    };
  }

  function showStatus(message: string, isError = false) {
    if (!statusElement) return;
    statusElement.textContent = message;
    statusElement.className = `status ${isError ? "status-error" : "status-success"}`;
    window.setTimeout(() => {
      if (!statusElement) return;
      statusElement.textContent = "";
      statusElement.className = "status";
    }, 4000);
  }

  document.addEventListener("astro:page-load", initEditor);
  document.addEventListener("astro:before-swap", destroyEditor);
</script>

<style>
  .editor-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 60vh;
  }

  .editor-toolbar {
    display: flex;
    align-items: center;
    /* justify-content: space-between; */
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--grid-line);
  }

  .save-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--grid-line-strong);
    background: var(--text);
    color: var(--bg);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .save-button:hover {
    opacity: 0.9;
  }

  .preview-link {
    color: var(--text);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid var(--text);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .preview-link:hover {
    opacity: 0.9;
  }

  .status {
    min-height: 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .status-success {
    color: #15803d;
  }

  .status-error {
    color: #b91c1c;
  }

  .editor-container {
    flex: 1;
    width: 100%;
    min-height: 60vh;
    border: 1px solid var(--grid-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .editor-container :global(.cm-editor) {
    width: 100%;
    height: 100%;
    min-height: 60vh;
  }

  .editor-container :global(.cm-focused) {
    outline: none;
  }
</style>
