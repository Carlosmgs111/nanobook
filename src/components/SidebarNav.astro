---
import FileSVG from "../icons/file.svg";
import FolderSVG from "../icons/folder.svg";
import FolderUpSVG from "../icons/folder-up.svg";
import HomeSVG from "../icons/home.svg";
import MenuSVG from "../icons/menu.svg";
import CloseSVG from "../icons/x.svg";

interface Entry {
  id: string;
  data: {
    title: string;
    description: string;
    draft: boolean;
    index: boolean;
  };
  current?: boolean;
}

interface ParentEntry {
  id: string;
  data: {
    title: string;
  };
}

interface Props {
  entries: Entry[];
  parentEntry?: ParentEntry | null;
}

const { entries, parentEntry } = Astro.props;

function parentHref(parent: ParentEntry): string {
  return parent.id === "index" ? "/" : `/${parent.id}/`;
}

const sortedEntries = entries
  .filter((page) => !page.data.draft)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

function linkClasses(current?: boolean): string {
  const base = "group flex items-center gap-3 border-l-2 px-3 py-2 text-sm";
  const active = "border-[var(--accent)] bg-white/5 text-[var(--text)]";
  const inactive =
    "border-transparent text-[var(--muted)] hover:border-[var(--grid-line-strong)] hover:bg-white/5 hover:text-[var(--text)]";
  return current ? `${base} ${active}` : `${base} ${inactive}`;
}
---

<!-- Mobile toggle -->
<button
  id="sidebar-toggle"
  type="button"
  class="fixed bottom-6 left-6 z-50 flex h-12 w-12 items-center justify-center border border-[var(--grid-line-strong)] bg-[var(--bg)] text-[var(--text)] shadow-lg hover:border-[var(--accent)] md:hidden"
  aria-label="Abrir navegación"
  aria-expanded="false"
  aria-controls="sidebar"
>
  <MenuSVG />
</button>

<!-- Mobile overlay -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-40 hidden bg-black/60 backdrop-blur-sm md:hidden"
  aria-hidden="true"
>
</div>

<!-- Sidebar -->
<aside
  id="sidebar"
  class="sticky flex-shrink-0 max-w-64 inset-y-0 left-0 z-40 hidden -translate-x-full border-r border-[var(--grid-line-strong)] bg-[var(--bg)] p-6 md:sticky md:top-32 md:block md:h-[calc(100vh-9rem)] md:max-h-[calc(100vh-9rem)] md:w-full md:translate-x-0 md:overflow-y-auto md:border md:border-[var(--grid-line-strong)] md:bg-[var(--layer-1)] md:p-4"
>
  <div
    class="mb-6 flex items-end justify-between md:block border-b border-[var(--grid-line-strong)] pb-2"
  >
    {
      parentEntry && (
        <a
          href={parentHref(parentEntry)}
          class="group flex items-center gap-2 text-sm text-[var(--muted)] hover:text-[var(--accent)]"
        >
          <i class="w-5">
            {parentEntry.id === "index" ? <HomeSVG /> : <FolderUpSVG />}
          </i>
          <span class="truncate">{parentEntry.data.title}</span>
        </a>
      )
    }
    <button
      id="sidebar-close"
      type="button"
      class="font-mono text-xs text-[var(--muted)] hover:text-[var(--accent)] md:hidden w-10 aspect-square border border-[var(--grid-line-strong)]"
      aria-label="Cerrar navegación"
    >
      <CloseSVG />
    </button>
  </div>

  <ul class="space-y-2">
    {
      sortedEntries.map((page) => (
        <li>
          <a
            href={`/${page.id}/`}
            class={linkClasses(page.current)}
            aria-current={page.current ? "page" : undefined}
          >
            {page.data.index ? <FolderSVG /> : <FileSVG />}
            <span class="truncate">{page.data.title}</span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    sortedEntries.length === 0 && (
      <p class="text-sm text-[var(--muted)]">
        No hay elementos en esta sección.
      </p>
    )
  }
</aside>

<script is:inline>
  (function () {
    const toggle = document.getElementById("sidebar-toggle");
    const close = document.getElementById("sidebar-close");
    const sidebar = document.getElementById("sidebar");
    const backdrop = document.getElementById("sidebar-backdrop");

    if (!toggle || !close || !sidebar || !backdrop) return;

    function open() {
      sidebar.classList.remove("hidden", "-translate-x-full");
      sidebar.classList.add("translate-x-0");
      backdrop.classList.remove("hidden");
      toggle.setAttribute("aria-expanded", "true");
      backdrop.setAttribute("aria-hidden", "false");
    }

    function closeSidebar() {
      sidebar.classList.add("hidden", "-translate-x-full");
      sidebar.classList.remove("translate-x-0");
      backdrop.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
      backdrop.setAttribute("aria-hidden", "true");
    }

    toggle.addEventListener("click", open);
    close.addEventListener("click", closeSidebar);
    backdrop.addEventListener("click", closeSidebar);

    sidebar.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", closeSidebar);
    });
  })();
</script>
