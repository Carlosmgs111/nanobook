---
import FileSVG from "../icons/file.svg";
import FolderSVG from "../icons/folder.svg";
import MenuSVG from "../icons/menu.svg";

interface Entry {
  id: string;
  data: {
    title: string;
    description: string;
    draft: boolean;
    index: boolean;
  };
  current?: boolean;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;

const sortedEntries = entries
  .filter((page) => !page.data.draft)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

function linkClasses(current?: boolean): string {
  const base =
    "group flex items-center gap-3 border-l-2 px-3 py-2 text-sm transition-colors";
  const active = "border-[var(--accent)] bg-white/5 text-[var(--text)]";
  const inactive =
    "border-transparent text-[var(--muted)] hover:border-[var(--grid-line-strong)] hover:bg-white/5 hover:text-[var(--text)]";
  return current ? `${base} ${active}` : `${base} ${inactive}`;
}
---

<aside class="sidebar-nav hidden md:block">
  <div
    class="sticky top-[theme(spacing.32)] max-h-[calc(100vh-9rem)] overflow-y-auto border border-[var(--grid-line-strong)] bg-[var(--layer-1)] p-4"
  >
    <span class="tech-label mb-4 block">En esta sección</span>
    <ul class="space-y-2">
      {
        sortedEntries.map((page) => (
          <li>
            <a
              href={`/${page.id}/`}
              class={linkClasses(page.current)}
              aria-current={page.current ? "page" : undefined}
            >
              {page.data.index ? <FolderSVG /> : <FileSVG />}
              <span class="truncate">{page.data.title}</span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      sortedEntries.length === 0 && (
        <p class="text-sm text-[var(--muted)]">
          No hay elementos en esta sección.
        </p>
      )
    }
  </div>
</aside>

<!-- Mobile toggle -->
<div class="fixed bottom-6 right-6 z-40 md:hidden">
  <button
    id="sidebar-toggle"
    type="button"
    class="flex h-12 w-12 items-center justify-center border border-[var(--grid-line-strong)] bg-[var(--bg)] text-[var(--text)] shadow-lg transition-colors hover:border-[var(--accent)]"
    aria-label="Abrir navegación"
    aria-expanded="false"
    aria-controls="sidebar-overlay"
  >
    <MenuSVG />
  </button>
</div>

<!-- Mobile overlay -->
<div
  id="sidebar-overlay"
  class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm md:hidden"
  aria-hidden="true"
>
  <div
    class="absolute right-0 top-0 h-full w-72 border-l border-[var(--grid-line-strong)] bg-[var(--bg)] p-6 shadow-xl"
  >
    <div class="mb-6 flex items-center justify-between">
      <span class="tech-label">En esta sección</span>
      <button
        id="sidebar-close"
        type="button"
        class="font-mono text-xs text-[var(--muted)] transition-colors hover:text-[var(--accent)]"
        aria-label="Cerrar navegación"
      >
        Cerrar
      </button>
    </div>
    <ul class="space-y-2">
      {
        sortedEntries.map((page) => (
          <li>
            <a
              href={`/${page.id}/`}
              class={linkClasses(page.current)}
              aria-current={page.current ? "page" : undefined}
            >
              {page.data.index ? <FolderSVG /> : <FileSVG />}
              <span class="truncate">{page.data.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script is:inline>
  (function () {
    const toggle = document.getElementById("sidebar-toggle");
    const overlay = document.getElementById("sidebar-overlay");
    const close = document.getElementById("sidebar-close");

    function open() {
      overlay.classList.remove("hidden");
      toggle.setAttribute("aria-expanded", "true");
      overlay.setAttribute("aria-hidden", "false");
    }

    function closeSidebar() {
      overlay.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
      overlay.setAttribute("aria-hidden", "true");
    }

    if (toggle && overlay) {
      toggle.addEventListener("click", open);
      close.addEventListener("click", closeSidebar);
      overlay.addEventListener("click", function (event) {
        if (event.target === overlay) closeSidebar();
      });
    }
  })();
</script>
