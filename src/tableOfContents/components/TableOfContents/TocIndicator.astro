---
interface Heading {
  slug: string;
}

interface Props {
  headings: Heading[];
  tocRootId: string;
}

const { headings, tocRootId } = Astro.props;
const indicatorId = `${tocRootId}-indicator`;
---

<div id={indicatorId} class="toc-indicator" aria-hidden="true">
  {
    headings.map((heading) => (
      <div class="toc-indicator-line" data-slug={heading.slug} />
    ))
  }
</div>

<script define:vars={{ indicatorId, tocRootId }} type="module">
  let abortController = null;

  document.addEventListener("astro:page-load", function () {
    const tocIndicator = document.getElementById(indicatorId);
    const root = document.getElementById(tocRootId);
    if (!tocIndicator || !root) return;

    if (abortController) abortController.abort();
    abortController = new AbortController();
    const { signal } = abortController;

    const tocLines = tocIndicator.querySelectorAll(".toc-indicator-line");

    function positionIndicatorLines(lines, offsets) {
      const total = document.documentElement.scrollHeight - window.innerHeight;
      lines.forEach((line, i) => {
        const percent =
          total > 0 ? (offsets[i] / total) * 100 : i === 0 ? 0 : 100;
        line.style.top = `${Math.min(100, Math.max(0, percent))}%`;
      });
    }

    function initIndicatorLines(lines, headings) {
      if (headings.length === 0) return;

      function measure() {
        const offsets = headings.map((heading) => heading.element.offsetTop);
        positionIndicatorLines(lines, offsets);
      }

      window.addEventListener("resize", measure, { signal });
      window.addEventListener("orientationchange", measure, { signal });

      measure();
    }

    function updateActiveLine(activeId) {
      tocLines.forEach((line) => {
        line.dataset.isActive = String(line.dataset.slug === activeId);
      });
    }

    // Aplicar estado actual si ya existe (por si TocNav se inicializó primero).
    if (root._tocHeadings) {
      initIndicatorLines(tocLines, root._tocHeadings);
    }
    if (root._tocActiveId) {
      updateActiveLine(root._tocActiveId);
    }

    // Escuchar futuras actualizaciones.
    root.addEventListener("toc:headings", (e) => {
      initIndicatorLines(tocLines, e.detail.headings);
    });
    root.addEventListener("toc:active", (e) => {
      updateActiveLine(e.detail.activeId);
    });
  });
</script>

<style>
  .toc-indicator {
    position: relative;
    height: 100%;
    width: 18px;
    border: 1px solid var(--grid-line-strong);
  }

  :global(#toc-root[data-toc-mode="standard"]) .toc-indicator {
    display: none;
  }

  .toc-indicator-line {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 2px;
    background: var(--muted);
    transition:
      width 0.15s,
      background 0.15s;
  }

  .toc-indicator-line[data-is-active="true"] {
    width: 24px;
    background: var(--accent);
  }
</style>
