---
import ComponentBlockHost from "./generated/ComponentBlockHost.astro";
import { resolveRenderedPieces } from "./renderedDocumentPieces";

interface Props {
  /** HTML renderizado del documento, con los marcadores de bloque de raíz. */
  html: string;
}

// Los segmentos de HTML se inyectan tal cual y los bloques se pintan con Astro
// (solo servidor o isla), en el orden del documento. Los que no puedan pintarse
// conservan su punto de montaje original.
const pieces = resolveRenderedPieces(Astro.props.html);
---

{
  pieces.map((piece) =>
    piece.kind === "island" ? (
      <ComponentBlockHost name={piece.name} props={piece.props} />
    ) : (
      <Fragment set:html={piece.html} />
    )
  )
}
