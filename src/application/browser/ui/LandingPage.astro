---
import LandingLayout from "../../../layouts/LandingLayout.astro";
import type { PublicNanobook } from "../../../nanobooks/server/application/ListPublicNanobooks";

interface Props {
  signedIn: boolean;
  nanobooks: PublicNanobook[];
  catalogUnavailable?: boolean;
}
const { signedIn, nanobooks, catalogUnavailable = false } = Astro.props;
const signupHref = "/login?mode=signup";
const loginHref = "/login";
---

<LandingLayout>
  <div class="landing">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="masthead page-width">
      <a class="wordmark" href="/" aria-label="Nanobook, inicio">
        <svg
          width="24"
          height="27"
          viewBox="0 0 24 27"
          fill="none"
          aria-hidden="true"
          ><path
            d="M4 2h16v23H4a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3Z"
            stroke="currentColor"
            stroke-width="1.5"></path><path
            d="M5 2v18m-4 2c0-1.7 1.3-3 3-3h16M9 7h7M9 11h5"
            stroke="currentColor"
            stroke-width="1.5"></path></svg
        >
        nanobook
      </a>
      <nav aria-label="Navegación principal">
        <a class="explore-link" href="#nanobooks-publicos">Explorar</a>
        <a class="nav-account" href={signedIn ? "/nanobooks" : loginHref}
          >{signedIn ? "Mis nanobooks" : "Iniciar sesión"}</a
        >
      </nav>
    </header>

    <main id="contenido">
      <section class="hero page-width" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">
            Tus ideas,<br />organizadas<br />para compartir.
          </h1>
          <p>
            Un nanobook es un espacio para escribir y conectar tus documentos.
            Dale forma a lo que sabes y decide qué compartir con los demás.
          </p>
          <div class="hero-actions">
            <a
              class="button primary"
              href={signedIn ? "/nanobooks" : signupHref}
              >{signedIn ? "Mis nanobooks" : "Crear cuenta"}</a
            >
            <a
              class="text-link"
              href={signedIn ? "#nanobooks-publicos" : loginHref}
              >{signedIn ? "Explorar nanobooks" : "Iniciar sesión"}</a
            >
          </div>
          <p class="hero-note">
            Lee los nanobooks públicos sin necesidad de una cuenta.
          </p>
        </div>
        <div class="book-scene" aria-hidden="true">
          <div class="book-back"></div>
          <div class="book-cover">
            <span class="book-brand">nanobook</span>
            <div class="book-title">Una idea.<br />Su propio<br />espacio.</div>
            <div class="book-lines">
              <span></span><span></span><span></span>
            </div>
            <span class="book-foot">Escribe. Organiza. Comparte.</span>
          </div>
        </div>
      </section>

      <section
        id="nanobooks-publicos"
        class="catalog"
        aria-labelledby="catalog-title"
      >
        <div class="page-width">
          <div class="catalog-heading">
            <div>
              <h2 id="catalog-title">Conocimiento abierto.</h2>
              <p>Explora los nanobooks que la comunidad ha hecho públicos.</p>
            </div>
            {
              !catalogUnavailable && (
                <span class="catalog-count">
                  {nanobooks.length}{" "}
                  {nanobooks.length === 1
                    ? "nanobook público"
                    : "nanobooks públicos"}
                </span>
              )
            }
          </div>
          {
            catalogUnavailable ? (
              <div class="catalog-state" role="status">
                <h3>No pudimos cargar los nanobooks.</h3>
                <p>Inténtalo de nuevo en unos momentos.</p>
                <a class="text-link" href="/" data-astro-reload>
                  Volver a intentar
                </a>
              </div>
            ) : nanobooks.length === 0 ? (
              <div class="catalog-state">
                <h3>El primer nanobook público puede ser el tuyo.</h3>
                <p>
                  Crea un espacio para tus ideas y elige hacerlo público cuando
                  esté listo.
                </p>
                <a
                  class="text-link"
                  href={signedIn ? "/nanobooks" : signupHref}
                >
                  {signedIn ? "Crear un nanobook" : "Crear cuenta"}
                </a>
              </div>
            ) : (
              <ul class="book-grid" role="list">
                {nanobooks.map((book) => (
                  <li>
                    <a class="catalog-book" href={`/n/${book.slug}`}>
                      <div class="catalog-cover">
                        <span class="cover-brand" aria-hidden="true">
                          nanobook
                        </span>
                        <h3>{book.name}</h3>
                        <span class="cover-spine" aria-hidden="true" />
                      </div>
                      <div class="catalog-book-caption">
                        <span>/{book.slug}</span>
                        <span class="read-label">Leer nanobook</span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </section>
    </main>
    <footer class="page-width footer">
      <a class="wordmark" href="/">nanobook</a><p>
        Un lugar para lo que sabes. Y lo que estás por descubrir.
      </p>
    </footer>
  </div>
</LandingLayout>

<style>
  .landing {
    --secondary: color-mix(in srgb, var(--theme-text) 72%, var(--theme-page-bg));
    font-family: var(--theme-font-body);
    color: var(--theme-text);
    background: var(--theme-page-bg);
  }
  .page-width {
    width: min(1200px, calc(100% - 96px));
    margin-inline: auto;
  }
  a {
    text-decoration: none;
  }
  a:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: 6px;
  }
  .skip-link {
    position: fixed;
    top: -100px;
    left: 20px;
    padding: 12px;
    background: var(--theme-accent);
    color: var(--theme-accent-text);
    z-index: 20;
  }
  .skip-link:focus {
    top: 12px;
  }
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 104px;
    gap: 24px;
    border-bottom: 1px solid var(--theme-border);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -1.1px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 34px;
    font-size: 14px;
  }
  .nav-account {
    border: 1px solid var(--border-medium);
    padding: 11px 18px;
    border-radius: var(--theme-control-radius);
  }
  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 64px;
    align-items: center;
    padding-block: 94px 106px;
  }
  h1 {
    font-size: clamp(48px, 5.6vw, 78px);
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.065em;
    margin: 0 0 30px;
  }
  .hero-copy > p {
    color: var(--secondary);
    font-size: 18px;
    line-height: 1.7;
    max-width: 440px;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  .button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 15px 24px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 5px;
    min-height: 48px;
  }
  .primary {
    background: var(--theme-accent);
    color: var(--theme-accent-text);
  }
  .primary:hover {
    opacity: 0.85;
  }
  .text-link {
    font-size: 15px;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .hero-copy .hero-note {
    font-size: 12px;
    margin-top: 22px;
  }
  .book-scene {
    position: relative;
    width: min(320px, 100%);
    aspect-ratio: 0.75;
    justify-self: center;
    margin-right: 16px;
  }
  .book-back {
    position: absolute;
    inset: 12px -15px -10px 13px;
    background: var(--layer-3);
    border: 1px solid var(--border-medium);
    border-radius: var(--theme-cover-radius);
    transform: rotate(7deg);
  }
  .book-cover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 32px 30px 28px 38px;
    border: 1px solid var(--border-medium);
    border-radius: var(--theme-cover-radius);
    background: var(--theme-surface-bg);
    box-shadow: var(--theme-decoration-shadow);
    transform: rotate(-5deg);
  }
  .book-cover::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 var(--theme-cover-spine-width);
    border-right: 1px solid var(--border-medium);
  }
  .book-brand {
    font-size: 13px;
    font-weight: 600;
  }
  .book-title {
    font-size: clamp(27px, 3.3vw, 43px);
    line-height: 1.12;
    letter-spacing: -0.04em;
    margin-top: auto;
  }
  .book-lines {
    display: flex;
    gap: 9px;
    height: 44px;
    margin-top: 26px;
  }
  .book-lines span {
    display: block;
    width: 1px;
    height: 100%;
    background: var(--border-strong);
    transform: rotate(30deg);
  }
  .book-foot {
    margin-top: auto;
    padding-top: 24px;
    font-size: 10px;
    color: var(--secondary);
  }
  .catalog {
    border-top: 1px solid var(--theme-border);
    background: var(--layer-1);
    padding-block: 62px 80px;
    scroll-margin-top: 24px;
  }
  .catalog-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 38px;
  }
  h2 {
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.2;
  }
  .catalog-heading p {
    color: var(--secondary);
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.6;
  }
  .catalog-count {
    font-size: 12px;
    color: var(--secondary);
    white-space: nowrap;
    padding-bottom: 4px;
  }
  .book-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .catalog-book {
    display: block;
    height: 100%;
  }
  .catalog-cover {
    min-height: 230px;
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 26px 28px 30px 38px;
    border: 1px solid var(--border-medium);
    background: var(--theme-page-bg);
    border-radius: var(--theme-cover-radius);
  }
  .cover-spine {
    position: absolute;
    inset: 0 auto 0 var(--theme-cover-spine-width);
    border-right: 1px solid var(--theme-border);
  }
  .cover-brand {
    color: var(--secondary);
    font-size: 11px;
  }
  .catalog-cover h3 {
    font-size: 28px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.035em;
    margin-top: auto;
    padding-top: 40px;
    overflow-wrap: anywhere;
  }
  .catalog-book:hover .catalog-cover {
    border-color: var(--theme-accent);
  }
  .catalog-book-caption {
    display: flex;
    gap: 16px;
    justify-content: space-between;
    padding-top: 16px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--secondary);
  }
  .catalog-book-caption > span:first-child {
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .read-label {
    color: var(--theme-text);
    white-space: nowrap;
  }
  .catalog-state {
    padding: 36px 0;
    max-width: 600px;
  }
  .catalog-state h3 {
    font-size: 22px;
    line-height: 1.4;
  }
  .catalog-state p {
    color: var(--secondary);
    margin-block: 12px 24px;
    line-height: 1.6;
  }
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 32px;
  }
  .footer .wordmark {
    font-size: 20px;
  }
  .footer p {
    color: var(--secondary);
    font-size: 12px;
    line-height: 1.6;
  }
  @media (max-width: 900px) {
    .page-width {
      width: calc(100% - 48px);
    }
    .hero {
      gap: 36px;
      padding-block: 70px;
    }
    .book-scene {
      width: 240px;
    }
    .book-cover {
      padding: 24px 22px 22px 30px;
    }
    .book-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .page-width {
      width: calc(100% - 40px);
    }
    .masthead {
      min-height: 82px;
      gap: 16px;
    }
    .wordmark {
      font-size: 22px;
      gap: 8px;
    }
    .explore-link {
      display: none;
    }
    .nav-account {
      padding: 10px 12px;
      font-size: 12px;
    }
    .hero {
      grid-template-columns: 1fr;
      gap: 52px;
      padding-block: 52px 60px;
    }
    h1 {
      font-size: clamp(43px, 9.8vw, 62px);
    }
    .hero-copy > p {
      font-size: 16px;
    }
    .book-scene {
      width: 210px;
    }
    .book-title {
      font-size: 30px;
    }
    .book-lines {
      height: 25px;
      margin-top: 16px;
    }
    .book-foot {
      font-size: 9px;
      padding-top: 18px;
    }
    .catalog {
      padding-block: 42px 54px;
    }
    .catalog-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
    .book-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .catalog-cover {
      min-height: 210px;
    }
    .footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>
