---
import ColorModeToggle from "../../theme/browser/components/ColorModeToggle.astro";
import ContentWidthToggle from "./ContentWidthToggle.astro";

interface Props {
  editHref?: string;
  viewHref?: string;
  newHref?: string;
}

const { editHref, viewHref, newHref } = Astro.props;
---

{
  newHref && (
    <a
      href={newHref}
      data-auth-document-mutation
      hidden
      class="inline-flex items-center justify-center border border-[var(--theme-border)] px-3 py-1.5 text-sm font-medium hover:bg-[var(--theme-border-subtle)] transition-colors"
    >
      Nuevo
    </a>
  )
}
{
  editHref && (
    <a
      href={editHref}
      data-auth-document-mutation
      hidden
      class="inline-flex items-center justify-center border border-[var(--theme-border)] px-3 py-1.5 text-sm font-medium hover:bg-[var(--theme-border-subtle)] transition-colors"
    >
      Editar
    </a>
  )
}
{
  viewHref && (
    <a
      href={viewHref}
      class="inline-flex items-center justify-center border border-[var(--theme-border)] px-3 py-1.5 text-sm font-medium hover:bg-[var(--theme-border-subtle)] transition-colors"
    >
      Ver
    </a>
  )
}
<ContentWidthToggle />
<ColorModeToggle />
