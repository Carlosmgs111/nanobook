---
import StateRestoreScripts from "./StateRestoreScripts.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SidebarNav from "../../navigation/components/SidebarNav/index.astro";
import TableOfContents from "../../document/components/TableOfContents/index.astro";
import type { NavigationNode } from "../../navigation/domain/types";
import type { Crumb } from "../../navigation/components/Breadcrumb.astro";

interface ParentEntry {
  id: string;
  data: {
    title: string;
  };
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: Crumb[];
  sidebarEntries?: NavigationNode[];
  parentEntry?: ParentEntry | null;
  headings?: Heading[];
  hideToc?: boolean;
  editHref?: string;
  viewHref?: string;
  newHref?: string;
}

const {
  description,
  breadcrumbs,
  sidebarEntries,
  parentEntry,
  headings,
  hideToc = false,
  editHref,
  viewHref,
  newHref,
} = Astro.props;
---

<body
  class="relative min-h-screen overflow-x-hidden bg-[var(--bg)] text-[var(--text)]"
>
  <div class="grid-overlay" aria-hidden="true"></div>
  <div
    class="fixed top-0 left-0 right-0 h-px bg-[var(--grid-line-strong)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="fixed bottom-0 left-0 right-0 h-px bg-[var(--grid-line-strong)]"
    aria-hidden="true"
  >
  </div>
  <Header
    breadcrumbs={breadcrumbs}
    editHref={editHref}
    viewHref={viewHref}
    newHref={newHref}
  />
  <div
    id="content-wrapper"
    class="content-wrapper z-10 mx-auto flex gap-6 md:px-6 md:py-12"
    data-content-mode="constrained"
  >
    <SidebarNav entries={sidebarEntries} parentEntry={parentEntry} />
    <main
      class="border-x border-[var(--grid-line)] md:px-6 flex-1 min-w-0 overflow-x-hidden md:overflow-x-visible"
    >
      <div class="glass-panel corner-plus">
        <div class="prose max-w-none">
          <slot />
        </div>
      </div>
    </main>
    <TableOfContents headings={headings} hide={hideToc} />
  </div>
  <Footer />

  <script type="module">
    document.addEventListener("astro:page-load", function () {
      const wrapper = document.getElementById("content-wrapper");
      const headerInner = document.getElementById("header-inner");
      if (!wrapper || !headerInner) return;

      wrapper.addEventListener("content:mode", function (event) {
        headerInner.setAttribute("data-content-mode", event.detail.mode);
      });
    });
  </script>
</body>

<StateRestoreScripts />

<style>
  :root {
    --content-width-min: 1280px;
  }
  .content-wrapper {
    max-width: 72rem;
  }
.content-wrapper[data-content-mode="full"] {
    max-width: none;
  }
</style>
