---
import StateRestoreScripts from "./StateRestoreScripts.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SidebarNav from "../../navigation/browser/ui/components/SidebarNav/index.astro";
import TableOfContents from "../../documents/browser/ui/components/TableOfContents/index.astro";
import ToastHost from "../../toast/browser/ToastHost.astro";
import type { NavigationService } from "../../navigation/server";
import type { NavigationContext } from "../../navigation/browser/ui/NavigationContext";
import SignOutController from "../../profiles/browser/SignOutController.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  headings?: Heading[];
  hideToc?: boolean;
  loginHref?: string;
  navigationService?: NavigationService;
  navigationContext: NavigationContext;
  userName?: string;
  signedIn: boolean;
}

const {
  headings,
  hideToc = false,
  loginHref,
  navigationService,
  navigationContext,
  userName,
  signedIn,
} = Astro.props;
---

<body
  class="relative min-h-screen overflow-x-hidden bg-[var(--theme-page-bg)] text-[var(--theme-text)]"
>
  <div class="grid-overlay" aria-hidden="true"></div>
  <div
    class="fixed top-0 left-0 right-0 h-px bg-[var(--theme-border)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="fixed bottom-0 left-0 right-0 h-px bg-[var(--theme-border)]"
    aria-hidden="true"
  >
  </div>
  <Header
    loginHref={loginHref}
    navigationService={navigationService}
    navigationContext={navigationContext}
    userName={userName}
    signedIn={signedIn}
  />
  <div
    id="content-wrapper"
    class="content-wrapper z-10 mx-auto flex gap-6 md:px-6 md:py-12"
    data-content-mode="constrained"
  >
    <SidebarNav navigationService={navigationService} book={navigationContext.book} />
    <main
      class="border-x border-[var(--theme-border-subtle)] md:px-6 flex-1 min-w-0 overflow-x-hidden md:overflow-x-visible"
    >
      <div class="glass-panel corner-plus">
        <div class="prose max-w-none">
          <slot />
        </div>
      </div>
    </main>
    <TableOfContents headings={headings} hide={hideToc} />
  </div>
  <Footer />
  <ToastHost />
  <SignOutController />

  <script type="module">
    document.addEventListener("astro:page-load", function () {
      const wrapper = document.getElementById("content-wrapper");
      const headerInner = document.getElementById("header-inner");
      if (!wrapper || !headerInner) return;

      wrapper.addEventListener("content:mode", function (event) {
        headerInner.setAttribute("data-content-mode", event.detail.mode);
      });
    });
  </script>
</body>

<StateRestoreScripts />

<style>
  :root {
    --content-width-min: 1280px;
  }
  .content-wrapper {
    max-width: 72rem;
  }
  .content-wrapper[data-content-mode="full"] {
    max-width: none;
  }
</style>
