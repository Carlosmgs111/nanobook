<script is:inline>
  (function () {
    if (window.__nanobookColorModeMigrated) return;
    window.__nanobookColorModeMigrated = true;

    function migrateColorMode() {
      const stored =
        typeof localStorage !== "undefined"
          ? localStorage.getItem("theme")
          : null;
      if (stored === "light" || stored === "dark") {
        document.documentElement.dataset.colorMode = stored;
        document.cookie = `nanobook-color-mode=${stored}; Path=/; SameSite=Lax`;
      }
      if (typeof localStorage !== "undefined") localStorage.removeItem("theme");
    }

    migrateColorMode();
  })();
</script>

<script>
  import { ThemeNavigationController } from "../../theme/browser/ThemeNavigationController";
  const state = window as typeof window & { __nanobookThemeNavigation?: ThemeNavigationController };
  if (!state.__nanobookThemeNavigation) {
    state.__nanobookThemeNavigation = new ThemeNavigationController();
    document.addEventListener("astro:after-swap", () => state.__nanobookThemeNavigation?.syncFromDocument());
  }
  state.__nanobookThemeNavigation.syncFromDocument();
</script>

<script is:inline>
  (function () {
    if (window.__nanobookContentWidthRestored) return;
    window.__nanobookContentWidthRestored = true;

    function restoreContentWidth() {
      const saved =
        typeof localStorage !== "undefined"
          ? localStorage.getItem("content-width-mode")
          : null;
      if (saved !== "full" && saved !== "constrained") return;

      const headerInner = document.getElementById("header-inner");
      if (headerInner) {
        headerInner.setAttribute("data-content-mode", saved);
      }
    }

    restoreContentWidth();
    document.addEventListener("astro:after-swap", restoreContentWidth);
  })();
</script>
