---
import Breadcrumb from "../../navigation/components/Breadcrumb.astro";
import DocumentControls from "./DocumentControls.astro";
import OpenSidebar from "../../navigation/components/SidebarNav/OpenSidebar.astro";
import type { Crumb } from "../../navigation/components/Breadcrumb.astro";

interface Props {
  breadcrumbs?: Crumb[];
  editHref?: string;
  viewHref?: string;
  newHref?: string;
  loginHref?: string;
}

const { breadcrumbs, editHref, viewHref, newHref, loginHref } = Astro.props;
---

<header
  class="sticky top-0 z-50 border-b border-[var(--grid-line-strong)] bg-[var(--bg)]/90 backdrop-blur-sm"
  data-auth-header
>
  <div
    id="header-inner"
    class="header-inner mx-auto flex w-full items-center justify-between gap-4 px-6 py-5"
    data-content-mode="constrained"
  >
    <OpenSidebar
      sidebarId="sidebar"
      backdropId="sidebar-backdrop"
      buttonId="sidebar-open"
    />
    <div class="min-w-0 flex-1">
      <Breadcrumb crumbs={breadcrumbs} />
    </div>
    <div class="flex flex-shrink-0 items-center gap-2">
      <DocumentControls
        editHref={editHref}
        viewHref={viewHref}
        newHref={newHref}
      />
      <span class="auth-status" data-auth-status hidden role="status"></span>
      {
        loginHref && (
          <a
            href={loginHref}
            data-auth-login
            aria-label="Ingresar a tu cuenta"
            class="inline-flex items-center justify-center border border-[var(--grid-line-strong)] px-3 py-1.5 text-sm font-medium transition-colors hover:bg-[var(--grid-line)] focus:outline-none focus:ring-2 focus:ring-[var(--accent)]/50"
          >
            Ingresar
          </a>
        )
      }
    </div>
  </div>
</header>

<script>
  import { AuthStatusController } from "./AuthStatusController";
  import { authModule } from "../../auth/browser";

  const authStatusController = new AuthStatusController(
    authModule.getAuthenticatedSession
  );

  document.addEventListener("astro:page-load", () =>
    authStatusController.mount()
  );
  authStatusController.mount();
</script>

<style>
  .header-inner {
    max-width: 72rem;
  }
  .header-inner[data-content-mode="full"] {
    max-width: none;
  }
  .auth-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.5rem;
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .auth-status::before {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #5aa469;
    box-shadow: 0 0 0 3px color-mix(in srgb, #5aa469 20%, transparent);
    content: "";
  }
  @media (max-width: 1279px) {
    :global(#content-width-toggle) {
      display: none;
    }
  }
</style>
