---
import "../shared/styles/global.css";
import { ClientRouter } from "astro:transitions";
import StateRestoreScripts from "./components/StateRestoreScripts.astro";
import { getApp } from "../application/server/Application";
import { normalizeColorModePreference } from "../theme/server";

const app = await getApp();
const themeId = Astro.url.searchParams.get("theme") === "nanobook" ? "nanobook" : "monocromo";
const theme = await app.themeModule.resolveTheme.execute({ kind: "official", id: themeId });
const installation = app.themeModule.compileTheme.execute(theme);
const storedMode = Astro.cookies.get("nanobook-color-mode")?.value;
const colorModePreference = normalizeColorModePreference(storedMode);
---
<!doctype html>
<html lang="es" data-theme={theme.baseId} data-theme-key={theme.key} data-color-mode={colorModePreference}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Escribe, organiza y comparte tus ideas en Nanobook. Explora nanobooks públicos o crea tu propio espacio de conocimiento." />
    <title>Nanobook — Tus ideas, organizadas para compartir</title>
    <link rel="icon" href="/favicon.ico" />
    <ClientRouter transition:animate="none" />
    <style data-nanobook-theme is:inline set:html={installation.cssText}></style>
    <meta data-theme-state data-theme={theme.baseId} data-theme-key={theme.key} data-color-mode={colorModePreference} data-theme-variables={JSON.stringify(installation.variables)} />
  </head>
  <body>
    <StateRestoreScripts />
    <slot />
  </body>
</html>
