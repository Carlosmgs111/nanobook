---
import "../styles/global.css";
import Breadcrumb from "../components/Breadcrumb.astro";
import ContentWidthToggle from "../components/ContentWidthToggle.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import SidebarNav from "../components/SidebarNav/index.astro";
import TableOfContents from "../components/TableOfContents/index.astro";
import OpenSidebar from "../components/SidebarNav/OpenSidebar.astro";

interface Crumb {
  id: string;
  title: string;
  href: string;
  current: boolean;
}

interface SidebarEntry {
  id: string;
  data: {
    title: string;
    description: string;
    draft: boolean;
    index: boolean;
  };
  current?: boolean;
}

interface ParentEntry {
  id: string;
  data: {
    title: string;
  };
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  label?: string;
  breadcrumbs?: Crumb[];
  sidebarEntries?: SidebarEntry[];
  parentEntry?: ParentEntry | null;
  headings?: Heading[];
}

const {
  title = "Astro",
  description,
  label = "Document",
  breadcrumbs,
  sidebarEntries,
  parentEntry,
  headings,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        const stored =
          typeof localStorage !== "undefined"
            ? localStorage.getItem("theme")
            : null;
        const prefersLight =
          typeof window !== "undefined" &&
          window.matchMedia("(prefers-color-scheme: light)").matches;
        const isLight = stored ? stored === "light" : prefersLight;
        document.documentElement.classList.toggle("light", isLight);
      })();
    </script>
  </head>
  <body
    class="relative min-h-screen overflow-x-hidden bg-[var(--bg)] text-[var(--text)]"
  >
    <!-- Grid overlay -->
    <div class="grid-overlay" aria-hidden="true"></div>

    <!-- Top and bottom subtle rules -->
    <div
      class="fixed top-0 left-0 right-0 h-px bg-[var(--grid-line-strong)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="fixed bottom-0 left-0 right-0 h-px bg-[var(--grid-line-strong)]"
      aria-hidden="true"
    >
    </div>

    <!-- Header -->
    <header
      class="sticky top-0 z-40 border-b border-[var(--grid-line-strong)] bg-[var(--bg)]/90 backdrop-blur-sm"
    >
      <div
        id="header-inner"
        class="header-inner mx-auto flex items-center justify-between gap-4 px-6 py-5"
        data-content-mode="constrained"
      >
        <OpenSidebar
          sidebarId="sidebar"
          backdropId="sidebar-backdrop"
          buttonId="sidebar-open"
        />
        <div class="min-w-0 flex-1">
          <Breadcrumb crumbs={breadcrumbs} />
        </div>
        <div class="flex flex-shrink-0 items-center gap-2">
          <ContentWidthToggle />
          <ThemeToggle />
        </div>
      </div>
    </header>

    <script is:inline>
      (function () {
        const saved =
          typeof localStorage !== "undefined"
            ? localStorage.getItem("content-width-mode")
            : null;
        if (saved !== "full" && saved !== "constrained") return;

        const headerInner = document.getElementById("header-inner");
        if (headerInner) {
          headerInner.setAttribute("data-content-mode", saved);
        }
      })();
    </script>

    <script type="module">
      (function () {
        const wrapper = document.getElementById("content-wrapper");
        const headerInner = document.getElementById("header-inner");
        if (!wrapper || !headerInner) return;

        wrapper.addEventListener("content:mode", function (event) {
          headerInner.setAttribute("data-content-mode", event.detail.mode);
        });
      })();
    </script>

    <!-- Main content -->
    <div
      id="content-wrapper"
      class="content-wrapper z-10 mx-auto flex max-w-6xl gap-6 px-6 py-12"
      data-content-mode="constrained"
    >
      <SidebarNav entries={sidebarEntries} parentEntry={parentEntry} />
      <main class="border-x border-[var(--grid-line)] px-6 flex-1 min-w-0">
        <div class="glass-panel corner-plus">
          <div class="prose max-w-none">
            <slot />
          </div>
        </div>
      </main>
      <TableOfContents headings={headings} />
    </div>

    <!-- Footer -->
    <footer class="z-10 py-8 text-center">
      <div class="mx-auto max-w-4xl px-6">
        <div class="rule mb-4"></div>
        <p class="tech-label">Rendered with Astro + Tailwind</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --content-width-min: 1280px;
  }
  .content-wrapper {
    max-width: 72rem;
  }
  .content-wrapper[data-content-mode="full"] {
    max-width: none;
  }
  .header-inner {
    max-width: 72rem;
  }
  .header-inner[data-content-mode="full"] {
    max-width: none;
  }
  @media (max-width: 1279px) {
    :global(#content-width-toggle) {
      display: none;
    }
  }
</style>
