---
import "../shared/styles/global.css";
import { ClientRouter } from "astro:transitions";
import LayoutShell from "./components/LayoutShell.astro";
import type { NavigationService } from "../navigation/server";
import { getApp } from "../application/server/Application";
import type { NavigationContext } from "../navigation/browser/ui/NavigationContext";
import {
  normalizeColorModePreference,
  type AppliedTheme,
} from "../theme/server";
import type { AuthenticatedUser } from "../auth/browser/model/AuthSession";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  headings?: Heading[];
  hideToc?: boolean;
  loginHref?: string;
  canonicalHref?: string;
  navigationService?: NavigationService;
  theme?: AppliedTheme;
  navigationContext?: NavigationContext;
  session?: AuthenticatedUser | null;
}

const {
  title = "Astro",
  description,
  headings,
  hideToc = false,
  loginHref = "/login",
  canonicalHref,
  navigationService,
  theme: suppliedTheme,
  navigationContext = { section: "project" },
} = Astro.props;
const app = await getApp();
const hasSuppliedSession = Object.hasOwn(Astro.props, "session");
const session = hasSuppliedSession
  ? Astro.props.session ?? null
  : await app.authServerModule.getSession(Astro.request);
const theme =
  suppliedTheme ??
  (await app.themeModule.resolveTheme.execute({
    kind: "official",
    id: "monocromo",
  }));
const installation = app.themeModule.compileTheme.execute(theme);
const storedMode = Astro.cookies.get("nanobook-color-mode")?.value;
const colorModePreference = normalizeColorModePreference(storedMode);
---

<!doctype html>
<html
  lang="es"
  data-theme={theme.baseId}
  data-theme-key={theme.key}
  data-color-mode={colorModePreference}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <title>{title}</title>
    <ClientRouter transition:animate="none" />
    <style data-nanobook-theme is:inline set:html={installation.cssText}></style>
    <meta
      data-theme-state
      data-theme={theme.baseId}
      data-theme-key={theme.key}
      data-color-mode={colorModePreference}
      data-theme-variables={JSON.stringify(installation.variables)}
    />
  </head>
  <LayoutShell
    description={description}
    headings={headings}
    hideToc={hideToc}
    loginHref={loginHref}
    navigationService={navigationService}
    navigationContext={navigationContext}
    userName={session?.name}
    signedIn={Boolean(session)}
  >
    <slot />
  </LayoutShell>
</html>
