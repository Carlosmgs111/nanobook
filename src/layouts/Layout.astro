---
import "../shared/styles/global.css";
import { ClientRouter } from "astro:transitions";
import LayoutShell from "./components/LayoutShell.astro";
import type { NavigationNode } from "../navigation/graph/builder";
import type { Crumb } from "../navigation/components/Breadcrumb.astro";

interface ParentEntry {
  id: string;
  data: {
    title: string;
  };
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: Crumb[];
  sidebarEntries?: NavigationNode[];
  parentEntry?: ParentEntry | null;
  headings?: Heading[];
  hideToc?: boolean;
  editHref?: string;
  viewHref?: string;
  canonicalHref?: string;
}

const {
  title = "Astro",
  description,
  breadcrumbs,
  sidebarEntries,
  parentEntry,
  headings,
  hideToc = false,
  editHref,
  viewHref,
  canonicalHref,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <title>{title}</title>
    <ClientRouter transition:animate="none"/>
  </head>
  <LayoutShell
    description={description}
    breadcrumbs={breadcrumbs}
    sidebarEntries={sidebarEntries}
    parentEntry={parentEntry}
    headings={headings}
    hideToc={hideToc}
    editHref={editHref}
    viewHref={viewHref}
  >
    <slot />
  </LayoutShell>
</html>
