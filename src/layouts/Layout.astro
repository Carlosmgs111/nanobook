---
import "../styles/global.css";
import Breadcrumb from "../components/Breadcrumb.astro";
import ContentWidthToggle from "../components/ContentWidthToggle.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import SidebarNav from "../components/SidebarNav.astro";
import MenuSVG from "../icons/menu.svg";
import TableOfContents from "../components/TableOfContents/index.astro";

interface Crumb {
  id: string;
  title: string;
  href: string;
  current: boolean;
}

interface SidebarEntry {
  id: string;
  data: {
    title: string;
    description: string;
    draft: boolean;
    index: boolean;
  };
  current?: boolean;
}

interface ParentEntry {
  id: string;
  data: {
    title: string;
  };
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  label?: string;
  breadcrumbs?: Crumb[];
  sidebarEntries?: SidebarEntry[];
  parentEntry?: ParentEntry | null;
  headings?: Heading[];
}

const {
  title = "Astro",
  description,
  label = "Document",
  breadcrumbs,
  sidebarEntries,
  parentEntry,
  headings,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        const stored =
          typeof localStorage !== "undefined"
            ? localStorage.getItem("theme")
            : null;
        const prefersLight =
          typeof window !== "undefined" &&
          window.matchMedia("(prefers-color-scheme: light)").matches;
        const isLight = stored ? stored === "light" : prefersLight;
        document.documentElement.classList.toggle("light", isLight);
      })();
    </script>
  </head>
  <body
    class="relative min-h-screen overflow-x-hidden bg-[var(--bg)] text-[var(--text)]"
  >
    <!-- Grid overlay -->
    <div class="grid-overlay" aria-hidden="true"></div>

    <!-- Top and bottom subtle rules -->
    <div
      class="fixed top-0 left-0 right-0 h-px bg-[var(--grid-line-strong)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="fixed bottom-0 left-0 right-0 h-px bg-[var(--grid-line-strong)]"
      aria-hidden="true"
    >
    </div>

    <!-- Header -->
    <header
      class="sticky top-0 z-40 flex items-center justify-between gap-4 border-b border-[var(--grid-line-strong)] bg-[var(--bg)]/90 px-6 py-5 backdrop-blur-sm"
    >
      <div class="min-w-0 flex-1">
        {breadcrumbs && <Breadcrumb crumbs={breadcrumbs} />}
      </div>
      <div class="flex flex-shrink-0 items-center gap-2">
        <button
          id="sidebar-toggle"
          type="button"
          class="flex h-9 w-9 items-center justify-center border border-[var(--grid-line-strong)] bg-[var(--bg)] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] md:hidden"
          aria-label="Abrir navegación"
          aria-expanded="false"
          aria-controls="sidebar"
        >
          <MenuSVG />
        </button>
        <ContentWidthToggle />
        <ThemeToggle />
      </div>
    </header>

    <!-- Main content -->
    <div
      id="content-wrapper"
      class="content-wrapper z-10 mx-auto flex max-w-6xl gap-6 px-6 py-12"
      data-content-mode="constrained"
    >
      {
        sidebarEntries && (
          <SidebarNav entries={sidebarEntries} parentEntry={parentEntry} />
        )
      }
      <main class="border-x border-[var(--grid-line)] px-6 flex-1 min-w-0">
        <div class="glass-panel corner-plus">
          <div class="prose max-w-none">
            <slot />
          </div>
        </div>
      </main>
      {headings && <TableOfContents headings={headings} />}
      <!--  -->
    </div>

    <!-- Footer -->
    <footer class="z-10 py-8 text-center">
      <div class="mx-auto max-w-4xl px-6">
        <div class="rule mb-4"></div>
        <p class="tech-label">Rendered with Astro + Tailwind</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const wrapper = document.getElementById("content-wrapper");
        const sidebar = document.getElementById("sidebar");
        const tocRoot = document.querySelector(".toc-root");
        const tocToggle = document.getElementById("toc-toggle");
        const sidebarModeToggle = document.getElementById(
          "sidebar-mode-toggle"
        );

        if (!wrapper || !sidebar) return;

        var lastContentMode =
          wrapper.getAttribute("data-content-mode") || "constrained";

        function setTocMode(mode) {
          if (!tocRoot || !tocToggle) return;
          tocRoot.setAttribute("data-toc-mode", mode);
          tocToggle.setAttribute("data-toc-mode", mode);
          tocToggle.setAttribute("aria-pressed", String(mode === "compact"));
          if (typeof localStorage !== "undefined") {
            localStorage.setItem("toc-mode", mode);
          }
        }

        function setSidebarMode(mode) {
          sidebar.setAttribute("data-sidebar-mode", mode);
          if (sidebarModeToggle) {
            sidebarModeToggle.setAttribute("data-sidebar-mode", mode);
            sidebarModeToggle.setAttribute(
              "aria-pressed",
              String(mode === "collapsed")
            );
            sidebarModeToggle.setAttribute(
              "aria-label",
              mode === "expanded" ? "Contraer navegación" : "Expandir navegación"
            );
          }
          if (typeof localStorage !== "undefined") {
            localStorage.setItem("sidebar-mode", mode);
          }
        }

        function expandAll() {
          if (sidebar.getAttribute("data-sidebar-mode") !== "expanded") {
            setSidebarMode("expanded");
          }
          if (tocRoot && tocRoot.getAttribute("data-toc-mode") !== "standard") {
            setTocMode("standard");
          }
        }

        function enforceSingleExpanded() {
          if (wrapper.getAttribute("data-content-mode") === "full") return;

          var sidebarExpanded =
            sidebar.getAttribute("data-sidebar-mode") === "expanded";

          if (!tocRoot) return;

          var tocExpanded =
            tocRoot.getAttribute("data-toc-mode") === "standard";

          if (sidebarExpanded && tocExpanded) {
            setSidebarMode("collapsed");
          }
        }

        function onContentModeChange() {
          var currentMode =
            wrapper.getAttribute("data-content-mode") || "constrained";
          if (currentMode === "full" && lastContentMode !== "full") {
            expandAll();
          }
          lastContentMode = currentMode;
          enforceSingleExpanded();
        }

        function onPanelModeChange() {
          enforceSingleExpanded();
        }

        function init() {
          window.addEventListener("resize", enforceSingleExpanded);

          if (sidebarModeToggle && tocRoot && tocToggle) {
            sidebarModeToggle.addEventListener(
              "click",
              function () {
                if (wrapper.getAttribute("data-content-mode") === "full")
                  return;
                var sidebarMode =
                  sidebar.getAttribute("data-sidebar-mode") || "expanded";
                var tocMode =
                  tocRoot.getAttribute("data-toc-mode") || "standard";
                if (sidebarMode === "collapsed" && tocMode === "standard") {
                  setTocMode("compact");
                } else if (
                  sidebarMode === "expanded" &&
                  tocMode === "compact"
                ) {
                  setTocMode("standard");
                }
              },
              true
            );
          }

          var wrapperObserver = new MutationObserver(onContentModeChange);
          wrapperObserver.observe(wrapper, {
            attributes: true,
            attributeFilter: ["data-content-mode"],
          });

          var panelObserver = new MutationObserver(onPanelModeChange);
          panelObserver.observe(sidebar, {
            attributes: true,
            attributeFilter: ["data-sidebar-mode"],
          });
          if (tocRoot) {
            panelObserver.observe(tocRoot, {
              attributes: true,
              attributeFilter: ["data-toc-mode"],
            });
          }

          enforceSingleExpanded();
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>

<style>
  :root {
    /* Anchura mínima a partir de la cual el modo full de ancho de contenido
       tiene sentido y se muestra el botón correspondiente. Si se cambia este
       valor, también debe actualizarse la media query de #content-width-toggle. */
    --content-width-min: 1280px;
  }

  .content-wrapper {
    max-width: 72rem;
  }

  .content-wrapper[data-content-mode="full"] {
    max-width: none;
  }

  /* El valor debe coincidir con --content-width-min. */
  @media (max-width: 1279px) {
    :global(#content-width-toggle) {
      display: none;
    }
  }
</style>
