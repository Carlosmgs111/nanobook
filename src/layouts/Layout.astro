---
import "../styles/global.css";
import Breadcrumb from "../components/Breadcrumb.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import SidebarNav from "../components/SidebarNav.astro";

interface Crumb {
  id: string;
  title: string;
  href: string;
  current: boolean;
}

interface SidebarEntry {
  id: string;
  data: {
    title: string;
    description: string;
    draft: boolean;
    index: boolean;
  };
  current?: boolean;
}

interface ParentEntry {
  id: string;
  data: {
    title: string;
  };
}

interface Props {
  title?: string;
  description?: string;
  label?: string;
  breadcrumbs?: Crumb[];
  sidebarEntries?: SidebarEntry[];
  parentEntry?: ParentEntry | null;
}

const {
  title = "Astro",
  description,
  label = "Document",
  breadcrumbs,
  sidebarEntries,
  parentEntry,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        const stored =
          typeof localStorage !== "undefined"
            ? localStorage.getItem("theme")
            : null;
        const prefersLight =
          typeof window !== "undefined" &&
          window.matchMedia("(prefers-color-scheme: light)").matches;
        const isLight = stored ? stored === "light" : prefersLight;
        document.documentElement.classList.toggle("light", isLight);
      })();
    </script>
  </head>
  <body
    class="relative min-h-screen overflow-x-hidden bg-[var(--bg)] text-[var(--text)]"
  >
    <!-- Grid overlay -->
    <div class="grid-overlay" aria-hidden="true"></div>

    <!-- Top and bottom subtle rules -->
    <div
      class="fixed top-0 left-0 right-0 h-px bg-[var(--grid-line-strong)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="fixed bottom-0 left-0 right-0 h-px bg-[var(--grid-line-strong)]"
      aria-hidden="true"
    >
    </div>

    <!-- Header -->
    <header
      class="sticky top-0 z-50 border-b border-[var(--grid-line-strong)] bg-[var(--bg)]/90 backdrop-blur-sm flex"
    >
      <div class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-5">
        {breadcrumbs && <Breadcrumb crumbs={breadcrumbs} />}
      </div>
      <div class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-5">
        <ThemeToggle />
      </div>
    </header>

    <!-- Main content -->
    <div
      class="relative z-10 mx-auto grid max-w-6xl grid-cols-1 gap-6 px-6 py-12 md:grid-cols-[16rem_1fr]"
    >
      {sidebarEntries && (
        <SidebarNav entries={sidebarEntries} parentEntry={parentEntry} />
      )}
      <main class="border-x border-[var(--grid-line)] px-6">
        <div class="glass-panel corner-plus">
          <div class="prose max-w-none">
            <slot />
          </div>
        </div>
      </main>
    </div>

    <!-- Footer -->
    <footer class="relative z-10 py-8 text-center">
      <div class="mx-auto max-w-4xl px-6">
        <div class="rule mb-4"></div>
        <p class="tech-label">Rendered with Astro + Tailwind</p>
      </div>
    </footer>
  </body>
</html>
