---
import "../styles/global.css";
import Breadcrumb from "../components/Breadcrumb.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import SidebarNav from "../components/SidebarNav.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Crumb {
  id: string;
  title: string;
  href: string;
  current: boolean;
}

interface SidebarEntry {
  id: string;
  data: {
    title: string;
    description: string;
    draft: boolean;
    index: boolean;
  };
  current?: boolean;
}

interface ParentEntry {
  id: string;
  data: {
    title: string;
  };
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  label?: string;
  breadcrumbs?: Crumb[];
  sidebarEntries?: SidebarEntry[];
  parentEntry?: ParentEntry | null;
  headings?: Heading[];
}

const {
  title = "Astro",
  description,
  label = "Document",
  breadcrumbs,
  sidebarEntries,
  parentEntry,
  headings,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        const stored =
          typeof localStorage !== "undefined"
            ? localStorage.getItem("theme")
            : null;
        const prefersLight =
          typeof window !== "undefined" &&
          window.matchMedia("(prefers-color-scheme: light)").matches;
        const isLight = stored ? stored === "light" : prefersLight;
        document.documentElement.classList.toggle("light", isLight);
      })();
    </script>
  </head>
  <body
    class="relative min-h-screen overflow-x-hidden bg-[var(--bg)] text-[var(--text)]"
  >
    <!-- Grid overlay -->
    <div class="grid-overlay" aria-hidden="true"></div>

    <!-- Top and bottom subtle rules -->
    <div
      class="fixed top-0 left-0 right-0 h-px bg-[var(--grid-line-strong)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="fixed bottom-0 left-0 right-0 h-px bg-[var(--grid-line-strong)]"
      aria-hidden="true"
    >
    </div>

    <!-- Header -->
    <header
      class="md:sticky md:top-0 md:z-50 border-b border-[var(--grid-line-strong)] bg-[var(--bg)]/90 backdrop-blur-sm flex"
    >
      <div class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-5">
        {breadcrumbs && <Breadcrumb crumbs={breadcrumbs} />}
      </div>
      <div class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-5">
        <div class="flex items-center gap-2">
          <button
            id="toc-toggle"
            type="button"
            class="hidden h-9 w-9 items-center justify-center border border-[var(--grid-line-strong)] text-[var(--muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] md:flex"
            aria-label="Cambiar modo del índice"
            aria-pressed="false"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
          </button>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <!-- Main content -->
    <div class="z-10 mx-auto flex max-w-6xl gap-6 px-6 py-12">
      {
        sidebarEntries && (
          <SidebarNav entries={sidebarEntries} parentEntry={parentEntry} />
        )
      }
      <main class="border-x border-[var(--grid-line)] px-6 flex-1 min-w-0">
        <div class="glass-panel corner-plus">
          <div class="prose max-w-none">
            <slot />
          </div>
        </div>
      </main>
      {headings && <TableOfContents headings={headings} />}
      <!--  -->
    </div>

    <script is:inline>
      (function () {
        const root = document.querySelector(".toc-root");
        const toggle = document.getElementById("toc-toggle");
        if (!root || !toggle) return;

        const saved =
          typeof localStorage !== "undefined"
            ? localStorage.getItem("toc-mode")
            : null;
        const mode = saved === "compact" ? "compact" : "standard";
        root.setAttribute("data-toc-mode", mode);
        toggle.setAttribute("aria-pressed", mode === "compact");

        toggle.addEventListener("click", function () {
          const current = root.getAttribute("data-toc-mode") || "standard";
          const next = current === "standard" ? "compact" : "standard";
          root.setAttribute("data-toc-mode", next);
          toggle.setAttribute("aria-pressed", next === "compact");
          if (typeof localStorage !== "undefined") {
            localStorage.setItem("toc-mode", next);
          }
        });
      })();
    </script>

    <!-- Footer -->
    <footer class="z-10 py-8 text-center">
      <div class="mx-auto max-w-4xl px-6">
        <div class="rule mb-4"></div>
        <p class="tech-label">Rendered with Astro + Tailwind</p>
      </div>
    </footer>
  </body>
</html>
