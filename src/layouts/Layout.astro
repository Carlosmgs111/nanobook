---
import "../shared/styles/global.css";
import { ClientRouter } from "astro:transitions";
import LayoutShell from "./components/LayoutShell.astro";
import type { NavigationService } from "../navigation/server";
import { getApp } from "../application/server/Application";
import { normalizeColorModePreference, type AppliedTheme } from "../theme/server";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  headings?: Heading[];
  hideToc?: boolean;
  editHref?: string;
  viewHref?: string;
  newHref?: string;
  loginHref?: string;
  canonicalHref?: string;
  navigationService?: NavigationService;
  theme?: AppliedTheme;
}

const {
  title = "Astro",
  description,
  headings,
  hideToc = false,
  editHref,
  viewHref,
  newHref,
  loginHref = "/login",
  canonicalHref,
  navigationService,
  theme: suppliedTheme,
} = Astro.props;
const app = await getApp();
const theme = suppliedTheme ?? await app.themeModule.resolveTheme.execute({ kind: "official", id: "classic" });
const storedMode = Astro.cookies.get("nanobook-color-mode")?.value;
const colorModePreference = normalizeColorModePreference(storedMode);
const themeVariables = Object.fromEntries([...Object.entries(theme.lightVariables), ...Object.entries(theme.darkVariables)]);
const themeStyle = Object.entries(themeVariables)
  .map(([key, value]) => `${key}:${value}`)
  .join(";");
---

<!doctype html>
<html lang="es" data-theme={theme.baseId} data-theme-key={theme.key} data-color-mode={colorModePreference} style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <title>{title}</title>
    <ClientRouter transition:animate="none" />
    <meta data-theme-state data-theme={theme.baseId} data-theme-key={theme.key} data-color-mode={colorModePreference} data-theme-variables={JSON.stringify(themeVariables)} />
  </head>
  <LayoutShell
    description={description}
    headings={headings}
    hideToc={hideToc}
    editHref={editHref}
    viewHref={viewHref}
    newHref={newHref}
    loginHref={loginHref}
    navigationService={navigationService}
  >
    <slot />
  </LayoutShell>
</html>
