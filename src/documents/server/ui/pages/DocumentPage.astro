---
import IndexList from "../../../../navigation/server/ui/components/IndexList/index.astro";
import Layout from "../../../../layouts/Layout.astro";
import { getApp } from "../../../../application/server/Application";

const app = await getApp();

export const prerender = false;

const slug = Astro.params.slug || "index";
console.log({slug});
if (!slug) return new Response("Document not found", { status: 404 });

const document = await app.documentModule.getDocument.execute(slug);

if (!document) throw new Error("Document not found");
const renderedPage = await app.publishingModule.pagePublisher.publish(document);
if (!renderedPage) throw new Error("Page not found");
const { rendered, headings } = renderedPage;
const { entry, renderedBody } = rendered;

const editHref = slug ? `/${slug}/edit` : `${Astro.request.url}edit`;

const newHref = entry.isIndex
  ? entry.slug === "index"
    ? `${Astro.request.url}new`
    : `/${entry.slug}/new`
  : "/new";
const canonicalHref = entry.ref
  ? entry.ref === "index"
    ? "/"
    : `/${entry.ref}/`
  : undefined;

Astro.response.headers.set("Cache-Control", "no-store");

---

<Layout
  title={entry.title}
  description={entry.description}
  headings={headings}
  editHref={editHref}
  newHref={newHref}
  canonicalHref={canonicalHref}
>
{
  entry.isIndex ? (
    <IndexList
      title={entry.title}
      description={entry.description}
      label="Index"
    />
  ) : (
    <Fragment>
      <div class="mb-10 border-b border-[var(--grid-line-strong)] pb-8">
        <span class="tech-label mb-3 block">Document</span>
        <h1 class="glow-text text-4xl font-semibold tracking-tight text-[var(--accent)] md:text-5xl">
          {entry.title}
        </h1>
      </div>

      <div class="mb-12 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 border border-[var(--grid-line-strong)] bg-[var(--bg-elevated)] px-4 py-3 font-mono text-xs text-[var(--muted)]">
        <span>ID: {entry.documentId}</span>
        <span class="hidden text-[var(--grid-line-strong)] sm:inline">|</span>
        <span>PATH: {entry.path}</span>
        <span class="hidden text-[var(--grid-line-strong)] sm:inline">|</span>
        <span class="text-sm">
          DATE: {entry.metadata.createdAt?.toISOString().slice(0, 10)}
        </span>
        <span class="hidden text-[var(--grid-line-strong)] sm:inline">|</span>
        <span>AUTHOR: {entry.metadata.author}</span>
      </div>
      <div
        id="document-body"
        data-document-id={entry.documentId}
        data-document-ref={entry.ref ?? ""}
        set:html={renderedBody}
      />
    </Fragment>
  )
}

</Layout>


<script>
  import { getApp } from "../../../../application/browser/Application";

  const app = getApp();

  document.addEventListener("astro:page-load", () => {
    const body = document.querySelector<HTMLElement>("#document-body");
    const documentId = body?.dataset.documentId;
    if (!body || !documentId) return;

    // Los proxies ya llegan resueltos desde el servidor. Una preview de
    // sessionStorage puede pertenecer a una versión anterior del documento
    // referenciado y ocultar temporalmente el contenido SSR correcto.
    if (body.dataset.documentRef) return;

    const renderedResult = app.editionModule.getRenderedDocument.execute(
      documentId,
      true
    );
    if (!renderedResult.isSuccess) return;

    const currentRef = body.dataset.documentRef ?? "";
    const cachedRef = renderedResult.getValue().source.metadata.ref;
    const normalizedCachedRef =
      typeof cachedRef === "string"
        ? cachedRef
        : JSON.stringify(cachedRef ?? "");
    if (normalizedCachedRef !== currentRef) return;

    body.innerHTML = renderedResult.getValue().rendered.Content;
    body.dataset.renderedFromEdition = "true";
  });
</script>
