<script>
  import { getApp } from "../../../application/browser/Application";
  import { EditionWriterError } from "../domain/errors";
  import { prefetch } from "astro:prefetch";

  const app = getApp();
  let statusElement: HTMLElement | null = null;

  function showStatus(message: string, isError = false) {
    if (!statusElement) return;
    statusElement.textContent = message;
    statusElement.className = `status ${isError ? "status-error" : "status-success"}`;
    window.setTimeout(() => {
      if (!statusElement) return;
      statusElement.textContent = "";
      statusElement.className = "status";
    }, 4000);
  }

  /**
   * Muestra el error de una operación. El servidor ya devuelve un mensaje para
   * 401/403 (sin sesión o sin permiso de escritura), que se muestra tal cual;
   * 409 es una revisión obsoleta y tiene un texto propio.
   */
  function showError(error: unknown, fallback: string) {
    console.error(error);
    if (error instanceof EditionWriterError && error.status === 409) {
      showStatus(
        "El documento cambió en otra sesión. Tus cambios locales se conservaron; recarga para comparar antes de volver a guardar.",
        true
      );
      return;
    }
    showStatus(error instanceof Error ? error.message : fallback, true);
  }

  /** Reemplaza el botón por un clon (descarta listeners de navegaciones previas) y enlaza el handler. */
  function bindAction(
    action: string,
    handler: (button: HTMLButtonElement) => Promise<void>
  ) {
    const original = document.querySelector<HTMLButtonElement>(
      `[data-action='${action}']`
    );
    if (!original) return;
    const button = original.cloneNode(true) as HTMLButtonElement;
    original.replaceWith(button);
    button.addEventListener("click", async (event) => {
      event.preventDefault();
      if (button.disabled) return;
      button.disabled = true;
      try {
        await handler(button);
      } finally {
        button.disabled = false;
      }
    });
  }

  document.addEventListener("astro:page-load", () => {
    statusElement = document.querySelector<HTMLElement>("[data-edition-result]");

    bindAction("save", async (button) => {
      const result = await app.editionModule.saveDocument.execute(
        button.dataset.documentId as string
      );
      if (!result.isSuccess) {
        showError(result.getError(), "Error al guardar");
        return;
      }
      if (button.dataset.viewHref) prefetch(button.dataset.viewHref);
      showStatus("Guardado correctamente");
    });

    bindAction("delete", async (button) => {
      const message =
        button.dataset.isDirectory === "true"
          ? "Este documento es un directorio. Se eliminarán también todos los documentos que contiene. Esta acción no se puede deshacer. ¿Deseas continuar?"
          : "Este documento se eliminará permanentemente. ¿Deseas continuar?";
      if (!window.confirm(message)) return;

      const result = await app.editionModule.deleteDocument.execute(
        button.dataset.documentId as string
      );
      if (!result.isSuccess) {
        showError(result.getError(), "Error al eliminar");
        return;
      }
      window.location.href = button.dataset.parentHref || "/";
    });

    bindAction("rename", async (button) => {
      const currentPath = button.dataset.documentPath || "";
      const nextPath = window.prompt(
        "Nueva ruta interna del documento (usa /index para directorios):",
        currentPath
      );
      if (nextPath === null || nextPath.trim() === currentPath) return;

      const result = await app.editionModule.renameDocument.execute(
        button.dataset.documentId as string,
        nextPath
      );
      if (!result.isSuccess) {
        showError(result.getError(), "Error al renombrar");
        return;
      }

      const renamed = result.getValue();
      const publicPath =
        renamed.isIndex && renamed.path !== "index"
          ? renamed.path.slice(0, -"/index".length)
          : renamed.path;
      window.location.href = publicPath === "index" ? "/" : `/${publicPath}`;
    });
  });
</script>
