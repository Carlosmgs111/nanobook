<script>
  import { getApp } from "../../../application/browser/Application";

  const app = getApp();

  const TYPE_HELP: Record<string, string> = {
    document: "Crea un archivo Markdown directamente bajo la ruta actual.",
    directory:
      "Crea un directorio con un archivo index.md que actúa como índice.",
  };
  function initForm() {
    const form = document.querySelector<HTMLFormElement>(
      "[data-new-document-form]"
    );
    if (!form) return;

    const wrapper = form.closest<HTMLElement>("[data-base-path]");
    const typeSelect =
      form.querySelector<HTMLSelectElement>("[data-type-select]");
    const helpText = form.querySelector<HTMLElement>("[data-type-help]");
    const errorContainer = form.querySelector<HTMLElement>("[data-error]");
    const basePath = wrapper?.dataset.basePath ?? "";

    typeSelect?.addEventListener("change", () => {
      if (helpText && typeSelect) {
        helpText.textContent = TYPE_HELP[typeSelect.value] ?? "";
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!errorContainer) return;
      errorContainer.classList.add("hidden");

      const formData = new FormData(form);
      const type = String(formData.get("type") ?? "document");
      const name = String(formData.get("name") ?? "").trim();
      const title = String(formData.get("title") ?? "").trim();
      const description = String(formData.get("description") ?? "").trim();
      const position = Number(formData.get("position") ?? 0);
      const draft = formData.get("draft") === "on";

      function isValidName(name: string): boolean {
        return /^[\p{L}\p{N}\-_]+$/u.test(name.normalize("NFC"));
      }

      if (!isValidName(name)) {
        errorContainer.textContent =
          "El nombre solo puede contener letras, números, guiones y guiones bajos.";
        errorContainer.classList.remove("hidden");
        return;
      }

      try {
        const redirectId = await createFromType(
          type,
          name,
          {
            title,
            description,
            position,
            draft,
          },
          basePath
        );

        window.location.href =
          redirectId === "index" ? "/edit" : `/${redirectId}/edit`;
      } catch (error) {
        errorContainer.textContent =
          error instanceof Error
            ? error.message
            : "Error al crear el documento";
        errorContainer.classList.remove("hidden");
      }
    });
  }

  async function createFromType(
    type: string,
    name: string,
    metadata: {
      title: string;
      description: string;
      position: number;
      draft: boolean;
    },
    basePath: string
  ): Promise<string> {
    const base = basePath ? `${basePath.replace(/\/$/, "")}` : "";
    const prefix = base ? `${base}/` : "";
    let path: string | null = null;
    if (type === "document") {
      path = `${prefix}${name}`;
    }
    if (type === "directory") {
      path = `${prefix}${name}/index`;
    }
    if (!path) {
      throw new Error("Ruta no válida");
    }
    const id = crypto.randomUUID();
    const result = await app.editionModule.createDocument.execute({
      id,
      path,
      ...metadata,
      content: "",
    });
    if (!result.isSuccess) {
      throw result.getError();
    }
    return result.getValue().slug;
  }

  document.addEventListener("astro:page-load", initForm);
</script>
