---
import DocumentEditor from "../components/DocumentEditor.astro";
import Layout from "../../../../layouts/Layout.astro";
import { getApp } from "../../../../application/server/Application";

const app = await getApp();

interface Props {
  nanobookSlug?: string;
}

const { nanobookSlug } = Astro.props;
if (!nanobookSlug) {
  return new Response("Nanobook not found", { status: 404 });
}
const nanobookResult = await app.nanobookModule.getNanobookBySlug.execute(nanobookSlug);
if (!nanobookResult.isSuccess) throw nanobookResult.getError();
const nanobook = nanobookResult.getValue();
if (!nanobook) {
  return new Response("Nanobook not found", { status: 404 });
}
const documentModule = app.nanobookModule.documentModule;
const { publishingModule, navigationModule } = app;
const nanobookId = nanobook.getId();
const theme = await app.themeModule.resolveTheme.execute(
  nanobook.getSettings().theme,
  Astro.request,
);
const navigationService = await navigationModule.getNavigation(nanobookId, {
  rootPath: "index",
  basePath: `/n/${nanobook.getSlug()}`,
});

export const prerender = false;

const slug = Astro.params.slug || "index";
if (!slug) return Astro.redirect("/404");
const document = await documentModule.getDocument.execute(nanobookId, slug);
if (!document) throw new Error("Document not found");
const renderedPage = await publishingModule.pagePublisher.publish(document);
if (!renderedPage) throw new Error("Page not found");
const { rendered } = renderedPage;
const { entry } = rendered;

if (!entry) {
  return new Response("Document not found!", { status: 404 });
}
const sourceDocument = entry.ref
  ? await documentModule.getDocument.executeRaw(nanobookId, slug)
  : null;
const editableEntry = sourceDocument?.parse() ?? entry;
const baseHref = nanobookSlug ? `/n/${nanobookSlug}` : "";
const viewHref = `${baseHref}/${editableEntry.slug}`;
const previewHref = `${baseHref}/${editableEntry.slug}/preview`;
const newHref = editableEntry.isIndex ? `${baseHref}/${editableEntry.slug}/new` : `${baseHref}/new`;
const parentHref = editableEntry.parentPath
  ? `${baseHref}/${editableEntry.parentPath}`
  : `${baseHref || "/"}`;
---

<Layout
  title={`Editar: ${editableEntry.title}`}
  description={editableEntry.description}
  hideToc={true}
  viewHref={viewHref}
  newHref={newHref}
  navigationService={navigationService}
  theme={theme}
>
  <div class="mb-10 border-b border-[var(--theme-border)] pb-8">
    <span class="tech-label mb-3 block">Editing document</span>
    <h1
      class="glow-text text-3xl font-semibold tracking-tight text-[var(--theme-accent)] md:text-4xl"
    >
      {entry.title}
    </h1>
  </div>

  {
    entry.ref && (
      <div
        class="mb-4 border border-[var(--theme-border)] bg-[var(--theme-surface-bg)] p-6 text-[var(--theme-text-muted)]"
        role="status"
      >
        <h2 class="mb-3 text-lg font-semibold text-[var(--theme-accent)]">
          Proxy: solo se edita el frontmatter
        </h2>
        <p>
          Este documento muestra el contenido de <code>{entry.ref}</code>. El
          cuerpo referenciado no se carga ni se puede modificar desde aquí.
        </p>
        <p class="mt-3">
          Puedes cambiar el título, descripción y demás metadatos del proxy.
          Edita el documento original si necesitas cambiar el contenido
          mostrado.
        </p>
      </div>
    )
  }
  <DocumentEditor
    entry={entry}
    previewHref={entry.ref ? undefined : previewHref}
    viewHref={viewHref}
    parentHref={parentHref}
    frontmatterOnly={Boolean(entry.ref)}
    nanobookId={nanobookId}
  />
</Layout>
