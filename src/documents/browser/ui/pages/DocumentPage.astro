---
import IndexList from "../../../../navigation/browser/ui/components/IndexList/index.astro";
import Layout from "../../../../layouts/Layout.astro";
import { getApp } from "../../../../application/server/Application";

const app = await getApp();

interface Props {
  nanobookSlug?: string;
}

const { nanobookSlug } = Astro.props;
if (!nanobookSlug) {
  return new Response("Nanobook not found", { status: 404 });
}
const nanobookResult = await app.nanobookModule.getNanobookBySlug.execute(nanobookSlug);
if (!nanobookResult.isSuccess) throw nanobookResult.getError();
const nanobook = nanobookResult.getValue();
if (!nanobook) {
  return new Response("Nanobook not found", { status: 404 });
}
const documentModule = app.nanobookModule.documentModule;
const { publishingModule, navigationModule } =
  await app.createNanobookCapabilities(nanobook);
const nanobookId = nanobook.getId();

export const prerender = false;

const slug = Astro.params.slug || "index";
console.log({slug});
if (!slug) return new Response("Document not found", { status: 404 });

const document = await documentModule.getDocument.execute(nanobookId, slug);

if (!document) throw new Error("Document not found");
const renderedPage = await publishingModule.pagePublisher.publish(document);
if (!renderedPage) throw new Error("Page not found");
const { rendered, headings } = renderedPage;
const { entry, renderedBody } = rendered;

const baseHref = nanobookSlug ? `/n/${nanobookSlug}` : "";
const editHref = slug ? `${baseHref}/${slug}/edit` : `${baseHref}/edit`;

const newHref = entry.isIndex
    ? entry.slug === "index"
      ? `${baseHref}/index/new`
      : `${baseHref}/${entry.slug}/new`
    : `${baseHref}/new`;
const canonicalHref = entry.ref
  ? entry.ref === "index"
    ? `${baseHref || "/"}`
    : `${baseHref}/${entry.ref}/`
  : undefined;

Astro.response.headers.set("Cache-Control", "no-store");

---

<Layout
  title={entry.title}
  description={entry.description}
  headings={headings}
  editHref={editHref}
  newHref={newHref}
  canonicalHref={canonicalHref}
  navigationService={navigationModule.navigationService}
>
{
  entry.isIndex ? (
    <IndexList
      title={entry.title}
      description={entry.description}
      label="Index"
      navigationService={navigationModule.navigationService}
    />
  ) : (
    <Fragment>
      <div class="mb-10 border-b border-[var(--theme-border)] pb-8">
        <span class="tech-label mb-3 block">Document</span>
        <h1 class="glow-text text-4xl font-semibold tracking-tight text-[var(--theme-accent)] md:text-5xl">
          {entry.title}
        </h1>
      </div>

      <div class="mb-12 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 border border-[var(--theme-border)] bg-[var(--theme-surface-bg)] px-4 py-3 font-[family-name:var(--theme-font-code)] text-xs text-[var(--theme-text-muted)]">
        <span>ID: {entry.documentId}</span>
        <span class="hidden text-[var(--theme-border)] sm:inline">|</span>
        <span>PATH: {entry.path}</span>
        <span class="hidden text-[var(--theme-border)] sm:inline">|</span>
        <span class="text-sm">
          DATE: {entry.metadata.createdAt?.toISOString().slice(0, 10)}
        </span>
        <span class="hidden text-[var(--theme-border)] sm:inline">|</span>
        <span>AUTHOR: {entry.metadata.author}</span>
      </div>
      <div
        id="document-body"
        data-document-id={entry.documentId}
        data-document-ref={entry.ref ?? ""}
        set:html={renderedBody}
      />
    </Fragment>
  )
}

</Layout>


<script>
  import { getApp } from "../../../../application/browser/Application";

  const app = getApp();

  document.addEventListener("astro:page-load", () => {
    const body = document.querySelector<HTMLElement>("#document-body");
    const documentId = body?.dataset.documentId;
    if (!body || !documentId) return;

    // Los proxies ya llegan resueltos desde el servidor. Una preview de
    // sessionStorage puede pertenecer a una versión anterior del documento
    // referenciado y ocultar temporalmente el contenido SSR correcto.
    if (body.dataset.documentRef) return;

    const renderedResult = app.editionModule.getRenderedDocument.execute(
      documentId,
      true
    );
    if (!renderedResult.isSuccess) return;

    const currentRef = body.dataset.documentRef ?? "";
    const cachedRef = renderedResult.getValue().source.metadata.ref;
    const normalizedCachedRef =
      typeof cachedRef === "string"
        ? cachedRef
        : JSON.stringify(cachedRef ?? "");
    if (normalizedCachedRef !== currentRef) return;

    body.innerHTML = renderedResult.getValue().rendered.Content;
    body.dataset.renderedFromEdition = "true";
  });
</script>
