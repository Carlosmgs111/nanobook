---
import IndexList from "../../../../navigation/browser/ui/components/IndexList/index.astro";
import Layout from "../../../../layouts/Layout.astro";
import { getApp } from "../../../../application/server/Application";
import { AuthorizeNanobook } from "../../../../nanobooks/server";
import type { Nanobook } from "../../../../nanobooks/server/domain/Nanobook";
import type { Document } from "../../../server";
import type { AuthenticatedUser } from "../../../../auth/shared/AuthSession";
import DocumentActionLink from "../components/DocumentActionLink.astro";
import DocumentPageController from "../DocumentPageController.astro";
import DocumentUnlockForm from "../components/DocumentUnlockForm.astro";
import { restrictSecuredNavigation } from "../../../../navigation/server";
import { appendServerTiming } from "../../../../shared/server/http/ServerTiming";

const timings: Record<string, number> = {};

async function measure<T>(name: string, operation: () => Promise<T>): Promise<T> {
  const startedAt = performance.now();
  try {
    return await operation();
  } finally {
    timings[name] = performance.now() - startedAt;
  }
}

const app = await measure("app", getApp);

interface Props {
  nanobook: Nanobook;
  user: AuthenticatedUser | null;
  /** The (proxy-resolved) document, already fetched by the route. */
  document: Document;
  /** The viewer must pass the password challenge before seeing any content. */
  challenged: boolean;
}

const { nanobook, user } = Astro.props;
const documentModule = app.nanobookModule.documentModule;
const { publishingModule, navigationModule } = app;
const nanobookId = nanobook.getId();
const canEdit = new AuthorizeNanobook().canWrite(nanobook, user?.id);
const deferOwnerActions = nanobook.getVisibility() === "public" && !canEdit;
const navigationContext = {
  section: "read" as const,
  book: { name: nanobook.getName(), href: `/n/${nanobook.getSlug()}` },
};
const theme = await measure("theme", () =>
  app.themeModule.resolveTheme.execute(nanobook.getSettings().theme, Astro.request)
);
const sharedNavigation = await measure("navigation", () =>
  navigationModule.getNavigation(nanobookId, {
    rootPath: "index",
    basePath: `/n/${nanobook.getSlug()}`,
  })
);
// Writers see the whole book; everyone else sees protected documents redacted.
const navigationService = canEdit ? sharedNavigation : restrictSecuredNavigation(sharedNavigation);

export const prerender = false;

const slug = Astro.params.slug || "index";
if (!slug) return new Response("Document not found", { status: 404 });

// The route resolved the document and the access decision (status and headers
// can only be set before rendering starts, so the guard lives in the page).
const { document, challenged } = Astro.props;

const renderedPage = challenged
  ? null
  : await measure("publish", () => publishingModule.pagePublisher.publish(document));
if (!challenged && !renderedPage) throw new Error("Page not found");
const headings = renderedPage?.headings ?? [];
// When challenged, only the title is used; no content reaches the response.
const entry = renderedPage?.rendered.entry ?? document.parse();
const renderedBody = renderedPage?.rendered.renderedBody ?? "";

const baseHref = `/n/${nanobook.getSlug()}`;
const editHref = slug ? `${baseHref}/${slug}/edit` : `${baseHref}/edit`;

const newHref =
  entry.isIndex
    ? entry.slug === "index"
      ? `${baseHref}/index/new`
      : `${baseHref}/${entry.slug}/new`
    : undefined;
const canonicalHref = !challenged && entry.ref
  ? entry.ref === "index"
    ? `${baseHref || "/"}`
    : `${baseHref}/${entry.ref}/`
  : undefined;

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set(
  "Server-Timing",
  appendServerTiming(Astro.response.headers.get("Server-Timing"), timings),
);
---

<Layout
  session={user}
  deferSessionUi={deferOwnerActions}
  title={entry.title}
  description={challenged ? undefined : entry.description}
  headings={challenged ? [] : headings}
  hideToc={challenged}
  canonicalHref={canonicalHref}
  navigationService={navigationService}
  theme={theme}
  navigationContext={navigationContext}
>
  {
    challenged ? (
      <DocumentUnlockForm
        nanobookId={nanobookId}
        documentPath={slug}
        title={document.getTitle()}
        indexHref={baseHref}
      />
    ) : entry.isIndex ? (
      <IndexList
        title={entry.title}
        description={entry.description}
        label="Índice"
        navigationService={navigationService}
        editHref={canEdit || deferOwnerActions ? editHref : undefined}
        newHref={canEdit || deferOwnerActions ? newHref : undefined}
        ownerId={deferOwnerActions ? nanobook.getOwnerId() : undefined}
      />
    ) : (
      <Fragment>
        <div class="mb-10 border-b border-[var(--theme-border)] pb-8">
          <span class="tech-label mb-3 block">Documento</span>
          <div class="flex flex-wrap items-start justify-between gap-4">
            <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">
              {entry.title}
            </h1>
            {(canEdit || deferOwnerActions) && <DocumentActionLink href={editHref} label="Editar" ownerId={deferOwnerActions ? nanobook.getOwnerId() : undefined} />}
          </div>
        </div>

        <div class="mb-12 flex flex-wrap items-center gap-x-3 gap-y-1 border-y border-[var(--theme-border-subtle)] py-3 text-sm text-[var(--theme-text-muted)]">
          {entry.metadata.author && <span>{entry.metadata.author}</span>}
          {entry.metadata.author && entry.metadata.createdAt && (
            <span aria-hidden="true">·</span>
          )}
          {entry.metadata.createdAt && (
            <time datetime={entry.metadata.createdAt.toISOString()}>
              {new Intl.DateTimeFormat("es", { dateStyle: "long" }).format(
                entry.metadata.createdAt
              )}
            </time>
          )}
        </div>
        <div
          id="document-body"
          data-document-id={entry.documentId}
          data-document-ref={entry.ref ?? ""}
          set:html={renderedBody}
        />
      </Fragment>
    )
  }
</Layout>

<DocumentPageController />
