---
import Layout from "../../../../layouts/Layout.astro";
import { getApp } from "../../../../application/server/Application";

const app = await getApp();

interface Props {
  nanobookSlug?: string;
}

const { nanobookSlug } = Astro.props;
const nanobookContext = nanobookSlug
  ? await app.forNanobookSlug(nanobookSlug)
  : null;
if (nanobookSlug && !nanobookContext) {
  return new Response("Nanobook not found", { status: 404 });
}
const documentModule = nanobookContext?.documentModule ?? app.documentModule;
const publishingModule = nanobookContext?.publishingModule ?? app.publishingModule;

export const prerender = false;

const slug = Astro.params.slug || "index";

if (!slug) {
  return new Response("Document not found", { status: 404 });
}

const document = await documentModule.getDocument.execute(slug);
if (!document) throw new Error("Document not found");
const renderedPage = await publishingModule.pagePublisher.publish(document);
if (!renderedPage) throw new Error("Page not found");
const { rendered } = renderedPage;
const { entry } = rendered;
const basePath = slug === "index" ? "" : `${slug}/`;
const baseHref = nanobookSlug ? `/n/${nanobookSlug}` : "";
---

<Layout
  title={`Nuevo documento en ${entry.title}`}
  description="Crear un nuevo documento"
  hideToc={true}
  navigationService={nanobookContext?.navigationModule.navigationService}
>
  <div class="mb-10 border-b border-[var(--grid-line-strong)] pb-8">
    <span class="tech-label mb-3 block">Nuevo documento</span>
    <h1
      class="glow-text text-3xl font-semibold tracking-tight text-[var(--accent)] md:text-4xl"
    >
      Crear documento
    </h1>
  </div>

  <div class="new-document-form" data-base-path={basePath} data-nanobook-id={nanobookContext?.nanobook.getId()}>
    <form class="space-y-6" data-new-document-form>
      <div class="space-y-2">
        <label class="block text-sm font-medium" for="new-doc-type">Tipo</label>
        <select
          id="new-doc-type"
          name="type"
          class="w-full border border-[var(--grid-line-strong)] bg-[var(--bg)] px-3 py-2 text-sm"
          data-type-select
        >
          <option value="document" selected>Documento</option>
          <option value="directory">Directorio</option>
        </select>
        <p class="text-xs text-[var(--text-muted)]" data-type-help>
          Crea un archivo Markdown directamente bajo la ruta actual.
        </p>
      </div>

      <div class="space-y-2">
        <label class="block text-sm font-medium" for="new-doc-name"
          >Nombre</label
        >
        <div class="flex items-center gap-2 text-sm">
          <span class="text-[var(--text-muted)] whitespace-nowrap"
            >/{basePath}</span
          >
          <input
            id="new-doc-name"
            name="name"
            type="text"
            required
            placeholder="nuevo-elemento"
            pattern="[\p{L}\p{N}\-_]+"
            class="w-full border border-[var(--grid-line-strong)] bg-[var(--bg)] px-3 py-2 text-sm"
            data-name-input
          />
        </div>
        <p class="text-xs text-[var(--text-muted)]">
          Solo letras, números, guiones y guiones bajos. Sin barras ni espacios.
        </p>
      </div>

      <div class="space-y-2">
        <label class="block text-sm font-medium" for="new-doc-title"
          >Título</label
        >
        <input
          id="new-doc-title"
          name="title"
          type="text"
          required
          class="w-full border border-[var(--grid-line-strong)] bg-[var(--bg)] px-3 py-2 text-sm"
        />
      </div>

      <div class="space-y-2">
        <label class="block text-sm font-medium" for="new-doc-description"
          >Descripción</label
        >
        <input
          id="new-doc-description"
          name="description"
          type="text"
          required
          class="w-full border border-[var(--grid-line-strong)] bg-[var(--bg)] px-3 py-2 text-sm"
        />
      </div>

      <div class="space-y-2">
        <label class="block text-sm font-medium" for="new-doc-position"
          >Posición</label
        >
        <input
          id="new-doc-position"
          name="position"
          type="number"
          class="w-full border border-[var(--grid-line-strong)] bg-[var(--bg)] px-3 py-2 text-sm"
          value="0"
        />
      </div>

      <div class="flex items-center gap-2">
        <input
          id="new-doc-draft"
          name="draft"
          type="checkbox"
          class="h-4 w-4"
        />
        <label class="text-sm" for="new-doc-draft">Borrador</label>
      </div>

      <div data-error class="text-sm text-red-500 hidden"></div>

      <div class="flex gap-3">
        <button
          type="submit"
          data-auth-document-mutation
          hidden
          class="inline-flex items-center justify-center border border-[var(--grid-line-strong)] bg-[var(--text)] px-4 py-2 text-sm font-medium text-[var(--bg)] hover:opacity-90"
        >
          Crear y editar
        </button>
        <a
          href={slug === "index" ? `${baseHref || "/"}` : `${baseHref}/${slug}/`}
          class="inline-flex items-center justify-center border border-[var(--grid-line-strong)] px-4 py-2 text-sm font-medium hover:bg-[var(--grid-line)]"
        >
          Cancelar
        </a>
      </div>
    </form>
  </div>
</Layout>
