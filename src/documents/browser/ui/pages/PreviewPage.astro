---
import Layout from "../../../../layouts/Layout.astro";
import { getApp } from "../../../../application/server/Application";
import type { Nanobook } from "../../../../nanobooks/server/domain/Nanobook";
import type { AuthenticatedUser } from "../../../../auth/browser/model/AuthSession";
import DocumentActionLink from "../components/DocumentActionLink.astro";

export const prerender = false;

const { slug } = Astro.params;
const app = await getApp();

interface Props {
  nanobook: Nanobook;
  user: AuthenticatedUser | null;
}

const { nanobook, user } = Astro.props;
const documentModule = app.nanobookModule.documentModule;
const { publishingModule, navigationModule } = app;
const nanobookId = nanobook.getId();
const theme = await app.themeModule.resolveTheme.execute(
  nanobook.getSettings().theme,
  Astro.request,
);
const navigationService = await navigationModule.getNavigation(nanobookId, {
  rootPath: "index",
  basePath: `/n/${nanobook.getSlug()}`,
});
if (!slug) return new Response("Document not found", { status: 404 });

const document = await documentModule.getDocument.execute(nanobookId, slug);
if (!document) throw new Error("Document not found");
const renderedPage = await publishingModule.pagePublisher.publish(document);
if (!renderedPage) throw new Error("Page not found");
const { rendered } = renderedPage;
const { entry } = rendered;
const documentId = entry.documentId;
const baseHref = `/n/${nanobook.getSlug()}`;
const viewHref = slug === "index" ? baseHref : `${baseHref}/${slug}/`;
---

<Layout
  session={user}
  navigationService={navigationService}
  theme={theme}
  navigationContext={{ section: "preview", book: { name: nanobook.getName(), href: `/n/${nanobook.getSlug()}` } }}
>
  <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-[var(--theme-border)] pb-6">
    <h1>Vista previa de {entry.title}</h1>
    <DocumentActionLink href={viewHref} label="Volver al documento" />
  </div>
  <div id="preview-container" data-document-id={documentId}></div>
</Layout>
