---
import Layout from "../../../../layouts/Layout.astro";
import { getApp } from "../../../../application/server/Application";

export const prerender = false;

const { slug } = Astro.params;
const app = await getApp();

interface Props {
  nanobookSlug?: string;
}

const { nanobookSlug } = Astro.props;
const nanobookContext = nanobookSlug
  ? await app.forNanobookSlug(nanobookSlug)
  : null;
if (nanobookSlug && !nanobookContext) {
  return new Response("Nanobook not found", { status: 404 });
}
const documentModule = nanobookContext?.documentModule ?? app.documentModule;
const publishingModule = nanobookContext?.publishingModule ?? app.publishingModule;
if (!slug) return new Response("Document not found", { status: 404 });

const document = await documentModule.getDocument.execute(slug);
if (!document) throw new Error("Document not found");
const renderedPage = await publishingModule.pagePublisher.publish(document);
if (!renderedPage) throw new Error("Page not found");
const { rendered } = renderedPage;
const { entry } = rendered;
const documentId = entry.documentId;
const baseHref = nanobookSlug ? `/n/${nanobookSlug}` : "";
const editHref = slug ? `${baseHref}/${slug}/edit` : `${baseHref}/edit`;
---

<Layout
  editHref={editHref}
  navigationService={nanobookContext?.navigationModule.navigationService}
>
  <h1><mark>Preview de {slug || "index"}</mark></h1>
  <div id="preview-container" data-document-id={documentId}></div>
</Layout>
