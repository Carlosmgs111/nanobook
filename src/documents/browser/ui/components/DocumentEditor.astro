---
import type { Entry } from "../../../server/domain/types";
import { serializeEntry } from "../../../server/application/dto/SerializedEntry";
import { hideProtectedFrontmatter } from "../../application/protectedFrontmatter";
import EditorToolbar from "./EditorToolbar.astro";
import EditorStatus from "./EditorStatus.astro";

interface Props {
  entry: Entry;
  previewHref?: string;
  viewHref?: string;
  parentHref?: string;
  frontmatterOnly?: boolean;
}

const { entry, previewHref, viewHref, parentHref, frontmatterOnly = false } = Astro.props;
const serializedEntry = serializeEntry(entry);
const editableRawFrontmatter = hideProtectedFrontmatter(entry.rawFrontmatter);
const initialContent = editableRawFrontmatter + entry.content;
---

<div class="editor-wrapper">
  <EditorToolbar
    previewHref={previewHref}
    viewHref={viewHref}
    documentId={entry.documentId}
    documentPath={entry.path}
    parentHref={parentHref}
    isDirectory={entry.isIndex}
  >
    <EditorStatus slot="status" />
  </EditorToolbar>
  <div
    data-document-id={entry.documentId}
    data-document={JSON.stringify(serializedEntry)}
    data-initial-content={frontmatterOnly ? editableRawFrontmatter : initialContent}
    data-frontmatter-only={frontmatterOnly ? "true" : "false"}
    class="editor-container"
    data-editor-container
  >
  </div>
</div>


<style>
  .editor-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 60vh;
  }

  .editor-container {
    flex: 1;
    width: 100%;
    min-height: 60vh;
    border: 1px solid var(--grid-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .editor-container :global(.cm-editor) {
    width: 100%;
    height: 100%;
    min-height: 60vh;
  }

  .editor-container :global(.cm-focused) {
    outline: none;
  }
</style>
