---
interface Props { href: string; label: string; primary?: boolean; ownerId?: string }
const { href, label, primary = false, ownerId } = Astro.props;
---

<a href={href} data-primary={primary} data-auth-owner-only={ownerId ? "true" : undefined} data-auth-owner-id={ownerId} hidden={Boolean(ownerId)} class:list={["document-action-link inline-flex min-h-10 shrink-0 items-center justify-center border px-3 py-2 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--theme-accent)]", primary ? "border-[var(--theme-accent)] bg-[var(--theme-accent)] hover:opacity-80" : "border-[var(--theme-border)] hover:border-[var(--theme-accent)]"]}>{label}</a>

<style>
  .document-action-link[data-primary="true"] {
    border-radius: var(--theme-control-radius);
    color: var(--theme-accent-text);
    text-decoration: none;
  }
  .document-action-link[data-primary="false"] {
    border-radius: var(--theme-control-radius);
    color: var(--theme-text);
    text-decoration: none;
  }
  .document-action-link[data-primary="false"]:hover {
    color: var(--theme-accent);
  }
</style>
