---
interface Props {
  message?: string;
  variant?: "success" | "error";
}

const { message, variant } = Astro.props;
---

<span
  class:list={["status", variant && `status-${variant}`]}
  role="status"
  aria-live="polite"
  data-edition-result
>
  {message}
</span>

<style>
  .status {
    min-height: 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .status-success {
    color: var(--theme-status-success);
  }

  .status-error {
    color: var(--theme-status-error);
  }
</style>
