---
interface Props {
  previewHref?: string;
  viewHref?: string;
  documentId?: string;
  documentPath?: string;
  parentHref?: string;
  isDirectory?: boolean;
}

const {
  previewHref,
  viewHref,
  documentId,
  documentPath,
  parentHref = "/",
  isDirectory = false,
} = Astro.props;
---

<div class="editor-toolbar">
  <button
    type="button"
    class="save-button"
    data-action="save"
    data-view-href={viewHref}
    data-document-id={documentId}
    >Guardar</button
  >
  <button
    type="button"
    class="delete-button"
    data-action="delete"
    data-parent-href={parentHref}
    data-is-directory={isDirectory ? "true" : "false"}
    data-document-id={documentId}
    >Eliminar</button
  >
  <button
    type="button"
    class="rename-button"
    data-action="rename"
    data-document-path={documentPath}
    data-document-id={documentId}
    >Renombrar</button
  >
  {
    previewHref && (
      <a class="preview-link" href={previewHref}>
        Preview
      </a>
    )
  }
  <slot name="status" />
</div>


<style>
  .editor-toolbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--theme-border-subtle);
  }

  .save-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--theme-border);
    background: var(--theme-text);
    color: var(--theme-page-bg);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .delete-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #b42318;
    background: transparent;
    color: #b42318;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .rename-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--theme-border);
    background: transparent;
    color: var(--theme-text);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .save-button:hover {
    opacity: 0.9;
  }

  .preview-link {
    color: var(--theme-text);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid var(--theme-text);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .preview-link:hover {
    opacity: 0.9;
  }
</style>
