---
import Breadcrumb from "../../../server/navigation/ui/components/Breadcrumb.astro";
import DocumentControls from "./DocumentControls.astro";
import OpenSidebar from "../../../server/navigation/ui/components/SidebarNav/OpenSidebar.astro";

interface Props {
  editHref?: string;
  viewHref?: string;
  newHref?: string;
  loginHref?: string;
}

const { editHref, viewHref, newHref, loginHref } = Astro.props;
const isProfilePage = Astro.url.pathname === "/profile";
---

<header
  class="sticky top-0 z-50 border-b border-[var(--grid-line-strong)] bg-[var(--bg)]/90 backdrop-blur-sm"
  data-auth-header
>
  <div
    id="header-inner"
    class="header-inner mx-auto flex w-full items-center justify-between gap-4 px-6 py-5"
    data-content-mode="constrained"
  >
    <OpenSidebar
      sidebarId="sidebar"
      backdropId="sidebar-backdrop"
      buttonId="sidebar-open"
    />
    <div class="min-w-0 flex-1">
      <Breadcrumb />
    </div>
    <div class="flex flex-shrink-0 items-center gap-2">
      <DocumentControls
        editHref={editHref}
        viewHref={viewHref}
        newHref={newHref}
      />
      <a
        href="/profile"
        data-auth-profile
        hidden
        class="inline-flex items-center justify-center bg-black px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-black/80 focus:outline-none focus:ring-2 focus:ring-[var(--accent)]/50"
      ></a>
      {
        loginHref && !isProfilePage && (
          <a
            href={loginHref}
            data-auth-login
            aria-label="Ingresar a tu cuenta"
            class="inline-flex items-center justify-center border border-[var(--grid-line-strong)] px-3 py-1.5 text-sm font-medium transition-colors hover:bg-[var(--grid-line)] focus:outline-none focus:ring-2 focus:ring-[var(--accent)]/50"
          >
            Ingresar
          </a>
        )
      }
    </div>
  </div>
</header>

<script>
  import { AuthStatusController } from "./AuthStatusController";
  import { getApp } from "../../Application";

  const app = getApp();

  const authStatusController = new AuthStatusController(
    app.authModule.getAuthenticatedSession
  );

  document.addEventListener("astro:page-load", () =>
    authStatusController.mount()
  );
  authStatusController.mount();
</script>

<style>
  .header-inner {
    max-width: 72rem;
  }
  .header-inner[data-content-mode="full"] {
    max-width: none;
  }
  @media (max-width: 1279px) {
    :global(#content-width-toggle) {
      display: none;
    }
  }
</style>
