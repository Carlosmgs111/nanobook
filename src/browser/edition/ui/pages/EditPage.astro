---
import DocumentEditor from "../components/DocumentEditor.astro";
import Layout from "../../../../browser/layouts/Layout.astro";
import { getApp } from "../../../../server/Application";

const app = await getApp();

export const prerender = false;

const slug = Astro.params.slug || "index";
if (!slug) return Astro.redirect("/404");
const document = await app.documentModule.getDocument.execute(slug);
if (!document) throw new Error("Document not found");
const renderedPage = await app.publishingModule.pagePublisher.publish(document);
if (!renderedPage) throw new Error("Page not found");
const { rendered } = renderedPage;
const { entry } = rendered;

if (!entry) {
  return new Response("Document not found!", { status: 404 });
}
const sourceDocument = entry.ref
  ? await app.documentModule.getDocument.executeRaw(slug)
  : null;
const editableEntry = sourceDocument?.parse() ?? entry;
const viewHref = `/${editableEntry.slug}`;
const previewHref = `/${editableEntry.slug}/preview`;
const newHref = editableEntry.isIndex ? `/${editableEntry.slug}/new` : "/new";
const parentHref = editableEntry.parentPath
  ? `/${editableEntry.parentPath}`
  : "/";
---

<Layout
  title={`Editar: ${editableEntry.title}`}
  description={editableEntry.description}
  hideToc={true}
  viewHref={viewHref}
  newHref={newHref}
>
  <div class="mb-10 border-b border-[var(--grid-line-strong)] pb-8">
    <span class="tech-label mb-3 block">Editing document</span>
    <h1
      class="glow-text text-3xl font-semibold tracking-tight text-[var(--accent)] md:text-4xl"
    >
      {entry.title}
    </h1>
  </div>

  {
    entry.ref && (
      <div
        class="mb-4 border border-[var(--grid-line-strong)] bg-[var(--bg-elevated)] p-6 text-[var(--muted)]"
        role="status"
      >
        <h2 class="mb-3 text-lg font-semibold text-[var(--accent)]">
          Proxy: solo se edita el frontmatter
        </h2>
        <p>
          Este documento muestra el contenido de <code>{entry.ref}</code>. El
          cuerpo referenciado no se carga ni se puede modificar desde aquí.
        </p>
        <p class="mt-3">
          Puedes cambiar el título, descripción y demás metadatos del proxy.
          Edita el documento original si necesitas cambiar el contenido
          mostrado.
        </p>
      </div>
    )
  }

  <DocumentEditor
    entry={entry}
    previewHref={entry.ref ? undefined : previewHref}
    viewHref={viewHref}
    parentHref={parentHref}
    frontmatterOnly={Boolean(entry.ref)}
  />
</Layout>
