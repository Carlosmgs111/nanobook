---
import Layout from "../../../../browser/layouts/Layout.astro";
import { getApp } from "../../../../server/Application";

export const prerender = false;

const { slug } = Astro.params;
const app = await getApp();
if (!slug) return new Response("Document not found", { status: 404 });

const document = await app.documentModule.getDocument.execute(slug);
if (!document) throw new Error("Document not found");
const renderedPage = await app.publishingModule.pagePublisher.publish(document);
if (!renderedPage) throw new Error("Page not found");
const { rendered } = renderedPage;
const { entry } = rendered;
const documentId = entry.documentId;
const editHref = slug ? `/${slug}/edit` : "/edit";
---

<Layout editHref={editHref}>
  <h1><mark>Preview de {slug || "index"}</mark></h1>
  <div id="preview-container" data-document-id={documentId}></div>
</Layout>

<script>
  import { Result } from "../../../../shared/domain/Result";
  import { getApp } from "../../../Application";
  import { DocumentChanged } from "../../index";

  const app = getApp();

  async function renderPreview() {
    const container = document.getElementById("preview-container") as
      | HTMLElement
      | undefined;

    if (!container) throw new Error("Missing preview container");

    function setRenderedPage(pageId: string, container: HTMLElement) {
      const renderedResult =
        app.editionModule.getRenderedDocument.execute(pageId);
      if (!renderedResult.isSuccess) {
        console.error(renderedResult.getError());
        return;
      }
      const renderedContent = renderedResult.getValue();
      const { rendered } = renderedContent;
      container.innerHTML = rendered.Content;
    }
    setRenderedPage(container.dataset.documentId as string, container);
    app.editionModule.eventBus.subscribe(DocumentChanged, {
      async handle(event) {
        setRenderedPage(event.documentId as string, container);
        return Result.ok();
      },
    });
  }

  document.addEventListener("astro:page-load", renderPreview);
</script>
