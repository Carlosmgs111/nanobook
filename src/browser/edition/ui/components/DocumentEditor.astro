---
import type { Entry } from "../../../../server/documents/domain/types";
import { serializeEntry } from "../../../../server/documents/application/dto/SerializedEntry";
import { hideProtectedFrontmatter } from "../../application/protectedFrontmatter";
import EditorToolbar from "./EditorToolbar.astro";
import EditorStatus from "./EditorStatus.astro";

interface Props {
  entry: Entry;
  previewHref?: string;
  viewHref?: string;
  parentHref?: string;
  frontmatterOnly?: boolean;
}

const { entry, previewHref, viewHref, parentHref, frontmatterOnly = false } = Astro.props;
const serializedEntry = serializeEntry(entry);
const editableRawFrontmatter = hideProtectedFrontmatter(entry.rawFrontmatter);
const initialContent = editableRawFrontmatter + entry.content;
---

<div class="editor-wrapper">
  <EditorToolbar
    previewHref={previewHref}
    viewHref={viewHref}
    documentId={entry.documentId}
    documentPath={entry.path}
    parentHref={parentHref}
    isDirectory={entry.isIndex}
  >
    <EditorStatus slot="status" />
  </EditorToolbar>
  <div
    data-document-id={entry.documentId}
    data-document={JSON.stringify(serializedEntry)}
    data-initial-content={frontmatterOnly ? editableRawFrontmatter : initialContent}
    data-frontmatter-only={frontmatterOnly ? "true" : "false"}
    class="editor-container"
    data-editor-container
  >
  </div>
</div>

<script>
  import { edition } from "../../index";
  import { hideProtectedFrontmatter } from "../../application/protectedFrontmatter";
  import { basicSetup } from "codemirror";
  import { EditorView, keymap } from "@codemirror/view";
  import { EditorState } from "@codemirror/state";
  import { markdown } from "@codemirror/lang-markdown";
  import { indentWithTab } from "@codemirror/commands";
  import { debounce } from "../../../../shared/utils/debounce";

  let view: EditorView | undefined;
  const debouncedHandleEditorChange = debounce(
    async (document, content, preserveSourceBody) => {
    if (edition.handleEditorChange) {
      const result = await edition.handleEditorChange.execute(
        document,
        content,
        preserveSourceBody
      );
      if (!result.isSuccess) {
        console.error(result.getError());
        return;
      }
      edition.renderPreview.execute(result.getValue().documentId);
    }
    },
    1000
  );

  document.addEventListener("astro:page-load", () => {
    let container = document.querySelector<HTMLElement>(
      "[data-editor-container]"
    );
    if (!container) {
      return;
    }
    let initialContent = container.dataset.initialContent;
    const frontmatterOnly = container.dataset.frontmatterOnly === "true";
    const baseDocument = container.dataset.document;
    if (!baseDocument) {
      console.error("Missing base document");
      return;
    }
    const updateListener = EditorView.updateListener.of((update) => {
      if (update.docChanged) {
        debouncedHandleEditorChange(
          JSON.parse(baseDocument),
          update.state.doc.toString(),
          frontmatterOnly
        );
      }
    });
    function initializeCodeMirror(container: HTMLElement) {
      const originalBody = extractBody(initialContent ?? "");
      const state = EditorState.create({
        doc: initialContent,
        extensions: [
          basicSetup,
          markdown(),
          keymap.of([indentWithTab]),
          ...(frontmatterOnly
            ? [
                EditorState.transactionFilter.of((transaction) =>
                  !transaction.docChanged ||
                  extractBody(transaction.newDoc.toString()) === originalBody
                    ? transaction
                    : []
                ),
              ]
            : []),
          updateListener,
          EditorView.theme({
            "&": {
              fontSize: "14px",
              minHeight: "60vh",
            },
            ".cm-content": {
              fontFamily:
                'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace',
              lineHeight: "1.6",
            },
            ".cm-gutters": {
              backgroundColor: "transparent",
              borderRight: "1px solid var(--grid-line)",
            },
            ".cm-activeLineGutter": {
              backgroundColor: "var(--grid-line)",
            },
          }),
          EditorView.lineWrapping,
        ],
      });

      view = new EditorView({
        state,
        parent: container,
      });
    }
    const stagedDocument = edition.initializeEditor
      .execute(JSON.parse(baseDocument))
      .getValue();
    if (stagedDocument) {
      initialContent =
        hideProtectedFrontmatter(stagedDocument.rawFrontmatter) +
        (frontmatterOnly ? "" : stagedDocument.content);
    }
    initializeCodeMirror(container);
  });
  document.addEventListener("astro:before-swap", () => {
    view?.destroy();
    // view = undefined;
  });

  function extractBody(content: string): string {
    return content.replace(/^---[\s\S]*?---\n?/, "");
  }
</script>

<style>
  .editor-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 60vh;
  }

  .editor-container {
    flex: 1;
    width: 100%;
    min-height: 60vh;
    border: 1px solid var(--grid-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .editor-container :global(.cm-editor) {
    width: 100%;
    height: 100%;
    min-height: 60vh;
  }

  .editor-container :global(.cm-focused) {
    outline: none;
  }
</style>
