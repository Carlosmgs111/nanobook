<script>
  import { HttpAuthApi, type AuthApi } from "./HttpAuthApi";
  import { CachedAuthSessionReader } from "./CachedAuthSessionReader";
  import { SessionCachingAuthApi } from "./SessionCachingAuthApi";
  import { HttpAuthSessionReader } from "./HttpAuthSessionReader";
  import { BrowserToastNotifier } from "../toast/BrowserToastNotifier";
  import { navigate } from "astro:transitions/client";

  type AuthFormMode = "login" | "signup";

  class AuthFormModeCapability {
    isVisible(
      fieldMode: string | undefined,
      selectedMode: AuthFormMode
    ): boolean {
      return fieldMode === selectedMode;
    }
  }

  const copyByMode: Record<AuthFormMode, string> = {
    login: "Ingresa para volver a tus documentos.",
    signup: "Guarda tu espacio de escritura en un solo lugar.",
  };

  const titleByMode: Record<AuthFormMode, string> = {
    login: "Bienvenido de nuevo",
    signup: "Crea tu cuenta",
  };

  const submitLabelByMode: Record<AuthFormMode, string> = {
    login: "Ingresar",
    signup: "Crear cuenta",
  };

  const httpApi = new HttpAuthApi();
  const httpSessionReader = new HttpAuthSessionReader();
  const cache = new CachedAuthSessionReader(httpSessionReader);
  // TODO: refactor to capabilities
  export class AuthFormController {
    private readonly formMode = new AuthFormModeCapability();
    private root: HTMLElement | undefined;

    constructor(
      private authApi: AuthApi = new SessionCachingAuthApi(httpApi, cache),
      private toast: BrowserToastNotifier = new BrowserToastNotifier(
        "auth-flow"
      )
    ) {
      this.root = this.getRoot();
      if (this.root.dataset.authFormReady === "true") return;
      this.root.dataset.authFormReady = "true";

      this.root
        .querySelectorAll<HTMLButtonElement>("[data-auth-mode]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            this.setMode(this.readMode(button.dataset.authMode));
          });
        });

      const form =
        this.root.querySelector<HTMLFormElement>(".auth-form__fields");
      form?.addEventListener("submit", async (event) => {
        await this.submit(event);
      });

      const githubButton = this.root.querySelector<HTMLButtonElement>(
        '[data-auth-provider="github"]'
      );
      githubButton?.addEventListener("click", () => {
        void this.submitGitHub(githubButton);
      });

      this.setMode(this.readMode(this.getRoot().dataset.mode));
    }

    private getRoot() {
      if (!this.root)
        return document.querySelectorAll<HTMLElement>("[data-auth-form]")[0];
      return this.root;
    }
    private setMode(mode: AuthFormMode): void {
      const root = this.getRoot();
      root.dataset.mode = mode;

      root
        .querySelectorAll<HTMLElement>("[data-auth-mode]")
        .forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            String(button.dataset.authMode === mode)
          );
        });

      root
        .querySelectorAll<HTMLElement>("[data-auth-only]")
        .forEach((field) => {
          const visible = this.formMode.isVisible(field.dataset.authOnly, mode);
          field.hidden = !visible;
          field.querySelectorAll<HTMLInputElement>("input").forEach((input) => {
            input.required = visible;
            input.disabled = !visible;
          });
        });

      this.setText("#auth-form-title", titleByMode[mode]);
      this.setText("[data-auth-copy]", copyByMode[mode]);
      this.setText("[data-auth-submit]", submitLabelByMode[mode]);

      const password = root.querySelector<HTMLInputElement>("#auth-password");
      if (password)
        password.autocomplete =
          mode === "signup" ? "new-password" : "current-password";
    }

    private async submit(event: SubmitEvent): Promise<void> {
      event.preventDefault();
      const mode = this.readMode(this.getRoot().dataset.mode);
      const email = this.readValue("#auth-email");
      const password = this.readValue("#auth-password");
      const name = this.readValue("#auth-name");
      const confirmPassword = this.readValue("#auth-confirm-password");

      if (mode === "signup" && password !== confirmPassword) {
        this.toast?.show("Las contraseñas no coinciden.", "error");
        return;
      }

      this.setSubmitting(true);
      this.toast?.show(
        mode === "signup" ? "Creando tu cuenta…" : "Ingresando…",
        "loading"
      );

      try {
        if (mode === "signup") {
          await this.authApi.signUp({
            name,
            email,
            password,
          });
          this.toast?.show(
            "Revisa tu correo para activar tu cuenta.",
            "success"
          );
          navigate("/verify-email");
          return;
        } else {
          await this.authApi.signIn({
            email,
            password,
          });
        }
        this.toast?.show("Sesión iniciada. Redirigiendo…", "success");
        navigate("/");
      } catch (error) {
        console.error(error);
        this.toast?.show(
          error instanceof Error
            ? error.message
            : "No fue posible autenticarte. 🙃",
          "error"
        );
      } finally {
        this.setSubmitting(false);
      }
    }

    private async submitGitHub(button: HTMLButtonElement): Promise<void> {
      button.disabled = true;
      this.toast?.show("Conectando con GitHub…", "loading");

      try {
        const { authorizationUrl } = await this.authApi.signInWithGitHub();
        navigate(authorizationUrl);
      } catch (error) {
        this.toast?.show(
          error instanceof Error
            ? error.message
            : "No fue posible autenticarte.",
          "error"
        );
        button.disabled = false;
      }
    }

    private readValue(selector: string): string {
      return (
        this.getRoot()
          .querySelector<HTMLInputElement>(selector)
          ?.value.trim() ?? ""
      );
    }

    private readMode(mode: string | undefined): AuthFormMode {
      return mode === "signup" ? "signup" : "login";
    }

    private setText(selector: string, value: string): void {
      const element = this.getRoot().querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    }

    private setSubmitting(isSubmitting: boolean): void {
      this.getRoot().setAttribute("aria-busy", String(isSubmitting));
      const submit =
        this.getRoot().querySelector<HTMLButtonElement>("[data-auth-submit]");
      if (submit) submit.disabled = isSubmitting;
    }
  }
  const controller = new AuthFormController();
  // document.addEventListener("astro:page-load", () => controller.mount());
</script>
