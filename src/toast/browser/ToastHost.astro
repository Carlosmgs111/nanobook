<div class="toast-host" data-toast-host aria-label="Notificaciones"></div>

<template data-toast-template>
  <article class="toast-host__item" data-kind="info" role="status">
    <p class="toast-host__message"></p>
    <button class="toast-host__close" type="button" aria-label="Cerrar notificación">×</button>
  </article>
</template>

<script>
  import type { ToastKind } from "./BrowserToastNotifier";

  interface ShowToastEvent {
    operation: "show";
    id: string;
    kind: ToastKind;
    message: string;
    duration: number;
  }

  interface DismissToastEvent {
    operation: "dismiss";
    id: string;
  }

  type ToastEventDetail = ShowToastEvent | DismissToastEvent;

  interface ToastEntry {
    element: HTMLElement;
    timer?: number;
  }

  const entries = new Map<string, ToastEntry>();
  const template = document.querySelector<HTMLTemplateElement>("[data-toast-template]");

  function dismiss(id: string) {
    const entry = entries.get(id);
    if (!entry) return;
    if (entry.timer !== undefined) window.clearTimeout(entry.timer);
    entry.element.remove();
    entries.delete(id);
  }

  function show(host: HTMLElement, detail: ShowToastEvent) {
    if (!template) return;

    dismiss(detail.id);

    const element = template.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
    if (!element) return;

    element.dataset.kind = detail.kind;
    element.dataset.toastId = detail.id;
    element.setAttribute("role", detail.kind === "error" ? "alert" : "status");

    const message = element.querySelector<HTMLElement>(".toast-host__message");
    const close = element.querySelector<HTMLButtonElement>(".toast-host__close");
    if (!message || !close) return;

    message.textContent = detail.message;
    close.addEventListener("click", () => dismiss(detail.id));
    host.append(element);

    const entry: ToastEntry = { element };
    if (detail.duration > 0) {
      entry.timer = window.setTimeout(() => dismiss(detail.id), detail.duration);
    }
    entries.set(detail.id, entry);
  }

  function handleToastEvent(event: Event) {
    const host = document.querySelector<HTMLElement>("[data-toast-host]");
    if (!host) return;

    const detail = (event as CustomEvent<ToastEventDetail>).detail;
    if (detail.operation === "dismiss") {
      dismiss(detail.id);
      return;
    }

    show(host, detail);
  }

  document.addEventListener("nanobook:toast", handleToastEvent);
</script>

<style>
  .toast-host {
    position: fixed;
    z-index: 100;
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    display: grid;
    width: min(26rem, calc(100vw - 2rem));
    gap: 0.75rem;
    pointer-events: none;
  }

  .toast-host__item {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--theme-border);
    border-left: 3px solid var(--theme-text);
    padding: 1rem 1.125rem;
    color: var(--theme-text);
    background: var(--theme-page-bg);
    box-shadow: 8px 8px 0 var(--theme-border-subtle);
    pointer-events: auto;
    animation: toast-enter 160ms ease-out;
  }

  .toast-host__item[data-kind="loading"],
  .toast-host__item[data-kind="info"] {
    border-left-color: var(--theme-text-muted);
  }

  .toast-host__item[data-kind="error"] {
    border-left-color: #e06c75;
  }

  .toast-host__message {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .toast-host__close {
    flex: none;
    border: 0;
    padding: 0 0.15rem;
    color: var(--theme-text-muted);
    background: transparent;
    font: inherit;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .toast-host__close:hover,
  .toast-host__close:focus-visible {
    color: var(--theme-text);
  }

  .toast-host__close:focus-visible {
    outline: 2px solid var(--theme-text);
    outline-offset: 3px;
  }

  @keyframes toast-enter {
    from {
      opacity: 0;
      transform: translateY(-0.35rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toast-host__item {
      animation: none;
    }
  }
</style>
