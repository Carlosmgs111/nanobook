---
import "../../../../shared/styles/components/index-card.css";
import FolderSvg from "../../../../shared/icons/folder.svg";
import FileSvg from "../../../../shared/icons/file.svg";
const { page, index } = Astro.props;
const coverVar = page.metadata.cover ? `url('${page.metadata.cover}')` : undefined;
---

<div class="index-card-wrapper" data-folder={String(page.metadata.index)}>
  <a
    href={`/${page.path}`}
    class={`index-card ${page.metadata.index ? "index-card-folder corner-L-sm" : "corner-plus-sm"}`}
    data-title={page.metadata.title}
    data-description={page.metadata.description}
    data-draft={String(page.metadata.draft)}
    data-cover={page.metadata.cover ? "true" : undefined}
    style={coverVar ? `--card-cover: ${coverVar}` : undefined}
  >
    <div class="index-card-main">
      <span class="index-card-number">
        {String(index + 1).padStart(2, "0")}
      </span>
      {page.metadata.index ? <FolderSvg /> : <FileSvg />}
      <div class="index-card-body">
        <span class="index-card-title" data-title={page.metadata.title}></span>
        <span class="index-card-desc" data-description={page.metadata.description}></span>
      </div>
    </div>

    <span class="index-card-path" title={`/${page.path + (page.metadata.index ? "/" : ".md")}`}>
      /{page.path + (page.metadata.index ? "/" : ".md")}
    </span>
  </a>
</div>

<style>
  .index-card-wrapper {
    position: relative;
  }

  .index-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid var(--grid-line-strong);
    padding: 1rem;
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .index-card span{
    backdrop-filter: blur(5px) brightness(0.9);
    padding: 0.5rem 1rem;
    color: var(--text);
  }

  .index-card:hover {
    border-color: var(--accent);
    background-color: rgba(var(--surface-rgb), 0.05);
  }

  .index-card-folder {
    border-right-width: 2px;
    border-right-color: var(--accent);
  }

  .index-card-main {
    display: flex;
    gap: 0.75rem;
  }

  .index-card-number {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--muted);
  }

  .index-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .index-card-title {
    display: block;
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 500;
    color: var(--text);
    transition: color 150ms ease;
  }

  .index-card:hover .index-card-title {
    color: var(--accent);
  }

  .index-card-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--muted);
  }

  .index-card-path {
    align-self: flex-end;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .index-card {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      padding: 1.25rem;
    }

    .index-card-body {
      flex: 1 1 0%;
    }

    .index-card-title {
      font-size: 1.125rem;
      line-height: 1.75rem;
    }

    .index-card-desc {
      -webkit-line-clamp: unset;
    }

    .index-card-path {
      align-self: auto;
    }
  }
</style>
