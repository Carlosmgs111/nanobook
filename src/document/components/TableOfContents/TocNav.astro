---
import TocToggle from "./TocToggle.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  tocRootId: string;
  tocNavId: string;
  toggleId: string;
}

const { headings, tocRootId, tocNavId, toggleId } = Astro.props;
---

<nav id={tocNavId} class="toc-nav" aria-label="En esta página">
  <div class="toc-nav-header">
    <span class="tech-label block w-full">En esta página</span>
    <TocToggle toggleId={toggleId} tocRootId={tocRootId} />
  </div>
  <ul class="space-y-1 border-l border-[var(--grid-line-strong)]">
    {
      headings.map((heading) => (
        <li
          class="toc-item"
          data-depth={heading.depth}
          data-slug={heading.slug}
          style={`padding-left: ${(heading.depth - 2) * 0.75}rem`}
        >
          <a href={`#${heading.slug}`} class="block py-1 pl-3 text-sm">
            {heading.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script type="module" define:vars={{ tocRootId, tocNavId }}>
  import { findActiveIndex } from "/src/document/core/scroll-spy";

  let abortController = null;

  document.addEventListener("astro:page-load", function () {
    const root = document.getElementById(tocRootId);
    const tocNav = document.getElementById(tocNavId);
    if (!root || !tocNav) return;

    if (abortController) abortController.abort();
    abortController = new AbortController();
    const { signal } = abortController;

    const tocLinks = tocNav.querySelectorAll('.toc-item a[href^="#"]');

    function collectHeadings(links) {
      const headings = [];
      links.forEach((link) => {
        const href = link.getAttribute("href");
        if (!href || !href.startsWith("#")) return;
        const heading = document.getElementById(href.slice(1));
        if (heading) {
          headings.push({ id: heading.id, element: heading });
        }
      });
      return headings;
    }

    function updateActiveState(
      links,
      headings,
      offsets,
      offset,
      activeIndexRef
    ) {
      const newIndex = findActiveIndex(window.scrollY, offsets, offset);
      if (newIndex === activeIndexRef.current) return;
      activeIndexRef.current = newIndex;

      const activeId = headings[newIndex].id;

      links.forEach((link) => {
        link.dataset.isActive = String(
          link.getAttribute("href") === "#" + activeId
        );
      });

      root._tocActiveId = activeId;
      root.dispatchEvent(
        new CustomEvent("toc:active", { detail: { activeId } })
      );
    }

    function initScrollSpy(links, offset = 120) {
      if (links.length === 0) return;

      const headings = collectHeadings(links);

      root._tocHeadings = headings;
      root.dispatchEvent(
        new CustomEvent("toc:headings", { detail: { headings } })
      );
      if (headings.length === 0) return;

      let offsets = [];
      const activeIndex = { current: -1 };

      function measure() {
        offsets = headings.map((heading) => heading.element.offsetTop);
        updateActiveState(links, headings, offsets, offset, activeIndex);
      }

      function onScroll() {
        updateActiveState(links, headings, offsets, offset, activeIndex);
      }

      let ticking = false;
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              onScroll();
              ticking = false;
            });
            ticking = true;
          }
        },
        { signal }
      );

      window.addEventListener("resize", measure, { signal });
      window.addEventListener("orientationchange", measure, { signal });

      measure();
    }

    initScrollSpy(tocLinks);
  });
</script>

<style>
  .toc-nav {
    padding: 1rem;
    border: 1px solid var(--grid-line-strong);
    background: var(--layer-1);
    max-height: calc(100vh - 10rem);
    overflow-y: auto;
    width: 18rem;
  }

  :global(#toc-root[data-toc-mode="compact"]) .toc-nav {
    display: block;
    position: absolute;
    right: 100%;
    top: 0;
    width: 220px;
    min-height: 100%;
    padding: 0.5rem;
    background: rgba(var(--surface-rgb), 0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--grid-line-strong);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    opacity: 0;
    visibility: hidden;
    transform: translateX(8px);
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 150ms ease;
  }

  :global(#toc-root[data-toc-mode="compact"]:hover) .toc-nav,
  :global(#toc-root[data-toc-mode="compact"]:focus-within) .toc-nav {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  :global(#toc-root[data-toc-mode="compact"]) .toc-nav::-webkit-scrollbar {
    width: 4px;
  }

  :global(#toc-root[data-toc-mode="compact"])
    .toc-nav::-webkit-scrollbar-track {
    background: transparent;
  }

  :global(#toc-root[data-toc-mode="compact"])
    .toc-nav::-webkit-scrollbar-thumb {
    background: var(--grid-line-strong);
    border-radius: 2px;
  }

  :global(#toc-root[data-toc-mode="compact"])
    .toc-nav::-webkit-scrollbar-thumb:hover {
    background: var(--muted);
  }

  .toc-nav-header {
    display: flex;
    align-items: flex-end;
    padding: 0.5rem;
  }

  :global(#toc-root[data-toc-mode="compact"]) .toc-nav-header {
    position: sticky;
    top: 0;
    z-index: 10;
    gap: 0.5rem;
    background-color: #2c2c2ce2;
    border-bottom: 1px solid var(--grid-line-strong);
  }

  :global(#toc-root[data-toc-mode="compact"]) .toc-nav ul {
    border-left: none;
    gap: 0;
  }

  :global(#toc-root[data-toc-mode="compact"]) .toc-item {
    padding-left: 0 !important;
  }

  :global(#toc-root[data-toc-mode="compact"]) .toc-item a {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1rem;
    border-left-width: 1px;
  }

  :global(#toc-root[data-toc-mode="compact"])
    .toc-item
    a[data-is-active="true"] {
    border-left-width: 2px;
  }

  .toc-item a {
    border-left: 2px solid transparent;
    color: var(--muted);
    background: unset;
  }

  .toc-item a:hover {
    border-left-color: var(--grid-line-strong);
    color: var(--text);
  }

  .toc-item a[data-is-active="true"] {
    border-left: 2px solid var(--accent);
    color: var(--text);
    background: #ffffff0d;
  }

  .toc-item a[data-is-active="true"]:hover {
    border-left-color: var(--accent);
  }
</style>
