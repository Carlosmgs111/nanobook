---
import DocumentIndex from "./DocumentIndex.astro";

interface Entry {
  id: string;
  data: {
    title: string;
    description: string;
    draft: boolean;
    index: boolean;
    position?: number;
    art?: string;
  };
}

interface Props {
  title: string;
  description?: string;
  label?: string;
  entries: Entry[];
  art?: string;
}

const { title, description, label = "Index", entries, art } = Astro.props;

const sortedEntries = entries
  .filter((page) => !page.data.draft)
  .sort((a, b) => {
    const posA = a.data.position ?? 0;
    const posB = b.data.position ?? 0;
    if (posA !== posB) return posA - posB;
    return a.data.title.localeCompare(b.data.title);
  });
---

<div class="mb-12 border-b border-[var(--grid-line-strong)] pb-8">
  <span class="tech-label mb-3 block">{label}</span>
  <h1
    class="glow-text text-4xl font-semibold tracking-tight text-[var(--accent)] md:text-5xl"
  >
    {title}
  </h1>
  {description && <p class="mt-4 text-[var(--muted)]">{description}</p>}
</div>

<div class="index-panel relative space-y-4">
  {sortedEntries.map((page, index) => <DocumentIndex page={page} index={index} />)}
</div>

{
  sortedEntries.length === 0 && (
    <div class="border border-[var(--grid-line-strong)] p-8 text-center text-[var(--muted)]">
      <p>No entries found.</p>
    </div>
  )
}
