---
import Layout from "@/layouts/Layout.astro";
import IndexList from "@/documentIndex/components/IndexList.astro";
import type { NavigationNode } from "@/navigation/core/builder";
import type { Crumb } from "@/navigation/components/Breadcrumb.astro";
import type { Document } from "@/document/core/types";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface ParentEntry {
  id: string;
  data: {
    title: string;
  };
}

interface Props {
  entry: Document;
  Content: any;
  headings: Heading[];
  childEntries: { id: string; data: Document["metadata"] }[];
  breadcrumbs: Crumb[];
  sidebarEntries: NavigationNode[];
  parentEntry: ParentEntry | null;
  editHref?: string;
}

export const prerender = true;

export async function getStaticPaths() {
  const { AstroCollectionRepository } = await import(
    "@/document/adapters/astro-collection-repository"
  );
  const repo = new AstroCollectionRepository();
  const documents = await repo.list();

  return documents.map((document) => ({
    params: { slug: document.slug || undefined },
    props: { documentId: document.id },
  }));
}

const {
  entry,
  Content,
  headings,
  childEntries,
  breadcrumbs,
  sidebarEntries,
  parentEntry,
  editHref,
} = Astro.props;
---

<Layout
  title={entry.title}
  description={entry.description}
  label={entry.metadata.index ? "Index" : "Document"}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  headings={headings}
  editHref={editHref}
>
  {
    entry.metadata.index ? (
      <IndexList
        title={entry.title}
        description={entry.description}
        label="Index"
        entries={childEntries}
      />
    ) : (
      <>
        <div class="mb-10 border-b border-[var(--grid-line-strong)] pb-8">
          <span class="tech-label mb-3 block">Document</span>
          <h1 class="glow-text text-4xl font-semibold tracking-tight text-[var(--accent)] md:text-5xl">
            {entry.title}
          </h1>
        </div>

        <div class="mb-12 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 border border-[var(--grid-line-strong)] bg-[var(--bg-elevated)] px-4 py-3 font-mono text-xs text-[var(--muted)]">
          <span>ID: {entry.id}</span>
          <span class="hidden text-[var(--grid-line-strong)] sm:inline">|</span>
          <span class="text-sm">
            DATE: {entry.metadata.date.toISOString().slice(0, 10)}
          </span>
          <span class="hidden text-[var(--grid-line-strong)] sm:inline">|</span>
          <span>AUTHOR: {entry.metadata.author}</span>
        </div>
        <Fragment set:html={Content} />
      </>
    )
  }
</Layout>
