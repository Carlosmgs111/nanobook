---
interface Props {
  initialMessage?: string;
}

const { initialMessage = "Cargando perfil…" } = Astro.props;
---

<div
  id="profile-status"
  data-profile-status
  data-state="loading"
  class="min-h-6 text-sm text-[var(--muted)]"
  role="status"
  aria-live="polite"
>
  {initialMessage}
</div>
