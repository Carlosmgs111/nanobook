---
import ProfileStatus from "./ProfileStatus.astro";

interface Props {
  userId: string;
}

const { userId } = Astro.props;
---

<section
  data-profile-root
  data-user-id={userId}
  class="border border-[var(--grid-line-strong)] bg-[var(--layer-1)] p-6 md:p-8"
  aria-labelledby="profile-form-title"
>
  <div class="mb-8">
    <div
      class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--muted)]"
    >
      Cuenta
    </div>
    <h2 id="profile-form-title" class="mt-2 text-xl font-semibold">
      Datos personales
    </h2>
    <p class="mt-2 text-sm text-[var(--muted)]">
      Actualiza la información que se muestra en tu perfil.
    </p>
  </div>

  <form novalidate class="grid gap-5">
    <div class="grid gap-2">
      <label for="profile-email" class="text-sm font-medium">Email</label>
      <input
        id="profile-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        disabled
        aria-describedby="profile-status"
        class="border border-[var(--grid-line-strong)] bg-[var(--bg)] px-3 py-2.5 text-[var(--text)] outline-none transition focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/30 disabled:cursor-wait disabled:opacity-60"
      />
    </div>

    <div class="grid gap-2">
      <label for="profile-display-name" class="text-sm font-medium"
        >Nombre visible</label
      >
      <input
        id="profile-display-name"
        name="displayName"
        type="text"
        autocomplete="name"
        required
        disabled
        aria-describedby="profile-status"
        class="border border-[var(--grid-line-strong)] bg-[var(--bg)] px-3 py-2.5 text-[var(--text)] outline-none transition focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/30 disabled:cursor-wait disabled:opacity-60"
      />
    </div>

    <div class="flex flex-wrap items-center gap-3 pt-2">
      <button
        type="submit"
        disabled
        class="inline-flex min-h-10 items-center justify-center border border-[var(--text)] bg-[var(--text)] px-4 py-2 text-sm font-medium text-[var(--bg)] transition hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-[var(--accent)]/50 disabled:cursor-wait disabled:opacity-50"
      >
        Guardar cambios
      </button>
      <button
        type="button"
        data-profile-retry
        hidden
        class="inline-flex min-h-10 items-center justify-center border border-[var(--grid-line-strong)] px-4 py-2 text-sm font-medium transition hover:bg-[var(--grid-line)] focus:outline-none focus:ring-2 focus:ring-[var(--accent)]/50"
      >
        Reintentar
      </button>
      <ProfileStatus />
    </div>
  </form>
</section>

<script>
  import { mountUserProfileForm } from "../../client/profile-controller";

  let cleanup: (() => void) | undefined;

  const mount = () => {
    cleanup?.();
    cleanup = undefined;
    const root = document.querySelector<HTMLElement>("[data-profile-root]");
    if (!root) return;
    const userId = root.dataset.userId;
    const form = root.querySelector<HTMLFormElement>("form");
    const emailInput = root.querySelector<HTMLInputElement>(
      'input[name="email"]'
    );
    const displayNameInput = root.querySelector<HTMLInputElement>(
      'input[name="displayName"]'
    );
    const submitButton = root.querySelector<HTMLButtonElement>(
      'button[type="submit"]'
    );
    const status = root.querySelector<HTMLElement>("[data-profile-status]");
    const retryButton = root.querySelector<HTMLButtonElement>(
      "[data-profile-retry]"
    );
    if (!root || !userId) return;
    cleanup = mountUserProfileForm(root, userId);
  };

  document.addEventListener("astro:page-load", mount);
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
