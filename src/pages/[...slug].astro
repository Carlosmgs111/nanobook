---
export { getStaticPaths, prerender } from "@/document/pages/document.astro";
import DocumentPage from "@/document/pages/document.astro";
import { AstroCollectionRepository } from "@/document/adapters/astro-collection-repository";
import { UnifiedMarkdownRenderer } from "@/rendering/adapters/unified-markdown";
import {
  buildNavigationTree,
  getFolderPath,
  getImmediateChildren,
  getBreadcrumbs,
  getSidebarEntries,
  getParentEntry,
} from "@/navigation/core/builder";
import { parseDocument } from "@/document/core/document";

const documentId = Astro.props.documentId ?? (Astro.params.slug || "index");

const repository = new AstroCollectionRepository();
const renderer = new UnifiedMarkdownRenderer();
const entry = await repository.get(documentId);

if (!entry) {
  throw new Error(`Document not found: ${documentId}`);
}

const { Content } = await renderer.render(entry);
const allDocuments = await repository.list();
const { nodeMap } = buildNavigationTree(allDocuments);

const folderPath = getFolderPath(entry.id);
const children = entry.metadata.index
  ? getImmediateChildren(nodeMap, folderPath, entry.id)
  : [];

const childEntries = children.map((child) => ({
  id: child.id,
  data: child.metadata,
}));

const breadcrumbs = getBreadcrumbs(nodeMap, entry.id);
const sidebarEntries = getSidebarEntries(nodeMap, entry.id);
const parentNode = getParentEntry(nodeMap, entry.id);
const { headings } = parseDocument({ body: entry.content });
const editHref = entry.metadata.index ? undefined : `/${entry.slug}/edit`;
---

<DocumentPage
  entry={entry}
  Content={Content}
  headings={headings}
  childEntries={childEntries}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentNode
    ? { id: parentNode.id, data: { title: parentNode.title } }
    : null}
  editHref={editHref}
/>
