---
import Layout from "../layouts/Layout.astro";
import IndexList from "../components/IndexList.astro";
import { getCollection, render } from "astro:content";
import {
  getStaticSlug,
  getFolderPath,
  getImmediateChildren,
  getBreadcrumbs,
  getSidebarEntries,
  getParentEntry,
} from "../lib/content";
import { parseDocument } from "../lib/document";

export async function getStaticPaths() {
  const entries = await getCollection("content");

  return entries
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { slug: getStaticSlug(entry.id) },
      props: { entry, allEntries: entries },
    }));
}

const { entry, allEntries } = Astro.props;
const { Content } = await render(entry);

const folderPath = getFolderPath(entry.id);
const children = entry.data.index
  ? getImmediateChildren(allEntries, folderPath, entry.id)
  : [];

const childEntries = children.map((child) => ({
  id: child.id,
  data: child.data,
}));

const breadcrumbs = getBreadcrumbs(entry.id, allEntries);
const sidebarEntries = getSidebarEntries(allEntries, entry.id);
const parentEntry = getParentEntry(entry.id, allEntries);
const { headings } = parseDocument(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  label={entry.data.index ? "Index" : "Document"}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  headings={headings}
>
  {
    entry.data.index ? (
      <IndexList
        title={entry.data.title}
        description={entry.data.description}
        label="Index"
        entries={childEntries}
      />
    ) : (
      <>
        <div class="mb-10 border-b border-[var(--grid-line-strong)] pb-8">
          <span class="tech-label mb-3 block">Document</span>
          <h1 class="glow-text text-4xl font-semibold tracking-tight text-[var(--accent)] md:text-5xl">
            {entry.data.title}
          </h1>
        </div>

        <div class="mb-12 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 border border-[var(--grid-line-strong)] bg-[var(--bg-elevated)] px-4 py-3 font-mono text-xs text-[var(--muted)]">
          <span>ID: {entry.id}</span>
          <span class="hidden text-[var(--grid-line-strong)] sm:inline">|</span>
          <span class="text-sm">DATE: {entry.data.date.toISOString().slice(0, 10)}</span>
          <span class="hidden text-[var(--grid-line-strong)] sm:inline">|</span>
          <span>AUTHOR: {entry.data.author}</span>
        </div>

        <Content />
      </>
    )
  }
</Layout>
