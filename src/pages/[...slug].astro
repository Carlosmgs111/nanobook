---
import Layout from "../layouts/Layout.astro";
import IndexList from "../components/IndexList.astro";
import { AstroCollectionRepository } from "../core/content/repository";
import { AstroMarkdownRenderer } from "../core/rendering/adapters/astro-markdown";
import {
  buildNavigationTree,
  getFolderPath,
  getImmediateChildren,
  getBreadcrumbs,
  getSidebarEntries,
  getParentEntry,
} from "../core/navigation/builder";
import { parseDocument } from "../lib/document";

const repository = new AstroCollectionRepository();
const renderer = new AstroMarkdownRenderer();

export async function getStaticPaths() {
  const repo = new AstroCollectionRepository();
  const documents = await repo.list();

  return documents.map((document) => ({
    params: { slug: document.slug || undefined },
    props: { documentId: document.id },
  }));
}

const { documentId } = Astro.props;
const entry = await repository.get(documentId);

if (!entry) {
  throw new Error(`Document not found: ${documentId}`);
}

const { Content } = await renderer.render(entry);
const allDocuments = await repository.list();
const { nodeMap } = buildNavigationTree(allDocuments);

const folderPath = getFolderPath(entry.id);
const children = entry.metadata.index
  ? getImmediateChildren(nodeMap, folderPath, entry.id)
  : [];

const childEntries = children.map((child) => ({
  id: child.id,
  data: child.metadata,
}));

const breadcrumbs = getBreadcrumbs(nodeMap, entry.id);
const sidebarEntries = getSidebarEntries(nodeMap, entry.id);
const parentNode = getParentEntry(nodeMap, entry.id);
const { headings } = parseDocument({ body: entry.content });
---

<Layout
  title={entry.title}
  description={entry.description}
  label={entry.metadata.index ? "Index" : "Document"}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentNode
    ? { id: parentNode.id, data: { title: parentNode.title } }
    : null}
  headings={headings}
>
  {
    entry.metadata.index ? (
      <IndexList
        title={entry.title}
        description={entry.description}
        label="Index"
        entries={childEntries}
      />
    ) : (
      <>
        <div class="mb-10 border-b border-[var(--grid-line-strong)] pb-8">
          <span class="tech-label mb-3 block">Document</span>
          <h1 class="glow-text text-4xl font-semibold tracking-tight text-[var(--accent)] md:text-5xl">
            {entry.title}
          </h1>
        </div>

        <div class="mb-12 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 border border-[var(--grid-line-strong)] bg-[var(--bg-elevated)] px-4 py-3 font-mono text-xs text-[var(--muted)]">
          <span>ID: {entry.id}</span>
          <span class="hidden text-[var(--grid-line-strong)] sm:inline">|</span>
          <span class="text-sm">
            DATE: {entry.metadata.date.toISOString().slice(0, 10)}
          </span>
          <span class="hidden text-[var(--grid-line-strong)] sm:inline">|</span>
          <span>AUTHOR: {entry.metadata.author}</span>
        </div>

        <Content />
      </>
    )
  }
</Layout>
