---
import Layout from "../../layouts/Layout.astro";
import EditPage from "../../edition/ui/pages/EditPage.astro";
import { getApp } from "../../Application";

const app = await getApp();

export const prerender = false;

const slug = Astro.params.slug || "index";
if (!slug) return Astro.redirect("/404");
const { breadcrumbs, sidebarEntries, parentEntry, rendered } = await app.renderPage(slug);

const { entry } = rendered;
if (!entry) {
  return new Response("Document not found!", { status: 404 });
}
const sourceDocument = entry.ref
  ? await app.documentModule.getDocument.executeRaw(slug)
  : null;
const editableEntry = sourceDocument?.parse() ?? entry;
const viewHref = `/${editableEntry.slug}`;
const previewHref = `/${editableEntry.slug}/preview`;
const newHref = editableEntry.isIndex
  ? `/${editableEntry.slug}/new`
  : "/new";
const parentHref = editableEntry.parentPath ? `/${editableEntry.parentPath}` : "/";
---

<Layout
  title={`Editar: ${editableEntry.title}`}
  description={editableEntry.description}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  hideToc={true}
  viewHref={viewHref}
  newHref={newHref}
>
  <EditPage
    entry={editableEntry}
    previewHref={previewHref}
    viewHref={viewHref}
    parentHref={parentHref}
  />
</Layout>
