---
import Layout from "../../layouts/Layout.astro";
import EditPage from "../../edition/ui/pages/EditPage.astro";
import { getApp } from "../../Application";

const app = await getApp();

export const prerender = false;

const slug = Astro.params.slug || "index";
if (!slug) return Astro.redirect("/404");
const { breadcrumbs, sidebarEntries, parentEntry, rendered } = await app.renderPage(slug);

const { document } = rendered;
if (!document) {
  return new Response("Document not found!", { status: 404 });
}
const viewHref = `/${document.getId().getValue()}`;
const previewHref = `/${document.getId().getValue()}/preview`;
const newHref = document.getMetadata().index
  ? `/${document.getId().getValue()}/new`
  : "/new";
---

<Layout
  title={`Editar: ${document.getTitle()}`}
  description={document.getDescription()}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  hideToc={true}
  viewHref={viewHref}
  newHref={newHref}
>
  <EditPage entry={document} previewHref={previewHref} />
</Layout>
