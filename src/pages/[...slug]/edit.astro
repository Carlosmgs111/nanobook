---
import Layout from "../../layouts/Layout.astro";
import EditPage from "../../edition/ui/pages/EditPage.astro";
import { contentRepository } from "../../document/_index";
import { navigationService } from "../../navigation";

export const prerender = false;

const { slug } = Astro.params;
const documentId = slug || "index";
const entry = await contentRepository.get(documentId);

if (!entry) {
  return new Response("Document not found!", { status: 404 });
}
const breadcrumbs = navigationService.getBreadcrumbs(entry.id);
const sidebarEntries = navigationService.getSidebarEntries(entry.id);
const parentEntry = navigationService.getParentEntry(entry.id);
const viewHref = `/${entry.id}`;
const previewHref = `/${entry.id}/preview`;
const newHref = entry.metadata.index ? `/${entry.id}/new` : "/new";
---

<Layout
  title={`Editar: ${entry.title}`}
  description={entry.description}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  hideToc={true}
  viewHref={viewHref}
  newHref={newHref}
>
  <EditPage entry={entry} previewHref={previewHref} />
</Layout>
