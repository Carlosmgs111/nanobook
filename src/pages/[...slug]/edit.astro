---
import Layout from "../../layouts/Layout.astro";
import EditPage from "../../edition/ui/EditPage.astro";
import { createContentRepository } from "../../document/adapters/repository/factory";
import { createNavigationService } from "../../navigation/service/service";

export const prerender = false;

const { slug } = Astro.params;
const documentId = slug || "index";

const repository = await createContentRepository();
const entry = await repository.get(documentId);

if (!entry || entry.metadata.index) {
  return new Response("Document not found", { status: 404 });
}

const allDocuments = await repository.list();
const navigation = createNavigationService(allDocuments);
const breadcrumbs = navigation.getBreadcrumbs(entry.id);
const sidebarEntries = navigation.getSidebarEntries(entry.id);
const parentEntry = navigation.getParentEntry(entry.id);
const viewHref = `/${entry.id}`;
const previewHref = `/${entry.id}/preview`;
---

<Layout
  title={`Editar: ${entry.title}`}
  description={entry.description}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  hideToc={true}
  viewHref={viewHref}
>
  <EditPage entry={entry} previewHref={previewHref} />
</Layout>
