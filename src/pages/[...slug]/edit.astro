---
import EditPage from "../../documents/browser/ui/pages/EditPage.astro";
import EditorController from "../../documents/browser/ui/EditorController.astro";
import { getApp } from "../../application/server/Application";
import { resolveLegacyRoute } from "../../application/server/resolveLegacyRoute";
import { shouldUseNanobookSqlCutover } from "../../application/server/legacyRouteMode";

const legacyRedirect = await resolveLegacyRoute(
  await getApp(),
  Astro.request,
  Astro.params.slug,
  "write",
);
if (legacyRedirect) return legacyRedirect;
if (shouldUseNanobookSqlCutover()) {
  return new Response("Ruta legacy no migrada", { status: 410 });
}
---

<EditPage />
<EditorController />
