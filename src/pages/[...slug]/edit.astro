---
import Layout from "../../layouts/Layout.astro";
import EditPage from "../../edition/ui/pages/EditPage.astro";
import { getApp } from "../../Application";

const app = await getApp();

export const prerender = false;

const slug = Astro.params.slug || "index";
if (!slug) return Astro.redirect("/404");
const { breadcrumbs, sidebarEntries, parentEntry, rendered } = await app.renderPage(slug);

const { entry } = rendered;
if (!entry) {
  return new Response("Document not found!", { status: 404 });
}
const viewHref = `/${entry.id}`;
const previewHref = `/${entry.id}/preview`;
const newHref = entry.metadata.index
  ? `/${entry.id}/new`
  : "/new";
---

<Layout
  title={`Editar: ${entry.title}`}
  description={entry.description}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  hideToc={true}
  viewHref={viewHref}
  newHref={newHref}
>
  <EditPage entry={entry} previewHref={previewHref} viewHref={viewHref} />
</Layout>
