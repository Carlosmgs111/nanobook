---
import Layout from "../../layouts/Layout.astro";
import NewPage from "../../edition/ui/pages/NewPage.astro";
import { getApp } from "../../Application";

const app = await getApp();

export const prerender = false;

const slug = Astro.params.slug || "index";

if (!slug) {
  return new Response("Document not found", { status: 404 });
}
const {
  breadcrumbs,
  sidebarEntries,
  parentEntry,
  rendered: { document },
} = await app.renderPage(slug);
---

<Layout
  title={`Nuevo documento en ${document.getTitle()}`}
  description="Crear un nuevo documento"
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  hideToc={true}
>
  <div class="mb-10 border-b border-[var(--grid-line-strong)] pb-8">
    <span class="tech-label mb-3 block">Nuevo documento</span>
    <h1
      class="glow-text text-3xl font-semibold tracking-tight text-[var(--accent)] md:text-4xl"
    >
      Crear documento
    </h1>
  </div>

  <NewPage baseId={document.getId().getValue()} />
</Layout>
