---
import Layout from "../../layouts/Layout.astro";
import DocumentPage from "../../document/ui/pages/DocumentPage.astro";
import { getApp } from "../../Application";

const app = await getApp();

export const prerender = false;

const slug = Astro.params.slug || "index";
if (!slug) return new Response("Document not found", { status: 404 });

const {
  rendered,
  headings,
  breadcrumbs,
  sidebarEntries,
  parentEntry,
  childEntries,
} = await app.renderPage(slug);
const { entry, renderedBody } = rendered;

const editHref = slug ? `/${slug}/edit` : `${Astro.request.url}edit`;

const newHref = entry.metadata.index
  ? entry.id === "index"
    ? `${Astro.request.url}new`
    : `/${entry.id}/new`
  : "/new";
const canonicalHref = entry.proxyTargetId
  ? entry.proxyTargetId === "index"
    ? "/"
    : `/${entry.proxyTargetId}/`
  : undefined;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, stale-while-revalidate=600"
);
---

<Layout
  title={entry.title}
  description={entry.description}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  headings={headings}
  editHref={editHref}
  newHref={newHref}
  canonicalHref={canonicalHref}
>
  <DocumentPage
    entry={entry}
    Content={renderedBody}
    childEntries={childEntries.map((child) => child)}
  />
</Layout>

<script>
  import {
    loadStagedDocument,
    getStagedDocumentSavedAt,
    clearStagedDocument,
  } from "../../edition/client/stage-document";
  import {
    getRenderedDocument,
    getRenderedDocumentSource,
  } from "../../edition/client/render-service";
  import { selectConfirmedRenderedDocument } from "../../edition/client/confirmed-render";
  import { isInsideDocumentFlow } from "../../edition/client/document-flow";

  function getDocumentId(): string {
    const body = document.getElementById("document-body");
    return body?.dataset.documentId ?? "index";
  }

  function applyConfirmedStagedContent(): void {
    const documentId = getDocumentId();
    const body = document.getElementById("document-body");
    if (!body) return;

    const savedAt = getStagedDocumentSavedAt();
    if (!savedAt) return;

    const staged = loadStagedDocument();
    if (!staged || staged.id !== documentId) return;

    const rendered = selectConfirmedRenderedDocument({
      savedDocument: staged,
      renderedSource: getRenderedDocumentSource(),
      rendered: getRenderedDocument(),
    });
    if (!rendered) return;

    body.innerHTML = rendered.Content;
    body.classList.add("document-body--from-memory");
  }

  function handleBeforeSwap(event: Event): void {
    const documentId = getDocumentId();
    const destination = (event as unknown as { to?: URL }).to;
    if (destination && !isInsideDocumentFlow(destination, documentId)) {
      clearStagedDocument();
    }
  }

  document.addEventListener("astro:page-load", applyConfirmedStagedContent);
  document.addEventListener("astro:before-swap", handleBeforeSwap);
</script>

<style>
  .document-body--from-memory {
    position: relative;
  }
  .document-body--from-memory::before {
    content: "Versión guardada en memoria";
    position: absolute;
    top: -1.75rem;
    right: 0;
    font-size: 0.75rem;
    color: var(--muted);
    font-family: var(--font-mono);
  }
</style>
