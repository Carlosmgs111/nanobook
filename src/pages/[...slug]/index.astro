---
import Layout from "../../layouts/Layout.astro";
import DocumentPage from "../../document/ui/pages/DocumentPage.astro";
import { getApp } from "../../Application";

const app = await getApp();

export const prerender = false;

const slug = Astro.params.slug || "index";
if (!slug) return new Response("Document not found", { status: 404 });

const {
  rendered,
  headings,
  breadcrumbs,
  sidebarEntries,
  parentEntry,
  childEntries,
} = await app.renderPage(slug);
const { entry, renderedBody } = rendered;

const editHref = slug ? `/${slug}/edit` : `${Astro.request.url}edit`;

const newHref = entry.metadata.index
  ? entry.id === "index"
    ? `${Astro.request.url}new`
    : `/${entry.id}/new`
  : "/new";
const canonicalHref = entry.proxyTargetId
  ? entry.proxyTargetId === "index"
    ? "/"
    : `/${entry.proxyTargetId}/`
  : undefined;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, stale-while-revalidate=600"
);
---

<Layout
  title={entry.title}
  description={entry.description}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  headings={headings}
  editHref={editHref}
  newHref={newHref}
  canonicalHref={canonicalHref}
>
  <DocumentPage
    entry={entry}
    Content={renderedBody}
    childEntries={childEntries.map((child) => child)}
  />
</Layout>

<script>
  import { edition } from "../../edition";

  document.addEventListener("astro:page-load", () => {
    const body = document.querySelector<HTMLElement>("#document-body");
    const documentId = body?.dataset.documentId;
    if (!body || !documentId) return;

    const renderedResult = edition.getRenderedDocument.execute(documentId, true);
    if (!renderedResult.isSuccess) return;

    body.innerHTML = renderedResult.getValue().rendered.Content;
    body.dataset.renderedFromEdition = "true";
  });
</script>
