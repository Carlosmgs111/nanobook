---
import Layout from "../../browser/layouts/Layout.astro";
import DocumentPage from "../../server/documents/ui/pages/DocumentPage.astro";
import { getApp } from "../../server/Application";

const app = await getApp();

export const prerender = false;

const slug = Astro.params.slug || "index";
if (!slug) return new Response("Document not found", { status: 404 });
const {
  rendered,
  headings,
  breadcrumbs,
  sidebarEntries,
  parentEntry,
  childEntries,
} = await app.renderPage(slug);
const { entry, renderedBody } = rendered;

const editHref = slug ? `/${slug}/edit` : `${Astro.request.url}edit`;

const newHref = entry.isIndex
  ? entry.slug === "index"
    ? `${Astro.request.url}new`
    : `/${entry.slug}/new`
  : "/new";
const canonicalHref = entry.ref
  ? entry.ref === "index"
    ? "/"
    : `/${entry.ref}/`
  : undefined;

Astro.response.headers.set("Cache-Control", "no-store");
---

<Layout
  title={entry.title}
  description={entry.description}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  headings={headings}
  editHref={editHref}
  newHref={newHref}
  canonicalHref={canonicalHref}
>
  <DocumentPage
    entry={entry}
    Content={renderedBody}
    childEntries={childEntries.map((child) => child)}
  />
</Layout>

<script>
  import { edition } from "../../browser/edition";

  document.addEventListener("astro:page-load", () => {
    const body = document.querySelector<HTMLElement>("#document-body");
    const documentId = body?.dataset.documentId;
    if (!body || !documentId) return;

    // Los proxies ya llegan resueltos desde el servidor. Una preview de
    // sessionStorage puede pertenecer a una versión anterior del documento
    // referenciado y ocultar temporalmente el contenido SSR correcto.
    if (body.dataset.documentRef) return;

    const renderedResult = edition.getRenderedDocument.execute(
      documentId,
      true
    );
    if (!renderedResult.isSuccess) return;

    const currentRef = body.dataset.documentRef ?? "";
    const cachedRef = renderedResult.getValue().source.metadata.ref;
    const normalizedCachedRef =
      typeof cachedRef === "string"
        ? cachedRef
        : JSON.stringify(cachedRef ?? "");
    if (normalizedCachedRef !== currentRef) return;

    body.innerHTML = renderedResult.getValue().rendered.Content;
    body.dataset.renderedFromEdition = "true";
  });
</script>
