---
import Layout from "../../layouts/Layout.astro";
import DocumentPage from "../../document/DocumentPage.astro";
import { renderDocumentPage } from "../../rendering/page/render-document-page";

export const prerender = false;

const { slug } = Astro.params;
const result = await renderDocumentPage(slug ?? "");

if (!result) {
  return new Response("Document not found", { status: 404 });
}

const { rendered } = result;
const { document, renderedBody, headings, breadcrumbs, sidebarEntries, parentEntry, childEntries } = rendered;

const editHref = document.metadata.index ? undefined : `/${document.slug}/edit`;
const canonicalHref = document.proxyTargetId
  ? document.proxyTargetId === "index"
    ? "/"
    : `/${document.proxyTargetId}/`
  : undefined;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, stale-while-revalidate=600",
);
---

<Layout
  title={document.title}
  description={document.description}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  headings={headings}
  editHref={editHref}
  canonicalHref={canonicalHref}
>
  <DocumentPage
    entry={document}
    Content={renderedBody}
    childEntries={childEntries.map((child) => ({ id: child.id, data: child.metadata }))}
  />
</Layout>
