---
import Layout from "../../layouts/Layout.astro";
export const prerender = true;
import DocumentPage from "../../document/DocumentPage.astro";
import { AstroCollectionRepository } from "../../document/adapters/repository/astro-collection-repository";
import { UnifiedMarkdownRenderer } from "../../rendering/adapters/markdown/unified-markdown";
import { createNavigationService } from "../../navigation/service/service";
import type { ParentEntry } from "../../navigation/model/types";
import { parseDocument } from "../../document/parse/document";
import type { Document } from "../../document/model/types";

export interface DocumentPageProps {
  entry: Document;
  Content: string;
  headings: ReturnType<typeof parseDocument>["headings"];
  childEntries: { id: string; data: Document["metadata"] }[];
  breadcrumbs: ReturnType<typeof createNavigationService>["getBreadcrumbs"];
  sidebarEntries: ReturnType<typeof createNavigationService>["getSidebarEntries"];
  parentEntry: ParentEntry | null;
  editHref?: string;
}

export async function getStaticPaths() {
  const repository = new AstroCollectionRepository();
  const documents = await repository.list();

  return documents.map((document) => ({
    params: { slug: document.slug || undefined },
    props: { documentId: document.id },
  }));
}
const { documentId } = Astro.props;

const repository = new AstroCollectionRepository();
const entry = await repository.get(documentId);

if (!entry) {
  throw new Error(`Document not found: ${documentId}`);
}

const allDocuments = await repository.list();
const navigation = createNavigationService(allDocuments);
const breadcrumbs = navigation.getBreadcrumbs(entry.id);
const sidebarEntries = navigation.getSidebarEntries(entry.id);
const parentEntry = navigation.getParentEntry(entry.id);

const headings = parseDocument({ body: entry.content }).headings;
const childEntries = entry.metadata.index
  ? navigation.getImmediateChildren(entry.id, entry.id).map(
      (child) => ({ id: child.id, data: child.metadata })
    )
  : [];
const editHref = entry.metadata.index ? undefined : `/${entry.slug}/edit`;
const canonicalHref = entry.proxyTargetId
  ? entry.proxyTargetId === "index"
    ? "/"
    : `/${entry.proxyTargetId}/`
  : undefined;
const { Content } = await new UnifiedMarkdownRenderer().render(entry);
---

<Layout
  title={entry.title}
  description={entry.description}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  headings={headings}
  editHref={editHref}
  canonicalHref={canonicalHref}
>
  <DocumentPage entry={entry} Content={Content} childEntries={childEntries} />
</Layout>
