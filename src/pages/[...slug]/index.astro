---
import Layout from "../../layouts/Layout.astro";
import DocumentPage from "../../document/DocumentPage.astro";
// import { renderDocumentPage } from "../../publishing/page/render-document-page";
import { pagePublisher } from "../../publishing";

export const prerender = false;

const { slug } = Astro.params;
const result = await pagePublisher.publish(slug ?? "");

if (!result) {
  return new Response("Document not found", { status: 404 });
}

const { rendered, headings } = result;
const {
  document,
  renderedBody,
  breadcrumbs,
  sidebarEntries,
  parentEntry,
  childEntries,
} = rendered;

const editHref = document.slug
  ? `/${document.slug}/edit`
  : `${Astro.request.url}edit`;

const newHref = document.metadata.index
  ? document.id === "index"
    ? `${Astro.request.url}new`
    : `/${document.id}/new`
  : "/new";
const canonicalHref = document.proxyTargetId
  ? document.proxyTargetId === "index"
    ? "/"
    : `/${document.proxyTargetId}/`
  : undefined;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, stale-while-revalidate=600"
);
---

<Layout
  title={document.title}
  description={document.description}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  headings={headings}
  editHref={editHref}
  newHref={newHref}
  canonicalHref={canonicalHref}
>
  <DocumentPage
    entry={document}
    Content={renderedBody}
    childEntries={childEntries.map((child) => ({
      id: child.id,
      data: child.metadata,
    }))}
  />
</Layout>
