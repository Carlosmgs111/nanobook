---
import DocumentPage from "../../documents/browser/ui/pages/DocumentPage.astro";
import DocumentPageController from "../../documents/browser/ui/DocumentPageController.astro";
import { getApp } from "../../application/server/Application";
import { resolveLegacyRoute } from "../../application/server/resolveLegacyRoute";

const legacyRedirect = await resolveLegacyRoute(
  await getApp(),
  Astro.request,
  Astro.params.slug,
  "read",
);
if (legacyRedirect) return legacyRedirect;
return new Response("Ruta legacy no disponible: el contenido usa SQL", { status: 410 });
---

<DocumentPage />
<DocumentPageController />
