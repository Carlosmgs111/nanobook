---
import Layout from "../../layouts/Layout.astro";
import DocumentPage from "../../document/DocumentPage.astro";
import { getApp } from "../../Application";

const app = await getApp();

export const prerender = false;

const slug = Astro.params.slug || "index";
if (!slug) return new Response("Document not found", { status: 404 });

const {
  rendered,
  headings,
  breadcrumbs,
  sidebarEntries,
  parentEntry,
  childEntries,
} = await app.renderPage(slug);
const { document, renderedBody } = rendered;

const editHref = slug ? `/${slug}/edit` : `${Astro.request.url}edit`;

const newHref = document.getMetadata().index
  ? document.getId().getValue() === "index"
    ? `${Astro.request.url}new`
    : `/${document.getId().getValue()}/new`
  : "/new";
const proxyTargetId = document.getProxyTargetId();
const canonicalHref = proxyTargetId
  ? proxyTargetId.getValue() === "index"
    ? "/"
    : `/${proxyTargetId.getValue()}/`
  : undefined;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, stale-while-revalidate=600"
);
---

<Layout
  title={document.getTitle()}
  description={document.getDescription()}
  breadcrumbs={breadcrumbs}
  sidebarEntries={sidebarEntries}
  parentEntry={parentEntry}
  headings={headings}
  editHref={editHref}
  newHref={newHref}
  canonicalHref={canonicalHref}
>
  <DocumentPage
    entry={document.parse()}
    Content={renderedBody}
    childEntries={childEntries.map((child) => child)}
  />
</Layout>
