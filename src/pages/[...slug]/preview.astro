---
import Layout from "../../layouts/Layout.astro";
import PreviewPage from "../../edition/ui/pages/PreviewPage.astro";

export const prerender = false;

const { slug } = Astro.params;
const editHref = slug ? `/${slug}/edit` : "/edit";
---

<Layout editHref={editHref}>
  <PreviewPage slug={slug}/>
</Layout>
