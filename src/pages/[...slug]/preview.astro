---
import Layout from "../../layouts/Layout.astro";
export const prerender = false;
const editHref = `/${Astro.params.slug}/edit`;
---

<Layout editHref={editHref}>
  <h1><mark>Preview de {Astro.params.slug}</mark></h1>
  <div id="preview-container"></div>
</Layout>

<script>
  const channel = new BroadcastChannel("rendered-document");
  const container = document.getElementById("preview-container");

  function renderPreview() {
    if (!container) return;

    const raw = sessionStorage.getItem("renderedStagedDocument");
    if (!raw) {
      container.innerHTML = "<p>No hay contenido para previsualizar.</p>";
      return;
    }

    const renderedStagedDocument = JSON.parse(raw);
    container.innerHTML = renderedStagedDocument.Content;
  }

  document.addEventListener("astro:page-load", renderPreview);

  channel.addEventListener("message", (event) => {
    console.log(event);
    renderPreview();
  });
</script>
