---
import DocumentPage from "../../../../documents/browser/ui/pages/DocumentPage.astro";
import { getApp } from "../../../../application/server/Application";
import { resolveNanobookRoute } from "../../../../application/server/resolveNanobookRoute";
import { AuthorizeNanobook } from "../../../../nanobooks/server";
import { formatServerTiming } from "../../../../shared/server/http/ServerTiming";

export const prerender = false;

const timings: Record<string, number> = {};

async function measure<T>(name: string, operation: () => Promise<T>): Promise<T> {
  const startedAt = performance.now();
  try {
    return await operation();
  } finally {
    timings[name] = performance.now() - startedAt;
  }
}

const app = await measure("route-app", getApp);
const access = await measure("route-access", () =>
  resolveNanobookRoute(
    app,
    Astro.request,
    Astro.params.nanobookSlug,
    "read",
    (name, duration) => {
      timings[name] = duration;
    },
    Astro.response.headers,
  )
);
if (access instanceof Response) return access;

const { nanobook, user } = access;
const nanobookId = nanobook.getId();
const slug = Astro.params.slug || "index";
const documentModule = app.nanobookModule.documentModule;

const document = await measure("document", () =>
  documentModule.getDocument.execute(nanobookId, slug, (name, duration) => {
    timings[name] = duration;
  })
);
if (!document) return new Response("Document not found", { status: 404 });

// A proxy takes its target's identity, so protection is checked on the whole
// chain: the stored document and the resolved one.
const rawDocument = await measure("document-raw", () =>
  documentModule.getDocument.executeRaw(nanobookId, slug)
);
const hasSecuredLink = [rawDocument, document].some((item) => item?.getMetadata().secured === true);
// Public nanobooks skip the session read; resolve it only when a link is protected.
const accessViewer =
  hasSecuredLink && !user
    ? await measure("access-session", () =>
        app.authServerModule.getSession(Astro.request, Astro.response.headers)
      )
    : user;
const accessDecision = await measure("access", () =>
  documentModule.authorizeDocumentAccess.execute({
    documents: [rawDocument, document],
    canWrite: new AuthorizeNanobook().canWrite(nanobook, accessViewer?.id),
    cookieHeader: Astro.request.headers.get("cookie"),
  })
);
const challenged = accessDecision.kind === "challenge";

if (challenged) {
  Astro.response.status = 401;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
}
Astro.response.headers.set("Server-Timing", formatServerTiming(timings));
---

<DocumentPage nanobook={nanobook} user={user} document={document} challenged={challenged} />
