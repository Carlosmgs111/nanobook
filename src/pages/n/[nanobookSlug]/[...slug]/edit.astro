---
import EditPage from "../../../../documents/browser/ui/pages/EditPage.astro";
import { getApp } from "../../../../application/server/Application";
import { resolveNanobookRoute } from "../../../../application/server/resolveNanobookRoute";

export const prerender = false;

const app = await getApp();
const access = await resolveNanobookRoute(app, Astro.request, Astro.params.nanobookSlug, "write");
if (access instanceof Response) return access;
---

<EditPage nanobook={access.nanobook} user={access.user} />
