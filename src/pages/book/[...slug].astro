---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("book");
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description} label="Document">
  <div class="mb-10 border-b border-[var(--grid-line-strong)] pb-8">
    <span class="tech-label mb-3 block">Document</span>
    <h1 class="glow-text text-4xl font-semibold tracking-tight text-[var(--accent)] md:text-5xl">
      {post.data.title}
    </h1>
  </div>

  <div class="mb-12 flex flex-wrap items-center gap-x-4 gap-y-2 border border-[var(--grid-line-strong)] bg-[var(--bg-elevated)] px-4 py-3 font-mono text-xs text-[var(--muted)]">
    <span>ID: {post.id}</span>
    <span class="hidden sm:inline text-[var(--grid-line-strong)]">|</span>
    <span>DATE: {post.data.date.toISOString().slice(0, 10)}</span>
    <span class="hidden sm:inline text-[var(--grid-line-strong)]">|</span>
    <span>AUTHOR: {post.data.author}</span>
  </div>

  <Content />
</Layout>
