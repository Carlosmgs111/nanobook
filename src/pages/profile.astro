---
import Layout from "../browser/layouts/Layout.astro";
---

<Layout
  title="Perfil | Nanobook"
  description="Administra tu sesión de Nanobook."
  hideToc={true}
>
  <section class="mx-auto max-w-xl px-6 py-16">
    <a
      href="/"
      class="mb-6 inline-flex items-center justify-center bg-black px-4 py-2 text-sm font-medium !text-white transition-colors hover:bg-black/80 focus:outline-none focus:ring-2 focus:ring-[var(--accent)]/50 !no-underline"
    >
      ← Volver al inicio
    </a>
    <h1>Perfil</h1>
    <p>Gestiona la sesión de tu cuenta.</p>
    <button
      type="button"
      data-sign-out
      class="inline-flex items-center justify-center bg-black px-4 py-2 text-sm font-medium !text-white transition-colors hover:bg-black/80 focus:outline-none focus:ring-2 focus:ring-[var(--accent)]/50"
    >
      Cerrar sesión
    </button>
  </section>
</Layout>

<script>
  import { getApp } from "../browser/Application";

  const app = getApp();

  function mountSignOut(): void {
    const button = document.querySelector<HTMLButtonElement>("[data-sign-out]");
    if (!button || button.dataset.signOutReady === "true") return;

    button.dataset.signOutReady = "true";
    button.addEventListener("click", () => {
      void app.authModule.signOutController.execute();
    });
  }

  document.addEventListener("astro:page-load", mountSignOut);
  mountSignOut();
</script>
