---
import Layout from "../layouts/Layout.astro";
import { getApp } from "../application/server/Application";

export const prerender = false;

const app = await getApp();
const session = await app.authServerModule.getSession(Astro.request);
if (!session) return Astro.redirect(`/login?callbackURL=${encodeURIComponent("/nanobooks")}`);

const result = await app.nanobookModule.listNanobooks.execute(session.id);
if (!result.isSuccess) {
  return new Response("No fue posible cargar los nanobooks", { status: 500 });
}
const nanobooks = result.getValue();
---

<Layout title="Nanobooks" description="Gestiona tus nanobooks">
  <div class="mx-auto max-w-4xl space-y-8">
    <div class="border-b border-[var(--grid-line-strong)] pb-6">
      <span class="tech-label mb-2 block">Workspace</span>
      <h1 class="glow-text text-4xl font-semibold text-[var(--accent)]">Nanobooks</h1>
      <p class="mt-2 text-sm text-[var(--muted)]">Cada nanobook contiene su propio árbol, configuración y permisos.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {nanobooks.map((nanobook) => (
        <a
          href={`/n/${nanobook.getSlug()}`}
          class="block border border-[var(--grid-line-strong)] bg-[var(--bg-elevated)] p-5 transition-colors hover:border-[var(--accent)]"
        >
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-xl font-semibold text-[var(--accent)]">{nanobook.getName()}</h2>
            <span class="text-xs uppercase text-[var(--muted)]">{nanobook.getVisibility()}</span>
          </div>
          <p class="mt-2 font-mono text-xs text-[var(--muted)]">/n/{nanobook.getSlug()}</p>
        </a>
      ))}
    </div>

    <form id="create-nanobook" class="space-y-4 border border-[var(--grid-line-strong)] p-5">
      <h2 class="text-lg font-semibold">Crear nanobook</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <label class="space-y-1 text-sm">
          <span class="block">Nombre</span>
          <input name="name" required class="w-full border border-[var(--grid-line-strong)] bg-[var(--bg)] px-3 py-2" />
        </label>
        <label class="space-y-1 text-sm">
          <span class="block">Slug</span>
          <input name="slug" required pattern="[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?" class="w-full border border-[var(--grid-line-strong)] bg-[var(--bg)] px-3 py-2" />
        </label>
      </div>
      <label class="flex items-center gap-2 text-sm">
        <input name="visibility" type="checkbox" /> Público
      </label>
      <div data-create-error class="text-sm text-red-500" role="alert"></div>
      <button type="submit" class="border border-[var(--grid-line-strong)] bg-[var(--text)] px-4 py-2 text-sm font-medium text-[var(--bg)]">Crear</button>
    </form>
  </div>
</Layout>

<script data-astro-rerun>
  const initCreateNanobookForm = () => {
    const form = document.querySelector("#create-nanobook");
    const error = document.querySelector("[data-create-error]");
    if (!form || form.dataset.bound === "true") return;

    form.dataset.bound = "true";
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (error) error.textContent = "";

      try {
        const response = await fetch("/api/nanobooks", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: data.get("name"),
            slug: data.get("slug"),
            visibility: data.get("visibility") === "on" ? "public" : "private",
          }),
        });
        if (!response.ok) {
          const payload = await response.json().catch(() => ({}));
          if (error) {
            error.textContent = payload.error || "No fue posible crear el nanobook";
          }
          return;
        }
        const payload = await response.json();
        window.location.href = `/n/${payload.slug}`;
      } catch (requestError) {
        if (error) {
          error.textContent = requestError instanceof Error
            ? requestError.message
            : "No fue posible crear el nanobook";
        }
      }
    });
  };

  document.addEventListener("astro:page-load", initCreateNanobookForm);
  initCreateNanobookForm();
</script>
