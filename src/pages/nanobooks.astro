---
import NanobooksPage from "../nanobooks/browser/ui/NanobooksPage.astro";
import { getApp } from "../application/server/Application";
export const prerender = false;
const app = await getApp();
const session = await app.authServerModule.getSession(Astro.request);
if (!session) return Astro.redirect(`/login?callbackURL=${encodeURIComponent("/nanobooks")}`);
const result = await app.nanobookModule.listNanobooks.execute(session.id);
if (!result.isSuccess) return new Response("No fue posible cargar los nanobooks", { status: 500 });
---
<NanobooksPage nanobooks={result.getValue()} />
