---
import { getApp } from "../../../application/server/Application";
import BlockHost from "./BlockHost.astro";

const app = await getApp();

interface Props {
  /** HTML renderizado del documento (con los marcadores de bloque). */
  html: string;
  /** El resto de atributos (id, data-*) va al contenedor. */
  [attribute: string]: unknown;
}

const { html, resolver, ...attributes } = Astro.props;

// Los segmentos de HTML se inyectan tal cual y los bloques se pintan con Astro
// (solo servidor o isla), en el orden del documento.
const pieces = app.renderingModule.pieceResolver.resolve(html, (name) =>
  console.warn(
    `Bloque "${name}": las props ya no validan al servir; se muestra el contenido alternativo.`
  )
);
const hasBlocks = pieces.some((piece) => piece.kind === "island");
---

<div {...attributes} data-has-blocks={hasBlocks ? "true" : undefined}>
  {
    pieces.map((piece) =>
      piece.kind === "island" ? (
        <BlockHost component={piece.component} props={piece.props} />
      ) : (
        <Fragment set:html={piece.html} />
      )
    )
  }
</div>
