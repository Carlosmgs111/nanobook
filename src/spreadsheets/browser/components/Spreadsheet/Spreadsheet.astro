---
import { sheetWidth } from "../../../shared/sheet";
import SpreadsheetIsland from "./SpreadsheetIsland.tsx";
import type { SpreadsheetProps } from "./Spreadsheet.schema";

const props = Astro.props as SpreadsheetProps;
const indexes = Array.from({ length: sheetWidth(props.rows, props.columns) }, (_, index) => index);
---
{/*
  react-spreadsheet publica CommonJS y no se puede renderizar en el servidor de Astro, así que la isla
  es client:only. Mientras carga (y para quien no ejecuta JavaScript) se muestra una tabla HTML con los datos.
*/}
<SpreadsheetIsland {...props} client:only="react">
  <figure slot="fallback" class="sheet">
    {props.title && <figcaption>{props.title}</figcaption>}
    <div class="sheet-scroll">
      <table class="sheet-fallback">
        {props.columns && (
          <thead>
            <tr>{indexes.map((index) => <th scope="col">{props.columns?.[index] ?? ""}</th>)}</tr>
          </thead>
        )}
        <tbody>
          {props.rows.map((row) => <tr>{indexes.map((index) => <td>{row[index] ?? ""}</td>)}</tr>)}
        </tbody>
      </table>
    </div>
  </figure>
</SpreadsheetIsland>
