---
import { columnTotal, sheetWidth, type TotalFunction } from "../../../shared/sheet";
import type { SpreadsheetTotalsProps } from "./SpreadsheetTotals.schema";

const { title, columns, rows, functions } = Astro.props as SpreadsheetTotalsProps;

const labels: Record<TotalFunction, string> = {
  sum: "Suma",
  average: "Promedio",
  min: "Mínimo",
  max: "Máximo",
  count: "Cuenta",
};
const format = new Intl.NumberFormat("es-CO", { maximumFractionDigits: 2 });
const indexes = Array.from({ length: sheetWidth(rows, columns) }, (_, index) => index);
---

<figure class="sheet-totals">
  {title && <figcaption>{title}</figcaption>}
  <div class="sheet-scroll">
    <table>
      <thead>
        <tr>
          <th scope="col"></th>
          {indexes.map((index) => <th scope="col">{columns[index] ?? ""}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          functions.map((fn) => (
            <tr>
              <th scope="row">{labels[fn]}</th>
              {indexes.map((index) => {
                const value = columnTotal(rows, index, fn);
                return <td>{value === undefined ? "—" : format.format(value)}</td>;
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</figure>
