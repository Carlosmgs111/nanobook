<script>
  import { CachedAuthSessionReader } from "./CachedAuthSessionReader";
  import { HttpAuthApi } from "./HttpAuthApi";
  import { HttpAuthSessionReader } from "./HttpAuthSessionReader";
  import { SessionCachingAuthApi } from "./SessionCachingAuthApi";
  import { AuthFormController } from "./AuthFormController";
  import { BrowserToastNotifier } from "../../toast/browser/BrowserToastNotifier";
  import { navigate } from "astro:transitions/client";

  const sessionReader = new CachedAuthSessionReader(new HttpAuthSessionReader());
  const authApi = new SessionCachingAuthApi(new HttpAuthApi(), sessionReader);
  const controller = new AuthFormController({
    authApi,
    notifier: new BrowserToastNotifier("auth-flow"),
    navigate,
  });

  document.addEventListener("astro:page-load", () => controller.mount());
  controller.mount();
</script>
