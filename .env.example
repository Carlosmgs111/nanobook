# Copia este archivo a `.env` para desarrollo local. Ninguna variable es obligatoria en local.
# No definas VERCEL ni VERCEL_DEPLOY en local: activan el modo y el adaptador de Vercel.

# --- Autenticación ---------------------------------------------------------
# Origen exacto con el que abres la app en el navegador (esquema, host y puerto).
# Si no coincide, /api/auth/* responde 403 INVALID_ORIGIN. En Vercel: origen HTTPS canónico.
BETTER_AUTH_URL=http://localhost:4322
# 32+ caracteres aleatorios (obligatoria en Vercel). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# --- Base de datos ---------------------------------------------------------
# Por defecto: file:./data/nanobook.db (se crea la carpeta data/ sola).
# En Vercel es obligatoria y remota (libsql:// o libsqls://).
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# --- Correo de verificación (Resend) ----------------------------------------
# Sin RESEND_API_KEY, en `pnpm dev` el enlace de verificación se imprime en la consola del servidor.
# En producción/Vercel son obligatorias, con un dominio verificado en EMAIL_FROM.
# RESEND_API_KEY=
# EMAIL_FROM=Nanobook <no-reply@tu-dominio-verificado.example>

# --- GitHub (opcional) ------------------------------------------------------
# Inicio de sesión con GitHub: define ambas o ninguna. Callback local:
#   http://localhost:4322/api/auth/callback/github   (scope: user:email)
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# Documentos con `ref` a archivos de GitHub (PAT de solo lectura).
# GITHUB_TOKEN=

# --- Redis (opcional) -------------------------------------------------------
# REDIS_URL=
