{
  "name": "nanobook",
  "type": "module",
  "version": "0.5.1",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:staging": "node --env-file-if-exists=.env --env-file=.env.staging ./node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "preview": "astro preview",
    "dev:preview": "npm run build && astro preview",
    "start": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "test": "vitest run && vitest run --config vitest.astro.config.ts",
    "test:watch": "vitest",
    "database:migrate": "tsx --env-file-if-exists=.env scripts/database-migrate.ts",
    "database:migrate:staging": "tsx --env-file=.env.staging scripts/database-migrate.ts",
    "profile:change-username": "tsx --env-file-if-exists=.env scripts/change-profile-username.ts",
    "profile:change-username:staging": "tsx --env-file=.env.staging scripts/change-profile-username.ts",
    "test:astro": "vitest run --config vitest.astro.config.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/react": "^7.1.4",
    "@astrojs/vercel": "^11.0.7",
    "@better-auth/cimd": "^1.7.12",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@better-auth/mcp": "^1.7.12",
    "@better-auth/oauth-provider": "^1.7.12",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@shikijs/rehype": "^4.4.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "@vercel/functions": "3.9.5",
    "astro": "^7.1.6",
    "better-auth": "^1.7.12",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.3",
    "github-slugger": "^2.0.0",
    "lightweight-charts": "^5.2.1",
    "mdast-util-to-string": "^4.0.0",
    "nanostores": "^1.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "drizzle-kit": "^0.31.11",
    "hast-util-to-string": "^3.0.1",
    "tsx": "^4.23.12",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
